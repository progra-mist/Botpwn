stock GetSkillBar(amount)
{
	new tmp_bar[101];
	if(!amount) return tmp_bar;
 	for(new i = 0; i < amount; i++)
		strcat(tmp_bar, "|");

 	return tmp_bar;
}

stock ShowPlayerSkills(playerid, to_player = -1)
{
	if(to_player < 0)
		to_player = playerid;

	new tmp_skills[1560];
	format
	(
	    tmp_skills,
	    sizeof(tmp_skills),
	    "Сила\t\t%d%s\t%s\n\
	    {99ff66}\
		Colt 45\t\t%d%s\t%s\n\
		SD Pistol\t%d%s\t%s\n\
	    Desert Eagle\t%d%s\t%s\n\
	    Shotgun\t%d%s\t%s\n\
	    MP5\t\t%d%s\t%s\n\
	    AK47\t\t%d%s\t%s\n\
	    M4\t\t%d%s\t%s\n\
	    Sniper Rifle\t%d%s\t%s\n\
		Sawnoff\t%d%s\t%s\n\
		Combat SG\t%d%s\t%s\n\
		Micro Uzi\t%d%s\t%s\
	    ",
	    GetPlayerData(playerid, P_POWER), "%",
	    GetSkillBar(GetPlayerData(playerid, P_POWER)),
	    GetPlayerData(playerid, P_SKILL_COLT), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_COLT)),
		GetPlayerData(playerid, P_SKILL_SDPISTOL), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_SDPISTOL)),
		GetPlayerData(playerid, P_SKILL_DEAGLE), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_DEAGLE)),
		GetPlayerData(playerid, P_SKILL_SHOTGUN), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_SHOTGUN)),
		GetPlayerData(playerid, P_SKILL_MP5), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_MP5)),
		GetPlayerData(playerid, P_SKILL_AK47), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_AK47)),
		GetPlayerData(playerid, P_SKILL_M4), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_M4)),
		GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE)),
		GetPlayerData(playerid, P_SKILL_SAWNOFF), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_SAWNOFF)),
		GetPlayerData(playerid, P_SKILL_COMBAT_SG), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_COMBAT_SG)),
		GetPlayerData(playerid, P_SKILL_MICRO_UZI), "%",
		GetSkillBar(GetPlayerData(playerid, P_SKILL_MICRO_UZI))
	);
	Dialog(to_player, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCC00}Навыки владения оружием", tmp_skills, "Закрыть", "");

	return 1;
}

stock GetPlayerSkillAmount(playerid, skill_index)
{
	new amount;

	switch(skill_index)
	{
		case 0: amount = GetPlayerData(playerid, P_POWER);
		case 1: amount = GetPlayerData(playerid, P_SKILL_COLT);
		case 2: amount = GetPlayerData(playerid, P_SKILL_SDPISTOL);
		case 3: amount = GetPlayerData(playerid, P_SKILL_DEAGLE);
		case 4: amount = GetPlayerData(playerid, P_SKILL_SHOTGUN);
		case 5: amount = GetPlayerData(playerid, P_SKILL_MP5);
		case 6: amount = GetPlayerData(playerid, P_SKILL_AK47);
		case 7: amount = GetPlayerData(playerid, P_SKILL_M4);
		case 8: amount = GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE);
		case 9: amount = GetPlayerData(playerid, P_SKILL_SAWNOFF);
		case 10: amount = GetPlayerData(playerid, P_SKILL_COMBAT_SG);
		case 11: amount = GetPlayerData(playerid, P_SKILL_MICRO_UZI);
	}

	return amount;
}

stock SetPlayerSkillAmount(playerid, skill_index, amount)
{
	switch(skill_index)
	{
		case 0: SetPlayerData(playerid, P_POWER, amount);
		case 1: SetPlayerData(playerid, P_SKILL_COLT, amount);
		case 2: SetPlayerData(playerid, P_SKILL_SDPISTOL, amount);
		case 3: SetPlayerData(playerid, P_SKILL_DEAGLE, amount);
		case 4: SetPlayerData(playerid, P_SKILL_SHOTGUN, amount);
		case 5: SetPlayerData(playerid, P_SKILL_MP5, amount);
		case 6: SetPlayerData(playerid, P_SKILL_AK47, amount);
		case 7: SetPlayerData(playerid, P_SKILL_M4, amount);
		case 8: SetPlayerData(playerid, P_SKILL_SNIPER_RIFLE, amount);
		case 9: SetPlayerData(playerid, P_SKILL_SAWNOFF, amount);
		case 10: SetPlayerData(playerid, P_SKILL_COMBAT_SG, amount);
		case 11: SetPlayerData(playerid, P_SKILL_MICRO_UZI, amount);
	}

	return 1;
}

stock ShowTeleportList(playerid)
{
	new list_text[34 * (sizeof g_teleport_list)];
	new dest[36];

	for(new i; i < sizeof g_teleport_list; i ++)
	{
		format(dest, sizeof dest, "%d. %s\n", i + 1, GetTeleportListData(i, TL_NAME));
		strcat(list_text, dest);
	}

	Dialog(playerid, DIALOG_TELEPORT_LIST, DIALOG_STYLE_LIST, "{FFFF00}"SERVER_NAME"{ffffff} | Важные места", list_text, "Выбрать", "Назад");
	return 1;
}

stock CreateTicket(playerid, amount, issuer[], description[])
{
	new query[190];

	mysql_format(mysql, query, sizeof query, "INSERT INTO tickets (uid, amount, issuer, description) VALUES (%d, %d, '%s', '%s')",
	GetPlayerAccountID(playerid), amount, issuer, description);
	mysql_query(mysql, query, false);

	return 1;
}

stock PayTicket(playerid, ticketid)
{
	new query[90],
		Cache: result,
		rows;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM tickets WHERE id=%d LIMIT 1", ticketid);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	new uid = cache_get_field_content_int(0, "uid"),
		amount = cache_get_field_content_int(0, "amount"),
		status = cache_get_field_content_int(0, "status"),
		desc[64];

	cache_get_field_content(0, "description", desc);

	cache_delete(result);

	if(!rows)
		return SendClientMessage(playerid, 0xCECECEFF, "Данный штраф не найден");

	if(uid != GetPlayerAccountID(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "Данный штраф выписан не Вам");

	if(status)
		return SendClientMessage(playerid, 0xCECECEFF, "Данный штраф уже оплачен");

	if(GetPlayerBankMoney(playerid) < amount)
		return SendClientMessage(playerid, 0x999999FF, "Недостаточно средств на основном банковском счету для оплаты штрафа");

	GivePlayerMoneyEx(playerid, -amount, "Оплата штрафа", true, true);

	mysql_format(mysql, query, sizeof query, "UPDATE tickets SET status=1 WHERE id=%d", ticketid);
	mysql_query(mysql, query, false);

	format(query, sizeof query, "Вы оплатили штраф №%d (%s)", ticketid, desc);
	SendClientMessage(playerid, 0x66CC33FF, query);

	return 1;
}

stock DPSRadar_FindFreeSlot()
{
    for(new radarid = 0; radarid < MAX_DPS_PORTABLE_RADARS; radarid++)
    {
        if(!g_dps_portable_radar[radarid][DPR_ACTIVE])
            return radarid;
    }
    return -1;
}

stock DPSRadar_FindOwnerOnline(account_id)
{
    foreach(new playerid : Player)
    {
        if(IsPlayerLogged(playerid) && GetPlayerAccountID(playerid) == account_id)
            return playerid;
    }
    return INVALID_PLAYER_ID;
}

stock DPSRadar_UpdateLabel(radarid)
{
    if(radarid < 0 || radarid >= MAX_DPS_PORTABLE_RADARS || !g_dps_portable_radar[radarid][DPR_ACTIVE])
        return 0;

    new remaining = g_dps_portable_radar[radarid][DPR_EXPIRE_AT] - gettime();
    if(remaining < 0) remaining = 0;

    new minutes = (remaining + 59) / 60;
    new label_text[192];
    format(
        label_text,
        sizeof(label_text),
        "{33CCFF}Стационарный радар\n{FFFFFF}Установил: {FFFF00}%s\n{FFFFFF}Осталось: {33CC33}%d мин.\n{FFFFFF}Ограничение: {FFFF00}%d км/ч",
        g_dps_portable_radar[radarid][DPR_OWNER_NAME],
        minutes,
        DPS_RADAR_SPEED_LIMIT
    );
    UpdateDynamic3DTextLabelText(g_dps_portable_radar[radarid][DPR_LABEL], 0xFFFFFFFF, label_text);
    return 1;
}

stock DPSRadar_Remove(radarid, bool:payout = true)
{
    if(radarid < 0 || radarid >= MAX_DPS_PORTABLE_RADARS || !g_dps_portable_radar[radarid][DPR_ACTIVE])
        return 0;

    new owner_account = g_dps_portable_radar[radarid][DPR_OWNER_ACCOUNT_ID];
    new earnings = g_dps_portable_radar[radarid][DPR_EARNINGS];

    if(g_dps_portable_radar[radarid][DPR_OBJECT] > 0)
        DestroyDynamicObject(g_dps_portable_radar[radarid][DPR_OBJECT]);

    DestroyDynamic3DTextLabel(g_dps_portable_radar[radarid][DPR_LABEL]);

    if(payout && earnings > 0 && owner_account > 0)
    {
        new owner_player = DPSRadar_FindOwnerOnline(owner_account);
        if(owner_player != INVALID_PLAYER_ID)
        {
            GivePlayerMoneyEx(owner_player, earnings, "Доход со стационарного радара", true, true);

            new msg[144];
            format(msg, sizeof(msg), "{33CC33}Ваш радар завершил работу. Доход со штрафов: %d руб.", earnings);
            SendClientMessage(owner_player, 0xFFFFFFFF, msg);
        }
        else
        {
            new query[160];
            mysql_format(mysql, query, sizeof(query), "UPDATE accounts SET money=money+%d WHERE id=%d LIMIT 1", earnings, owner_account);
            mysql_query(mysql, query, false);
        }
    }

    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
        g_dps_radar_player_inside[radarid][playerid] = false;

    g_dps_portable_radar[radarid][DPR_ACTIVE] = false;
    g_dps_portable_radar[radarid][DPR_OWNER_ACCOUNT_ID] = 0;
    g_dps_portable_radar[radarid][DPR_OWNER_NAME][0] = EOS;
    g_dps_portable_radar[radarid][DPR_EXPIRE_AT] = 0;
    g_dps_portable_radar[radarid][DPR_EARNINGS] = 0;
    g_dps_portable_radar[radarid][DPR_OBJECT] = 0;
    g_dps_portable_radar[radarid][DPR_X] = 0.0;
    g_dps_portable_radar[radarid][DPR_Y] = 0.0;
    g_dps_portable_radar[radarid][DPR_Z] = 0.0;
    g_dps_portable_radar[radarid][DPR_WORLD] = 0;
    g_dps_portable_radar[radarid][DPR_INTERIOR] = 0;
    return 1;
}

stock DPSRadar_Place(playerid)
{
    new radarid = DPSRadar_FindFreeSlot();
    if(radarid == -1)
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "На сервере достигнут лимит установленных радаров", " ");
        return -1;
    }

    new Float:x, Float:y, Float:z, Float:angle;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, angle);

    // Ставим объект немного перед игроком, чтобы он не появлялся прямо внутри персонажа.
    x += floatsin(-angle, degrees) * 1.25;
    y += floatcos(-angle, degrees) * 1.25;
    z -= 1.0;

    new world = GetPlayerVirtualWorld(playerid);
    new interior = GetPlayerInterior(playerid);

    new objectid = CreateDynamicObject(
        DPS_RADAR_MODEL_ID,
        x, y, z,
        0.0, 0.0, angle,
        world, interior, -1, 180.0
    );
    if(objectid <= 0)
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Не удалось установить объект радара", " ");
        return -1;
    }

    g_dps_portable_radar[radarid][DPR_ACTIVE] = true;
    g_dps_portable_radar[radarid][DPR_OWNER_ACCOUNT_ID] = GetPlayerAccountID(playerid);
    format(g_dps_portable_radar[radarid][DPR_OWNER_NAME], MAX_PLAYER_NAME + 1, "%s", GetPlayerNameEx(playerid));
    g_dps_portable_radar[radarid][DPR_EXPIRE_AT] = gettime() + DPS_RADAR_LIFETIME;
    g_dps_portable_radar[radarid][DPR_EARNINGS] = 0;
    g_dps_portable_radar[radarid][DPR_OBJECT] = objectid;
    g_dps_portable_radar[radarid][DPR_X] = x;
    g_dps_portable_radar[radarid][DPR_Y] = y;
    g_dps_portable_radar[radarid][DPR_Z] = z;
    g_dps_portable_radar[radarid][DPR_WORLD] = world;
    g_dps_portable_radar[radarid][DPR_INTERIOR] = interior;

    new label_text[192];
    format(
        label_text,
        sizeof(label_text),
        "{33CCFF}Стационарный радар\n{FFFFFF}Установил: {FFFF00}%s\n{FFFFFF}Осталось: {33CC33}15 мин.\n{FFFFFF}Ограничение: {FFFF00}%d км/ч",
        GetPlayerNameEx(playerid),
        DPS_RADAR_SPEED_LIMIT
    );
    g_dps_portable_radar[radarid][DPR_LABEL] = CreateDynamic3DTextLabel(
        label_text,
        0xFFFFFFFF,
        x, y, z + 2.0,
        35.0,
        INVALID_PLAYER_ID,
        INVALID_VEHICLE_ID,
        0,
        world,
        interior
    );

    for(new i = 0; i < MAX_PLAYERS; i++)
        g_dps_radar_player_inside[radarid][i] = false;

    return radarid;
}

stock DPSRadar_ProcessPlayer(playerid)
{
    if(!IsPlayerLogged(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        return 1;

    new speed = GetPlayerSpeed(playerid);
    new world = GetPlayerVirtualWorld(playerid);
    new interior = GetPlayerInterior(playerid);

    for(new radarid = 0; radarid < MAX_DPS_PORTABLE_RADARS; radarid++)
    {
        if(!g_dps_portable_radar[radarid][DPR_ACTIVE])
            continue;

        if(world != g_dps_portable_radar[radarid][DPR_WORLD] || interior != g_dps_portable_radar[radarid][DPR_INTERIOR])
        {
            g_dps_radar_player_inside[radarid][playerid] = false;
            continue;
        }

        new bool:is_inside = IsPlayerInRangeOfPoint(
            playerid,
            40.0,
            g_dps_portable_radar[radarid][DPR_X],
            g_dps_portable_radar[radarid][DPR_Y],
            g_dps_portable_radar[radarid][DPR_Z]
        );

        if(!is_inside)
        {
            g_dps_radar_player_inside[radarid][playerid] = false;
            continue;
        }

        // Один штраф за один въезд в зону радара. Повтор возможен только после выезда.
        if(g_dps_radar_player_inside[radarid][playerid])
            continue;

        g_dps_radar_player_inside[radarid][playerid] = true;

        if(speed > DPS_RADAR_SPEED_LIMIT + DPS_RADAR_GRACE_KMH)
        {
            new excess = speed - DPS_RADAR_SPEED_LIMIT;
            new fine = excess * 200;
            new reason[64];

            format(reason, sizeof(reason), "Превышение скорости на %d км/ч", excess);
            CreateTicket(playerid, fine, "Стационарный радар", reason);
            g_dps_portable_radar[radarid][DPR_EARNINGS] += fine;

            new msg[144];
            format(msg, sizeof(msg), "{FF6666}Радар зафиксировал превышение на %d км/ч. Штраф: %d руб.", excess, fine);
            SendClientMessage(playerid, 0xFFFFFFFF, msg);
        }
    }
    return 1;
}

stock DPSRadar_Tick()
{
    new now = gettime();

    for(new radarid = 0; radarid < MAX_DPS_PORTABLE_RADARS; radarid++)
    {
        if(!g_dps_portable_radar[radarid][DPR_ACTIVE])
            continue;

        if(now >= g_dps_portable_radar[radarid][DPR_EXPIRE_AT])
        {
            DPSRadar_Remove(radarid, true);
            continue;
        }

        DPSRadar_UpdateLabel(radarid);
    }
    return 1;
}

