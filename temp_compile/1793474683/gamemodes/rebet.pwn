}
forward CheckDPSSpeedLimit();
public CheckDPSSpeedLimit()
{
    foreach(new playerid : Player)
    {
        if(!IsPlayerConnected(playerid)) continue;
        if(!GetPVarInt(playerid, "in_dps_zone")) continue;
        if(!IsPlayerInAnyVehicle(playerid)) continue;
        if(!IsPlayerDriver(playerid)) continue;

        new vehicleid = GetPlayerVehicleID(playerid);

        new Float:vx, Float:vy, Float:vz;
        GetVehicleVelocity(vehicleid, vx, vy, vz);

        // Текущая скорость в км/ч
        new Float:velocity = floatsqroot(vx * vx + vy * vy + vz * vz);
        new Float:currentSpeed = velocity * 181.5;

        if(currentSpeed > 60.0)
        {
            // Максимальная скорость в игровых единицах
            new Float:maxVelocity = 60.0 / 181.5;

            // Текущая скорость в игровых единицах
            if(velocity > maxVelocity)
            {
                new Float:k = maxVelocity / velocity;

                // Ограничиваем только X и Y
                SetVehicleVelocity(vehicleid,
                    vx * k,
                    vy * k,
                    vz);
            }

            if(gettime() - GetPVarInt(playerid, "last_speed_warn") >= 3)
            {
                ShowNotificationLaird(playerid, 2, 2, 0, 0,
                    "Превышение! Максимальная скорость 60 км/ч", " ");

                SetPVarInt(playerid, "last_speed_warn", gettime());
            }
        }
    }
    return 1;
}
