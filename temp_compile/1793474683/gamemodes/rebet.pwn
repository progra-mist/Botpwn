public: EntranceStatusInit(entranceid)
{
	new e_houses = 0;
	for(new idx; idx < g_house_loaded; idx ++)
	{
		if(GetHouseData(idx, H_ENTRACE) != entranceid) continue;
		if(!IsHouseOwned(idx)) continue;

		e_houses ++;
	}
	UpdateEntrance(entranceid, e_houses);
}


stock LoadOwnableCarTuningCacheRow(idx, row)
{
    SetOwnableCarData(idx, OC_vinil_current,       cache_get_field_content_int(row, "vinil_current"));
    SetOwnableCarData(idx, OC_exhsuast_current,    cache_get_field_content_int(row, "exhsuast_current"));
    SetOwnableCarData(idx, OC_strab_current,       cache_get_field_content_int(row, "strab_current"));
    SetOwnableCarData(idx, OC_EnableNeon,          cache_get_field_content_int(row, "EnableNeon"));
    SetOwnableCarData(idx, OC_horn_current,        cache_get_field_content_int(row, "horn_current"));

    SetOwnableCarData(idx, OC_COMFORT1,            cache_get_field_content_int(row, "comfort1"));
    SetOwnableCarData(idx, OC_SPORT1,              cache_get_field_content_int(row, "sport1"));
    SetOwnableCarData(idx, OC_DRIFT1,              cache_get_field_content_int(row, "drift1"));
    SetOwnableCarData(idx, OC_SPORT_PL1,           cache_get_field_content_int(row, "sport_plus1"));
    SetOwnableCarData(idx, OC_COMFORT2,            cache_get_field_content_int(row, "comfort2"));
    SetOwnableCarData(idx, OC_SPORT2,              cache_get_field_content_int(row, "sport2"));
    SetOwnableCarData(idx, OC_DRIFT2,              cache_get_field_content_int(row, "drift2"));
    SetOwnableCarData(idx, OC_SPORT_PL2,           cache_get_field_content_int(row, "sport_plus2"));
    SetOwnableCarData(idx, OC_COMFORT3,            cache_get_field_content_int(row, "comfort3"));
    SetOwnableCarData(idx, OC_SPORT3,              cache_get_field_content_int(row, "sport3"));
    SetOwnableCarData(idx, OC_DRIFT3,              cache_get_field_content_int(row, "drift3"));
    SetOwnableCarData(idx, OC_SPORT_PL3,           cache_get_field_content_int(row, "sport_plus3"));
    SetOwnableCarData(idx, OC_COMFORT4,            cache_get_field_content_int(row, "comfort4"));
    SetOwnableCarData(idx, OC_SPORT4,              cache_get_field_content_int(row, "sport4"));
    SetOwnableCarData(idx, OC_DRIFT4,              cache_get_field_content_int(row, "drift4"));
    SetOwnableCarData(idx, OC_SPORT_PL4,           cache_get_field_content_int(row, "sport_plus4"));

    SetOwnableCarData(idx, OC_COMFORT_PL,           cache_get_field_content_int(row, "comfort"));
    SetOwnableCarData(idx, OC_SPORT,                cache_get_field_content_int(row, "sport"));
    SetOwnableCarData(idx, OC_SPORT_PL,             cache_get_field_content_int(row, "sport_plus"));
    SetOwnableCarData(idx, OC_DRIFT,                cache_get_field_content_int(row, "drift"));
    SetOwnableCarData(idx, OC_BRAKE,                cache_get_field_content_int(row, "brake_level"));
    SetOwnableCarData(idx, OC_HIGHLIGHT,            cache_get_field_content_int(row, "highlight_type"));
    SetOwnableCarData(idx, OC_STROBOSCOPE,          cache_get_field_content_int(row, "stroboscope_type"));
    SetOwnableCarData(idx, OC_EXHAUST,              cache_get_field_content_int(row, "exhaust_type"));
    SetOwnableCarData(idx, OC_HORN,                 cache_get_field_content_int(row, "horn_id"));
    SetOwnableCarData(idx, OC_HYDRAULICS,           cache_get_field_content_int(row, "hydraulic"));

    SetOwnableCarData(idx, OC_PT_BRAKE,             cache_get_field_content_int(row, "pt_brake"));
    SetOwnableCarData(idx, OC_PT_STABILITY,         cache_get_field_content_int(row, "pt_stability"));
    SetOwnableCarData(idx, OC_PT_ENGINE,            cache_get_field_content_int(row, "pt_engine"));
    SetOwnableCarData(idx, OC_LAUCH,                cache_get_field_content_int(row, "launch"));
    SetOwnableCarData(idx, OC_NITRO,                cache_get_field_content_int(row, "nitro_level"));
    SetOwnableCarData(idx, OC_isHydroActive,        cache_get_field_content_int(row, "is_hydro_active"));
    SetOwnableCarData(idx, OC_isHydroBought,        cache_get_field_content_int(row, "is_hydro_bought"));
    SetOwnableCarData(idx, OC_isFarLightBought,     cache_get_field_content_int(row, "is_FarLight_bought"));
    SetOwnableCarData(idx, OC_isFarLightActive,     cache_get_field_content_int(row, "is_FarLight_active"));
    SetOwnableCarData(idx, OC_isPnevmoBought,       cache_get_field_content_int(row, "is_pnevmo_bought"));
    SetOwnableCarData(idx, OC_PnevmoSelected,       cache_get_field_content_int(row, "pnevmo_selected"));
    SetOwnableCarData(idx, OC_PDVRADAR,             cache_get_field_content_int(row, "pdvradar"));
    SetOwnableCarData(idx, OC_ISCASE,               cache_get_field_content_int(row, "iscase"));
    SetOwnableCarData(idx, OC_percentofclirness,    cache_get_field_content_int(row, "percentofclirness"));
    SetOwnableCarData(idx, OC_percentofclirnessZ,   cache_get_field_content_int(row, "percentofclirnessZ"));

    SetOwnableCarData(idx, OC_wheel_offset_ft,      cache_get_field_content_int(row, "wheel_offset_ft"));
    SetOwnableCarData(idx, OC_wheel_offset_rr,      cache_get_field_content_int(row, "wheel_offset_rr"));
    SetOwnableCarData(idx, OC_align_ft,             cache_get_field_content_int(row, "align_ft"));
    SetOwnableCarData(idx, OC_align_rr,             cache_get_field_content_int(row, "align_rr"));
    SetOwnableCarData(idx, OC_width_ft,             cache_get_field_content_int(row, "width_ft"));
    SetOwnableCarData(idx, OC_width_rr,             cache_get_field_content_int(row, "width_rr"));
    SetOwnableCarData(idx, OC_wheel_radius,         cache_get_field_content_int(row, "wheel_radius"));
    SetOwnableCarData(idx, OC_wheelcolors,          cache_get_field_content_int(row, "wheel_colors"));
    SetOwnableCarData(idx, OC_lights_color,         cache_get_field_content_int(row, "lights_color"));
    SetOwnableCarData(idx, OC_underlights_color,    cache_get_field_content_int(row, "underlights_color"));
    SetOwnableCarData(idx, OC_underlights_color_lf, cache_get_field_content_int(row, "underlights_color_lf"));
    SetOwnableCarData(idx, OC_underlights_color_rt, cache_get_field_content_int(row, "underlights_color_rt"));
    SetOwnableCarData(idx, OC_body_colors,          cache_get_field_content_int(row, "body_colors"));
    SetOwnableCarData(idx, OC_tonir_ft,             cache_get_field_content_int(row, "tonir_ft"));
    SetOwnableCarData(idx, OC_tonir_rr,             cache_get_field_content_int(row, "tonir_rr"));
    SetOwnableCarData(idx, OC_wheelcomp,            cache_get_field_content_int(row, "wheel_comp"));
    SetOwnableCarData(idx, OC_FSTATE,               cache_get_field_content_int(row, "f_state"));
    SetOwnableCarData(idx, OC_SUPERCHARGER,         cache_get_field_content_int(row, "supercharger"));
    SetOwnableCarData(idx, OC_PT_TURBO,             cache_get_field_content_int(row, "pt_turbo"));
    SetOwnableCarData(idx, OC_TONER_FRONT,          cache_get_field_content_int(row, "toner_front"));
    SetOwnableCarData(idx, OC_TONER_REAR,           cache_get_field_content_int(row, "toner_rear"));

    cache_get_field_content(row, "vynil_name", vInfo[idx][vynil_name], mysql, 32);

    new value[20];
    cache_get_field_content(row, "color_body_r", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_COLOR_BODY_R]);
    cache_get_field_content(row, "color_body_g", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_COLOR_BODY_G]);
    cache_get_field_content(row, "color_wheels", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_COLOR_WHEELS]);
    cache_get_field_content(row, "light_color", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_LIGHT_COLOR]);

    cache_get_field_content(row, "neon_center", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_NEON_CENTER]);
    else SetOwnableCarData(idx, OC_NEON_CENTER, 0);
    cache_get_field_content(row, "neon_left", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_NEON_LEFT]);
    else SetOwnableCarData(idx, OC_NEON_LEFT, 0);
    cache_get_field_content(row, "neon_right", value, mysql, sizeof value);
    if(value[0]) sscanf(value, "x", g_ownable_car[idx][OC_NEON_RIGHT]);
    else SetOwnableCarData(idx, OC_NEON_RIGHT, 0);

    g_ownable_tuning_ready[idx] = false;
    return 1;
}

stock PrepareOwnableCarTuningRuntime(vehicleid)
{
    if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid)) return 0;
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_OWNABLE_CAR) return 0;

    new idx = GetVehicleData(vehicleid, V_ACTION_ID);
    if(idx < 0 || idx >= MAX_OWNABLE_CARS) return 0;

    vInfo[idx][vSQLID]             = GetOwnableCarData(idx, OC_SQL_ID);
    vInfo[vehicleid][vSQLID]       = GetOwnableCarData(idx, OC_SQL_ID);
    vInfo[idx][vModelID]           = GetOwnableCarData(idx, OC_MODEL_ID);
    vInfo[vehicleid][vModelID]     = GetOwnableCarData(idx, OC_MODEL_ID);

    vInfo[idx][vNitro]             = GetOwnableCarData(idx, OC_NITRO);
    vInfo[idx][IsHydroActive]      = GetOwnableCarData(idx, OC_isHydroActive);
    vInfo[idx][IsHydroBought]      = GetOwnableCarData(idx, OC_isHydroBought);
    vInfo[idx][IsFarLightBought]   = GetOwnableCarData(idx, OC_isFarLightBought);
    vInfo[idx][IsFarLightActive]   = GetOwnableCarData(idx, OC_isFarLightActive);
    vInfo[idx][IsPnevmoBought]     = GetOwnableCarData(idx, OC_isPnevmoBought);
    vInfo[idx][SelectedPnevmo]     = GetOwnableCarData(idx, OC_PnevmoSelected);
    vInfo[idx][pdvradar]           = GetOwnableCarData(idx, OC_PDVRADAR);
    vInfo[idx][iscase]             = GetOwnableCarData(idx, OC_ISCASE);
    vInfo[idx][percentofclirness]  = GetOwnableCarData(idx, OC_percentofclirness);
    vInfo[idx][percentofclirnessz] = GetOwnableCarData(idx, OC_percentofclirnessZ);
    vInfo[idx][wheel_offset_ft]    = GetOwnableCarData(idx, OC_wheel_offset_ft);
    vInfo[idx][wheel_offset_rr]    = GetOwnableCarData(idx, OC_wheel_offset_rr);
    vInfo[idx][align_ft]           = GetOwnableCarData(idx, OC_align_ft);
    vInfo[idx][align_rr]           = GetOwnableCarData(idx, OC_align_rr);
    vInfo[idx][width_ft]           = GetOwnableCarData(idx, OC_width_ft);
    vInfo[idx][width_rr]           = GetOwnableCarData(idx, OC_width_rr);
    vInfo[idx][wheel_radius]       = GetOwnableCarData(idx, OC_wheel_radius);
    vInfo[idx][wheel_colors]       = GetOwnableCarData(idx, OC_wheelcolors);
    vInfo[idx][lights_color]       = GetOwnableCarData(idx, OC_lights_color);
    vInfo[idx][underlights_color]  = GetOwnableCarData(idx, OC_underlights_color);
    vInfo[idx][underlights_color_lf] = GetOwnableCarData(idx, OC_underlights_color_lf);
    vInfo[idx][underlights_color_rt] = GetOwnableCarData(idx, OC_underlights_color_rt);
    vInfo[idx][body_colors]        = GetOwnableCarData(idx, OC_body_colors);
    vInfo[idx][tonir_ft]           = GetOwnableCarData(idx, OC_tonir_ft);
    vInfo[idx][tonir_rr]           = GetOwnableCarData(idx, OC_tonir_rr);
    vInfo[idx][wheel_comp]         = GetOwnableCarData(idx, OC_wheelcomp);
    vInfo[idx][vFstate]            = GetOwnableCarData(idx, OC_FSTATE);
    vInfo[idx][vLaunchControl]     = GetOwnableCarData(idx, OC_LAUCH);
    vInfo[idx][vEnableNeon]        = GetOwnableCarData(idx, OC_EnableNeon);
    vInfo[idx][exhsuast_current]   = GetOwnableCarData(idx, OC_exhsuast_current);
    vInfo[idx][strab_current]      = GetOwnableCarData(idx, OC_strab_current);
    vInfo[idx][horn_current]       = GetOwnableCarData(idx, OC_horn_current);
    vInfo[idx][vinil_current]      = GetOwnableCarData(idx, OC_vinil_current);
    vInfo[idx][vStrob]             = GetOwnableCarData(idx, OC_STROBOSCOPE);
    vInfo[idx][vExhaustSound]      = GetOwnableCarData(idx, OC_EXHAUST);
    vInfo[idx][vHornSound]         = GetOwnableCarData(idx, OC_HORN);

    vInfo[vehicleid][vNitro]             = vInfo[idx][vNitro];
    vInfo[vehicleid][IsHydroActive]      = vInfo[idx][IsHydroActive];
    vInfo[vehicleid][IsHydroBought]      = vInfo[idx][IsHydroBought];
    vInfo[vehicleid][IsFarLightBought]   = vInfo[idx][IsFarLightBought];
    vInfo[vehicleid][IsFarLightActive]   = vInfo[idx][IsFarLightActive];
    vInfo[vehicleid][IsPnevmoBought]     = vInfo[idx][IsPnevmoBought];
    vInfo[vehicleid][SelectedPnevmo]     = vInfo[idx][SelectedPnevmo];
    vInfo[vehicleid][pdvradar]           = vInfo[idx][pdvradar];
    vInfo[vehicleid][iscase]             = vInfo[idx][iscase];
    vInfo[vehicleid][percentofclirness]  = vInfo[idx][percentofclirness];
    vInfo[vehicleid][percentofclirnessz] = vInfo[idx][percentofclirnessz];
    vInfo[vehicleid][wheel_offset_ft]    = vInfo[idx][wheel_offset_ft];
    vInfo[vehicleid][wheel_offset_rr]    = vInfo[idx][wheel_offset_rr];
    vInfo[vehicleid][align_ft]           = vInfo[idx][align_ft];
    vInfo[vehicleid][align_rr]           = vInfo[idx][align_rr];
    vInfo[vehicleid][width_ft]           = vInfo[idx][width_ft];
    vInfo[vehicleid][width_rr]           = vInfo[idx][width_rr];
    vInfo[vehicleid][wheel_radius]       = vInfo[idx][wheel_radius];
    vInfo[vehicleid][wheel_colors]       = vInfo[idx][wheel_colors];
    vInfo[vehicleid][lights_color]       = vInfo[idx][lights_color];
    vInfo[vehicleid][underlights_color]  = vInfo[idx][underlights_color];
    vInfo[vehicleid][underlights_color_lf] = vInfo[idx][underlights_color_lf];
    vInfo[vehicleid][underlights_color_rt] = vInfo[idx][underlights_color_rt];
    vInfo[vehicleid][body_colors]        = vInfo[idx][body_colors];
    vInfo[vehicleid][tonir_ft]           = vInfo[idx][tonir_ft];
    vInfo[vehicleid][tonir_rr]           = vInfo[idx][tonir_rr];
    vInfo[vehicleid][wheel_comp]         = vInfo[idx][wheel_comp];
    vInfo[vehicleid][vFstate]            = vInfo[idx][vFstate];
    vInfo[vehicleid][vLaunchControl]     = vInfo[idx][vLaunchControl];
    vInfo[vehicleid][vEnableNeon]        = vInfo[idx][vEnableNeon];
    vInfo[vehicleid][exhsuast_current]   = vInfo[idx][exhsuast_current];
    vInfo[vehicleid][strab_current]      = vInfo[idx][strab_current];
    vInfo[vehicleid][horn_current]       = vInfo[idx][horn_current];
    vInfo[vehicleid][vinil_current]      = vInfo[idx][vinil_current];
    vInfo[vehicleid][vStrob]             = vInfo[idx][vStrob];
    vInfo[vehicleid][vExhaustSound]      = vInfo[idx][vExhaustSound];
    vInfo[vehicleid][vHornSound]         = vInfo[idx][vHornSound];
    format(vInfo[vehicleid][vynil_name], 32, "%s", vInfo[idx][vynil_name]);

    g_ownable_tuning_ready[idx] = true;
    return 1;
}

public: LoadOwnableCars()
{
	new rows, vehicleid;
	new Cache: result;

	result = mysql_query(mysql, "SELECT oc.*, IFNULL(a.name, 'None') AS owner_name FROM ownable_cars oc LEFT JOIN accounts a ON a.id = oc.owner_id", true);
	rows = cache_num_rows();

	if(rows > MAX_OWNABLE_CARS)
	{
		rows = MAX_OWNABLE_CARS;
		print("[OwnableCars]: DB rows > MAX_OWNABLE_CARS");
	}
	for(new idx; idx < rows; idx ++)
	{
		SetOwnableCarData(idx, OC_SQL_ID, 		cache_get_field_content_int(idx, "id"));
		SetOwnableCarData(idx, OC_OWNER_ID, 	cache_get_field_content_int(idx, "owner_id"));

		SetOwnableCarData(idx, OC_MODEL_ID, 	cache_get_field_content_int(idx, "model_id"));
		SetOwnableCarData(idx, OC_COLOR_1, 		cache_get_field_content_int(idx, "color_1"));
		SetOwnableCarData(idx, OC_COLOR_2, 		cache_get_field_content_int(idx, "color_2"));

		SetOwnableCarData(idx, OC_POS_X, 		cache_get_field_content_float(idx, "pos_x"));
		SetOwnableCarData(idx, OC_POS_Y, 		cache_get_field_content_float(idx, "pos_y"));
		SetOwnableCarData(idx, OC_POS_Z, 		cache_get_field_content_float(idx, "pos_z"));
		SetOwnableCarData(idx, OC_ANGLE, 		cache_get_field_content_float(idx, "angle"));

		cache_get_field_content(idx, "number", g_ownable_car[idx][OC_NUMBER], mysql, 32);

		SetOwnableCarData(idx, OC_ALARM, 		bool: cache_get_field_content_int(idx, "alarm"));
		SetOwnableCarData(idx, OC_KEY_IN, 		bool: cache_get_field_content_int(idx, "key_in"));

		SetOwnableCarData(idx, OC_CREATE, 		cache_get_field_content_int(idx, "create_time"));
		SetOwnableCarData(idx, OC_VINILCAR, 		cache_get_field_content_int(idx, "vinilcar"));
		
		SetOwnableCarData(idx, OC_PT_ENGINE, 	cache_get_field_content_int(idx, "pt_engine"));
		SetOwnableCarData(idx, OC_PT_BRAKE, 	cache_get_field_content_int(idx, "pt_brake"));
		SetOwnableCarData(idx, OC_PT_STABILITY, cache_get_field_content_int(idx, "pt_stability"));
		SetOwnableCarData(idx, 	OC_COMFORT_PL,	cache_get_field_content_int(idx, "comfort"));
		SetOwnableCarData(idx, 	OC_SPORT,	cache_get_field_content_int(idx, "sport"));
		SetOwnableCarData(idx, 	OC_SPORT_PL,	cache_get_field_content_int(idx, "sport_plus"));
		SetOwnableCarData(idx, 	OC_DRIFT,	cache_get_field_content_int(idx, "drift"));
		// Slot 1
        SetOwnableCarData(idx, OC_COMFORT1,   cache_get_field_content_int(idx, "comfort1"));
		
        SetOwnableCarData(idx, OC_vinil_current,   cache_get_field_content_int(idx, "vinil_current"));
		SetOwnableCarData(idx, OC_exhsuast_current,   cache_get_field_content_int(idx, "exhsuast_current"));
		SetOwnableCarData(idx, OC_strab_current,   cache_get_field_content_int(idx, "strab_current"));
		
		SetOwnableCarData(idx, OC_EnableNeon,   cache_get_field_content_int(idx, "EnableNeon"));
		SetOwnableCarData(idx, OC_horn_current,   cache_get_field_content_int(idx, "horn_current"));
		
        SetOwnableCarData(idx, OC_SPORT1,     cache_get_field_content_int(idx, "sport1"));
        SetOwnableCarData(idx, OC_DRIFT1,     cache_get_field_content_int(idx, "drift1"));
        SetOwnableCarData(idx, OC_SPORT_PL1,  cache_get_field_content_int(idx, "sport_plus1"));
        
        // Slot 2
        SetOwnableCarData(idx, OC_COMFORT2,   cache_get_field_content_int(idx, "comfort2"));
        SetOwnableCarData(idx, OC_SPORT2,     cache_get_field_content_int(idx, "sport2"));
        SetOwnableCarData(idx, OC_DRIFT2,     cache_get_field_content_int(idx, "drift2"));
        SetOwnableCarData(idx, OC_SPORT_PL2,  cache_get_field_content_int(idx, "sport_plus2"));
        
        // Slot 3
        SetOwnableCarData(idx, OC_COMFORT3,   cache_get_field_content_int(idx, "comfort3"));
        SetOwnableCarData(idx, OC_SPORT3,     cache_get_field_content_int(idx, "sport3"));
        SetOwnableCarData(idx, OC_DRIFT3,     cache_get_field_content_int(idx, "drift3"));
        SetOwnableCarData(idx, OC_SPORT_PL3,  cache_get_field_content_int(idx, "sport_plus3"));
        
        // Slot 4
        SetOwnableCarData(idx, OC_COMFORT4,   cache_get_field_content_int(idx, "comfort4"));
        SetOwnableCarData(idx, OC_SPORT4,     cache_get_field_content_int(idx, "sport4"));
        SetOwnableCarData(idx, OC_DRIFT4,     cache_get_field_content_int(idx, "drift4"));
        SetOwnableCarData(idx, OC_SPORT_PL4,  cache_get_field_content_int(idx, "sport_plus4"));

        // Load the rest of the tuning data before the vehicle is created/streamed.
        LoadOwnableCarTuningCacheRow(idx, idx);
		// cache_get_field_content(idx, "owner_name", g_ownable_car[idx][OC_OWNER_NAME], mysql, 21);
		// ----------------------------------------------------------------------------------------

		new tmp_plate_type;
		new tmp_plate[16], tmp_region[8];
		if(!ParseStoredPlateValue(g_ownable_car[idx][OC_NUMBER], tmp_plate_type, tmp_plate, sizeof(tmp_plate), tmp_region, sizeof(tmp_region)))
			strmid(g_ownable_car[idx][OC_NUMBER], "------", 0, 8, 32);

		vehicleid = CreateVehicle
		(
			GetOwnableCarData(idx, OC_MODEL_ID),
			GetOwnableCarData(idx, OC_POS_X),
			GetOwnableCarData(idx, OC_POS_Y),
			GetOwnableCarData(idx, OC_POS_Z),
			GetOwnableCarData(idx, OC_ANGLE),
			GetOwnableCarData(idx, OC_COLOR_1),
			GetOwnableCarData(idx, OC_COLOR_2),
			-1,
			0,
			VEHICLE_ACTION_TYPE_OWNABLE_CAR,
			idx
		);
		if(vehicleid != INVALID_VEHICLE_ID)
		{
			//CreateVehicleLabel(vehicleid, GetOwnableCarData(idx, OC_NUMBER), 0xFFFF00EE, 0.0, 0.0, 1.3, 20.0);
			//index = GetVehicleData(vehicleid, V_ACTION_ID);
            format(g_ownable_car[idx][OC_NUMBER], 32, g_ownable_car[idx][OC_NUMBER]);
            ApplyOwnableCarStoredPlate(vehicleid, idx);
			SetVehicleParam(vehicleid, V_LOCK, bool: cache_get_field_content_int(idx, "status"));

			new Float:loaded_mileage = cache_get_field_content_float(idx, "mileage");
            new Float:loaded_fuel = cache_get_field_content_float(idx, "fuel");
            if(loaded_fuel < 0.0) loaded_fuel = 40.0;
            SetVehicleData(vehicleid, V_MILEAGE, loaded_mileage);
            SetVehicleData(vehicleid, V_FUEL, loaded_fuel);
            SetVehicleSpeedometerInfo(vehicleid, loaded_fuel, loaded_mileage);
            g_ownable_mileage_saved[vehicleid] = loaded_mileage;
            g_ownable_mileage_sync_time[vehicleid] = gettime();
            g_ownable_fuel_saved[vehicleid] = loaded_fuel;
            g_ownable_fuel_sync_time[vehicleid] = gettime();
		}
	}
	g_ownable_car_loaded = rows;
	cache_delete(result);

	printf("[OwnableCars]: Личных авто загружено: %d", g_ownable_car_loaded);
}

public: LoadOwnableCar(oc_id)
{
	if(g_ownable_car_loaded + 1 > MAX_OWNABLE_CARS)
	{
		print("[OwnableCars]: Ошибка в загрузке. Превышен лимит личного транспорта (MAX_OWNABLE_CARS)");
		return -1;
	}

	new query[55],
		Cache: result,
		vehicleid;

	mysql_format(mysql, query, sizeof query, "SELECT * FROM ownable_cars WHERE id='%d' LIMIT 1", oc_id);
	result = mysql_query(mysql, query, true);

	new idx = GetFreeOwnableCarID();
	SetOwnableCarData(idx, OC_SQL_ID, 		cache_get_field_content_int(0, "id"));
	SetOwnableCarData(idx, OC_OWNER_ID, 	cache_get_field_content_int(0, "owner_id"));

	SetOwnableCarData(idx, OC_MODEL_ID, 	cache_get_field_content_int(0, "model_id"));
	SetOwnableCarData(idx, OC_COLOR_1, 		cache_get_field_content_int(0, "color_1"));
	SetOwnableCarData(idx, OC_COLOR_2, 		cache_get_field_content_int(0, "color_2"));

