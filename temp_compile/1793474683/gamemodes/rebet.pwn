public OnGameModeInit()
{
	new ip[16];
    GetServerVarAsString("bind", ip, sizeof(ip));
	SetTimer("CorrectTimerMinute", 60000, true);

    // Vehicle turn signals. Client sends action 3 through RPC 97,
    // server synchronizes the blinking with packet 12.
    SetTimer("UpdateVehicleTurnSignals", 500, true);
    for(new vehicleid = 0; vehicleid < MAX_VEHICLES; vehicleid++)
    {
        TurnSignalState[vehicleid] = 0;
        TurnSignalBlinkOn[vehicleid] = false;
        TurnSignalDriver[vehicleid] = INVALID_PLAYER_ID;
        TurnSignalModel[vehicleid] = 0;
    }

	CreateTextDraws();
	WeaponShop_CreateStaticShops();
