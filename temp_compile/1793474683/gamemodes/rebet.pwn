stock UpdateBusinessDatabaseInt(biz_id, const field[], value)
{
    new query[128];
    mysql_format(mysql, query, sizeof(query), "UPDATE business SET %s=%d WHERE id=%d", field, value, GetBusinessData(biz_id, B_SQL_ID));
    mysql_tquery(mysql, query, "", "");
}


