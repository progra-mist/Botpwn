stock GetTuneIdFromItem(id)
{
    if(id < 0 || id > MAX_TUNE_ITEM_ID) return 0;
    return ItemTuneId[id];
}

public OnPlayerPickUpPickupEx(playerid, pickupid, action_type, action_id)
{
    if(pickupid == auction_exit_pickup && GetPlayerVirtualWorld(playerid) == AUCTION_WORLD)
    {
        SetPlayerPosEx(playerid, 2090.941650,-2283.999511,23.101566,92.530944, 0, 0);
        SendClientMessage(playerid, 0x66CC33FF, "\xc2\xfb \xe2\xfb\xf8\xeb\xe8 \xe8\xe7 \xe0\xf3\xea\xf6\xe8\xee\xed\xe0.");
        return 1;
    }
    if(TCompany_HandlePickup(playerid, pickupid)) return 1;

    // Рабочие раздевалки организаций. Каждый пикап привязан к своей фракции.
    new locker_team = TEAM_NONE;
    if(pickupid == razdev) locker_team = TEAM_FBI;
    else if(pickupid == razdev1) locker_team = TEAM_GOVERNMENT;
    else if(pickupid == razdev_gov2) locker_team = TEAM_GOVERNMENT;
    else if(pickupid == razdev2) locker_team = TEAM_ARMY;
    else if(pickupid == razdev3) locker_team = TEAM_HOSPITAL;
    else if(pickupid == razdev9) locker_team = TEAM_RADIO;
    else if(pickupid == razdev4) locker_team = TEAM_DPS;
    else if(pickupid == razdev5) locker_team = TEAM_PPS;
    else if(pickupid == razdev6) locker_team = TEAM_OPG_ARZAMASKAYA;
    else if(pickupid == razdev7) locker_team = TEAM_OPG_BATYREVSKAYA;
    else if(pickupid == razdev8) locker_team = TEAM_OPG_LYTKARINSKAYA;

    if(locker_team != TEAM_NONE)
    {
        if(GetPlayerTeamEx(playerid) != locker_team)
            return SendClientMessage(playerid, 0x999999FF, "Эта раздевалка доступна только сотрудникам данной организации.");

        if(GetPVarInt(playerid, "Form") == 0)
            Dialog(playerid, DIALOG_FRAKSKINS, DIALOG_STYLE_MSGBOX, "{FFCC00}Раздевалка", "Вы действительно хотите начать рабочий день?", "Да", "Нет");
        else
            Dialog(playerid, DIALOG_FRAKSKINS, DIALOG_STYLE_MSGBOX, "{FFCC00}Раздевалка", "Вы действительно хотите закончить рабочий день?", "Да", "Нет");
        return 1;
    }
    //===============[вот сюдыыыыы]=============================
    if(litvinghghgh != -1 && pickupid == litvinghghgh)
	{
	    if(litvin[playerid] != 1)
		{
		     //endClientMessage(playerid, COLOR_WHITE, "{00CED1}[DEBUG]{FFFFFF} pickupid litvinghghgh");
  		    Dialog(playerid, DLG_LITVIN1, DIALOG_STYLE_MSGBOX, "{00CC00}Литвин", "Всем добро, на связи команда Adidas!", "Дальше", "");
			return 1;
		}
					else
		{
		    return 1;
		}
		return 1;
	}
	
	if(pickupid == larekyuzh)
{
    SetPVarInt(playerid, "larek_biz_id", gAuctionServiceBiz[2]);
    callcmd::larek(playerid, "");
    return 1;
}
if(pickupid == larekarz)
{
    SetPVarInt(playerid, "larek_biz_id", gAuctionServiceBiz[3]);
    callcmd::larek(playerid, "");
    return 1;
}
if(pickupid == larekbat)
{
    SetPVarInt(playerid, "larek_biz_id", gAuctionServiceBiz[4]);
    callcmd::larek(playerid, "");
    return 1;
}
if(pickupid == lareklitk)
{
    SetPVarInt(playerid, "larek_biz_id", gAuctionServiceBiz[5]);
    callcmd::larek(playerid, "");
    return 1;
}


	if(pickupid == pickup_rent_main)
    {
        ShowRentMenu(playerid);
    }
    if(pickupid == g_casino_bonus_entry_pickup)
    {
        new casino_biz = GetNearestBiz(playerid, BUSINESS_TYPE_CASINO, 0.0);

        if(casino_biz != -1)
        {
            EnterPlayerToBiz(playerid, casino_biz);
            return 1;
        }

        SetPlayerPosEx
        (
            playerid,
            GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_ENTER_POS_X),
            GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_ENTER_POS_Y),
            GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_ENTER_POS_Z),
            GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_ENTER_ANGLE),
            GetBusinessInteriorInfo(BUSINESS_INTERIOR_CASINO, BT_ENTER_INTERIOR),
            0, false
        );
        return 1;
    }

    if(pickupid == g_casino_bonus_exit_pickup)
    {
        SetPlayerPosEx
        (
            playerid,
            1332.560546,
            2361.656738,
            17.712001,
            357.240692,
            0,
            0, false
        );
        return 1;
    }

    if(pickupid == g_casino_croupier_pickup)
    {
        if(pInfo[playerid][CasinoDealerJob] || pInfo[playerid][CasinoManagerJob])
        {
            Dialog(playerid, DIALOG_CASINO_JOB_QUIT, DIALOG_STYLE_MSGBOX, "Работа в казино", "Вы действительно хотите закончить рабочий день?", "Да", "Нет");
            return 1;
        }

        new casino_biz = GetPlayerInBiz(playerid);
