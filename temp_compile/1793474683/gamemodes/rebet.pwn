    EnsureFamilyCarTuningColumn("drift3", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("sport_plus3", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("comfort4", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("sport4", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("drift4", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("sport_plus4", "INT NOT NULL DEFAULT 0");

    EnsureFamilyCarTuningColumn("stroboscope_type", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("exhaust_type", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("horn_id", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("f_state", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("nitro_level", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("launch", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("pdvradar", "INT NOT NULL DEFAULT 0");

