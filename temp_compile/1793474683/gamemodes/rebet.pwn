    EnsureFamilyCarTuningColumn("is_FarLight_active", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("is_hydro_bought", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("is_hydro_active", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("is_pnevmo_bought", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("pnevmo_selected", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("percentofclirness", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("percentofclirnessZ", "INT NOT NULL DEFAULT 0");

    EnsureFamilyCarTuningColumn("wheel_offset_ft", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("wheel_offset_rr", "INT NOT NULL DEFAULT 0");
