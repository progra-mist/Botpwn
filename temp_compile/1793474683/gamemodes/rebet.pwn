CMD:addpadikadse(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 13) return 1;

	new fmt_text[300];


	new Cache: result,
		idx = g_entrance_loaded;

	GetPlayerPos(playerid, g_entrance[idx][E_POS_X], g_entrance[idx][E_POS_Y], g_entrance[idx][E_POS_Z]);

	SetEntranceData(idx, E_FLOORS,			2);

	//SetEntranceData(idx, _ENTRACE,		-1);

	format
	(
		fmt_text, sizeof fmt_text,
		"INSERT INTO entrances \
		(floors, x, y, z)\
		VALUES ('%d', '%f', '%f', '%f')",
		GetEntranceData(idx, E_FLOORS),
		GetEntranceData(idx, E_POS_X),
		GetEntranceData(idx, E_POS_Y),
		GetEntranceData(idx, E_POS_Z)
	);

	result = mysql_query(mysql, fmt_text, true);

	SetEntranceData(idx, E_SQL_ID, 		cache_insert_id());

	cache_delete(result);

	g_entrance_loaded ++;
	
	new e_houses = 0;

	UpdateEntrance(idx, e_houses);

	new city[MAX_ZONES_NAME + 1], area[MAX_ZONES_NAME + 1];
	GetCityName(GetEntranceData(idx, E_POS_X), GetEntranceData(idx, E_POS_Y), city);
	GetAreaName(GetEntranceData(idx, E_POS_X), GetEntranceData(idx, E_POS_Y), area);
	format(fmt_text, sizeof fmt_text, "[A] %s[%d] создал подъезд №%d (%s / %s)", GetPlayerNameEx(playerid), playerid, idx, city, area);

	SendMessageToAdmins(fmt_text, 0x66CC33FF);

	SendClientMessage(playerid, 0x3399FFFF, "Используйте {FFFF00}/esetexitpos {3399FF}- чтобы установить координаты выхода ");

	return 1;
}

CMD:esetexitpos(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 6) return 1;

	extract params -> new house_id; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /esetexitpos [id подъезда]");

	if(!(0 <= house_id <= g_entrance_loaded - 1)) return SendClientMessage(playerid, 0x999999FF, "Данного подъезда не существует на сервере");

	GetPlayerPos(playerid, g_entrance[house_id][E_EXIT_POS_X], g_entrance[house_id][E_EXIT_POS_Y], g_entrance[house_id][E_EXIT_POS_Z]);
	GetPlayerFacingAngle(playerid, g_entrance[house_id][E_EXIT_ANGLE]);

	new fmt_text[144];

	format
	(
		fmt_text, sizeof fmt_text,
		"UPDATE entrances SET exit_x='%f', exit_y='%f', exit_z='%f', exit_angle='%f' WHERE id=%d",
		GetEntranceData(house_id, E_EXIT_POS_X),
		GetEntranceData(house_id, E_EXIT_POS_Y),
		GetEntranceData(house_id, E_EXIT_POS_Z),
		GetEntranceData(house_id, E_EXIT_ANGLE),
		GetEntranceData(house_id, E_SQL_ID)
	);

	mysql_query(mysql, fmt_text, false);

	format(fmt_text, sizeof fmt_text, "Вы успешно изменили координаты выхода у подэезда №%d", house_id);

	SendClientMessage(playerid, 0x66CC33FF, fmt_text);

	return 1;
}

stock LoadFamilyCarTuningCacheRow(family_index, row)
{
    if(!(0 <= family_index < MAX_OWNABLE_CARS)) return 0;

    vehicle_family[family_index][V_F_RANG] = cache_get_field_content_int(row, "rang");
    vehicle_family[family_index][V_F_FSTATE] = cache_get_field_content_int(row, "f_state");
    vehicle_family[family_index][V_F_NITRO] = cache_get_field_content_int(row, "nitro_level");
    vehicle_family[family_index][V_F_LAUNCH] = cache_get_field_content_int(row, "launch");
    vehicle_family[family_index][V_F_LIGHTS_COLOR] = cache_get_field_content_int(row, "lights_color");
    vehicle_family[family_index][V_F_UNDERLIGHT_COLOR] = cache_get_field_content_int(row, "underlights_color");
    vehicle_family[family_index][V_F_UNDERLIGHT_COLOR_LF] = cache_get_field_content_int(row, "underlights_color_lf");
    vehicle_family[family_index][V_F_UNDERLIGHT_COLOR_RT] = cache_get_field_content_int(row, "underlights_color_rt");
    vehicle_family[family_index][V_F_IS_FAR_LIGHT_ACTIVE] = cache_get_field_content_int(row, "is_FarLight_active");
    vehicle_family[family_index][V_F_SELECTED_PNEVMO] = cache_get_field_content_int(row, "pnevmo_selected");
    vehicle_family[family_index][V_F_PERCENT_CLR] = cache_get_field_content_int(row, "percentofclirness");
    vehicle_family[family_index][V_F_PERCENT_CLR_Z] = cache_get_field_content_int(row, "percentofclirnessZ");
    vehicle_family[family_index][V_F_IS_HYDRO_ACTIVE] = cache_get_field_content_int(row, "is_hydro_active");
    cache_get_field_content(row, "vynil_name", vehicle_family[family_index][V_F_VINYL_NAME], mysql, 32);
    return 1;
}

stock ApplyFamilyCarStoredComponents(vehicleid, family_car_sql_id)
{
    if(vehicleid == INVALID_VEHICLE_ID || family_car_sql_id <= 0) return 0;

    new query[144];
    mysql_format(mysql, query, sizeof query, "SELECT componentid FROM vehicle_store_components WHERE vehicleid=%d AND state=2", GetFamilyCarComponentStorageID(family_car_sql_id));
    new Cache:result = mysql_query(mysql, query, true);
    new rows = cache_num_rows();

    for(new i; i < rows; i++)
    {
        new componentid = cache_get_field_content_int(i, "componentid");
        new tuneid = GetTuneIdFromItem(componentid);
        if(tuneid > 0) AddVehicleComponent(vehicleid, tuneid);
    }

    cache_delete(result);
    return 1;
}

public: LoadFamilyCars()
{
    new rows, vehicleid;
    new Cache: result;

    result = mysql_query(mysql, "SELECT * FROM `family_cars` WHERE 1", true);
    rows = cache_num_rows();

    if(rows > MAX_OWNABLE_CARS) rows = MAX_OWNABLE_CARS;

    for(new idx; idx < rows; idx++)
    {
        SetFamilyCarData(idx, F_SQL_ID, cache_get_field_content_int(idx, "id"));
        SetFamilyCarData(idx, F_OWNER_ID, cache_get_field_content_int(idx, "owner_id"));
        SetFamilyCarData(idx, F_MODEL_ID, cache_get_field_content_int(idx, "model_id"));
        SetFamilyCarData(idx, F_COLOR_1, cache_get_field_content_int(idx, "color_1"));
        SetFamilyCarData(idx, F_COLOR_2, cache_get_field_content_int(idx, "color_2"));
        SetFamilyCarData(idx, F_RANG, cache_get_field_content_int(idx, "rang"));
        SetFamilyCarData(idx, F_POS_X, cache_get_field_content_float(idx, "pos_x"));
        SetFamilyCarData(idx, F_POS_Y, cache_get_field_content_float(idx, "pos_y"));
        SetFamilyCarData(idx, F_POS_Z, cache_get_field_content_float(idx, "pos_z"));
        SetFamilyCarData(idx, F_ANGLE, cache_get_field_content_float(idx, "angle"));
        SetFamilyCarData(idx, OC_FUEL, cache_get_field_content_float(idx, "fuel"));

        LoadFamilyCarTuningCacheRow(idx, idx);

        vehicleid = CreateVehicle
        (
            GetFamilyCarData(idx, F_MODEL_ID),
            GetFamilyCarData(idx, F_POS_X),
            GetFamilyCarData(idx, F_POS_Y),
            GetFamilyCarData(idx, F_POS_Z),
            GetFamilyCarData(idx, F_ANGLE),
            GetFamilyCarData(idx, F_COLOR_1),
            GetFamilyCarData(idx, F_COLOR_2),
            -1,
            0,
            VEHICLE_ACTION_TYPE_FAMILY_CAR,
            idx
        );

        if(vehicleid != INVALID_VEHICLE_ID)
        {
            SetFamilyCarData(idx, F_CAR_ID, vehicleid);
            PrepareFamilyCarTuningRuntime(vehicleid, idx, idx);

            new family_id = GetFamilyCarData(idx, F_OWNER_ID);
            if(0 <= family_id < sizeof g_family)
                CreateVehicleLabel(vehicleid, GetFamilyData(family_id, F_NAME), 0x6666CCEE, 0.0, 0.0, 1.3, 20.0);

            SetVehicleParam(vehicleid, V_LOCK, bool:cache_get_field_content_int(idx, "status"));
            SetVehicleData(vehicleid, V_MILEAGE, cache_get_field_content_float(idx, "mileage"));
            ApplyFamilyCarStoredComponents(vehicleid, GetFamilyCarData(idx, F_SQL_ID));
        }
    }

    g_family_car_loaded = rows;
    cache_delete(result);
    printf("[FamilyCars]: Авто загружено: %d", g_family_car_loaded);
    return 1;
}

stock GetFreeFamilyCarID()
{
    for(new idx; idx < sizeof g_family_car; idx ++)
    {
        if(GetFamilyCarData(idx, F_SQL_ID) > 0) continue;

        return idx;
    }

    return -1;
}

public: SaveFamilyCar(vehicleid)
{
    if(IsAFamilyCar(vehicleid))
    {
        new query[360];
        new index = GetVehicleData(vehicleid, V_ACTION_ID);

        new Float: health;

        GetVehicleHealth(vehicleid, health);

        format
        (
            query, sizeof query,
            "UPDATE family_cars SET "\
            "pos_x=%f,"\
            "pos_y=%f,"\
            "pos_z=%f,"\
            "angle=%f"\
            " WHERE id=%d LIMIT 1",
            GetFamilyCarData(index, F_POS_X),
            GetFamilyCarData(index, F_POS_Y),
            GetFamilyCarData(index, F_POS_Z),
            GetFamilyCarData(index, F_ANGLE),
            index-1
        );
        mysql_query(mysql, query, false);
        print(query);
        return mysql_errno();
    }
    return -1;
}

stock IsAFamilyCar(vehicleid)
{
    if(IsValidVehicleID(vehicleid))
    {
        if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
        {
            return 1;
        }
    }
    return 0;
}

