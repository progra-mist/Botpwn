stock SetVehicleColorHexForPlayers(playerid, vehicleid, body, wheel)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 18);
	BS_WriteValue(bitstream, PR_UINT32, body);
	BS_WriteValue(bitstream, PR_UINT32, wheel);
	BS_WriteValue(bitstream, PR_UINT32, wheel);
	BS_WriteValue(bitstream, PR_UINT32, body); 

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}

stock ddSetVehicleColorHexForPlayers(playerid, vehicleid, light)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 8);
	BS_WriteValue(bitstream, PR_UINT32, light); 

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}
stock SetVehicleColorTonrrHexForPlayers(playerid, vehicleid, ft, rr)
{
	new BitStream:bitstream = BS_New();
	BS_WriteValue(bitstream, PR_UINT16, vehicleid);
	BS_WriteValue(bitstream, PR_UINT8, 0);
	BS_WriteValue(bitstream, PR_UINT32, ft);
	BS_WriteValue(bitstream, PR_UINT32, rr);
	BS_WriteValue(bitstream, PR_UINT32, ft);
	BS_WriteValue(bitstream, PR_UINT32, rr); 

	PR_SendRPC(bitstream, playerid, 167, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
	BS_Delete(bitstream);
}


stock AddComponent(playerid, compIndex)
{
    if (!IsPlayerInAnyVehicle(playerid))
        return 0;

    new vehicleid = GetPlayerVehicleID(playerid);

    // Базовый ID компонентов (SA-MP)
    new componentid = 1872 + compIndex;

    printf("[AddComponent] player=%d veh=%d compIndex=%d compID=%d",
        playerid, vehicleid, compIndex, componentid);

    AddToVehicleComponentForPlayer(playerid, vehicleid, componentid);
    return 1;
}

CMD:e(playerid, params[])
{
	printf("LOG  ENGINE");
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SendClientMessage(playerid, 0xCECECEFF, "Вы не за рулем");

	    engine = (GetVehicleParam(vehicleid, V_ENGINE) ^ VEHICLE_PARAM_ON);
		SetVehicleParam(vehicleid, V_ENGINE, engine);
	}
	new i = GetVehicleData(vehicleid, V_ACTION_ID);
	
	if (vInfo[i][vHornSound] != 0){
        SetVehicleHornSound(vehicleid, vInfo[i][vHornSound], 1);
	}
	 if(vInfo[i][IsFarLightActive]){
		SetVehicleFarLight(playerid, vehicleid, 1);
	 }
	if (vInfo[i][vExhaustSound] != 0)
        SetVehicleExhaust(vehicleid, vInfo[i][vExhaustSound]-1, 1);
	switch (vInfo[i][vFstate]){
		case FSTATE_DRIFT:
		   SetVehicleDriftForPlayer(playerid, vehicleid, 1);
		case FSTATE_COMFORT:
		    SendCarFirmware(playerid, FSTATE_COMFORT);
		case FSTATE_SPORT:
		    SendCarFirmware(playerid, FSTATE_SPORT);
		case FSTATE_SPORT_PLUS:
		    SendCarFirmware(playerid, FSTATE_SPORT_PLUS);
		   
	}
	if(vInfo[i][vEnableNeon])
    {
		SetVehicleNeonForPlayer(playerid, GetPlayerVehicleID(playerid), vInfo[i][underlights_color], vInfo[i][underlights_color_lf], vInfo[i][underlights_color_rt]);
	}
	switch (vInfo[i][SelectedPnevmo]){
	        	case 1:
	        	  SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, 0.55);
	        	case 2:
	        	  SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, 0.35);
	        	case 3:
	        	  SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, 0.2);
	        }
	if (vInfo[i][percentofclirness] > 0 && vInfo[i][SelectedPnevmo] == 0){
		new suspension = max(vInfo[i][percentofclirness] / 50.0, 0.2);
        SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, suspension);
	}
	if (vInfo[i][percentofclirnessz] > 0){
		new suspension = min(max(vInfo[i][percentofclirnessz] / 100.0, 0.1), 0.9);
		
        SetVehicleSuspensionBiasFor(playerid, vehicleid, suspension);
	}

	
	if(vInfo[i][IsHydroActive]){
                SetVehicleHydraulics(vehicleid, 1, 0);
			}
    switch (vInfo[i][vNitro])
    {
        case 1:{
            printf("vNitro = 1 ? component 1008\n");
			SendCarFirmware(playerid, 1009);
            AddVehicleComponent(vehicleid, 1008);
        }
    
        case 2:{
			SendCarFirmware(playerid, 1008);
            printf("vNitro = 2 ? component 1009\n");
            AddVehicleComponent(vehicleid, 1009);
        }
    
        case 3:{
			SendCarFirmware(playerid, 1010);
            printf("vNitro = 3 ? component 1010\n");
            AddVehicleComponent(vehicleid, 1010);
        }
       
    }
	return 1;
}

stock engineon(playerid)
{
    printf("LOG ENGINES");

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == 0) return 1;

    if(!IsABike(vehicleid))
    {
        if(!IsPlayerDriver(playerid))
            return SendClientMessage(playerid, 0xCECECEFF, "Вы не за рулем");

        new engine = GetVehicleParam(vehicleid, V_ENGINE) ^ VEHICLE_PARAM_ON;
        SetVehicleParam(vehicleid, V_ENGINE, engine);
    }

    new i = GetVehicleData(vehicleid, V_ACTION_ID);
    if(i < 0) return 1; // защита от вылета

    if(vInfo[i][vHornSound] != 0)
        SetVehicleHornSound(vehicleid, vInfo[i][vHornSound], 1);

    if(vInfo[i][IsFarLightActive])
        SetVehicleFarLight(playerid, vehicleid, 1);

    if(vInfo[i][vExhaustSound] != 0)
        SetVehicleExhaust(vehicleid, vInfo[i][vExhaustSound] - 1, 1);

    switch(vInfo[i][vFstate])
    {
        case FSTATE_DRIFT:
            SetVehicleDriftForPlayer(playerid, vehicleid, 1);

        case FSTATE_COMFORT:
            SendCarFirmware(playerid, FSTATE_COMFORT);

        case FSTATE_SPORT:
            SendCarFirmware(playerid, FSTATE_SPORT);

        case FSTATE_SPORT_PLUS:
            SendCarFirmware(playerid, FSTATE_SPORT_PLUS);
    }

    if(vInfo[i][vEnableNeon])
    {
        SetVehicleNeonForPlayer(playerid, vehicleid,
            vInfo[i][underlights_color],
            vInfo[i][underlights_color_lf],
            vInfo[i][underlights_color_rt]);
    }

    switch(vInfo[i][SelectedPnevmo])
    {
        case 1: SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, 0.55);
        case 2: SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, 0.35);
        case 3: SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, 0.2);
    }

    if(vInfo[i][percentofclirness] > 0 && vInfo[i][SelectedPnevmo] == 0)
    {
        new Float:suspension = max(vInfo[i][percentofclirness] / 50.0, 0.2);
        SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, suspension);
    }

    if(vInfo[i][percentofclirnessz] > 0)
    {
        new Float:suspension = min(max(vInfo[i][percentofclirnessz] / 100.0, 0.1), 0.9);
        SetVehicleSuspensionBiasForPlayer(playerid, vehicleid, suspension);
    }

    if(vInfo[i][IsHydroActive])
        SetVehicleHydraulics(vehicleid, 1, 0);

    switch(vInfo[i][vNitro])
    {
        case 1:
        {
            printf("vNitro = 1 ? component 1008");
            SendCarFirmware(playerid, 1008);
        }
        case 2:
        {
            printf("vNitro = 2 ? component 1009");
            SendCarFirmware(playerid, 1009);
        }
        case 3:
        {
            printf("vNitro = 3 ? component 1010");
            SendCarFirmware(playerid, 1010);
        }
    }
    return 1;
}
stock lightss(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == 0) return 1;

    if(IsABike(vehicleid)) return 1;

    if(!IsPlayerDriver(playerid))
        return SendClientMessage(playerid, 0xCECECEFF, "Вы не за рулем");

    new lights = GetVehicleParam(vehicleid, V_LIGHTS) ^ VEHICLE_PARAM_ON;
    SetVehicleParam(vehicleid, V_LIGHTS, lights);
    SyncVehicleFrontLights(vehicleid);

    return 1;
}

