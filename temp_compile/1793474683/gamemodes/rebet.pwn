				//format(fmt_text, sizeof fmt_text, "Вы сконвертировали {ffff00}%d{FFFFFF} BC в {ffff00}%d{FFFFFF} рублей", money_amount, money_amount * donate_price);
				//ShowNotification(playerid, 3, fmt_text, 5, "", "");
