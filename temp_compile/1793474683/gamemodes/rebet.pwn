public Funchion3(playerid)
{
new fmt_text[75];
new itog;
new withdraw_money[32];
if(shetochkovferma<200)
{
shetochkovferma++;
 itog = shetochkovferma+1;// 1 можете заменить на любое количесво очков
  //      new withdraw_money[8];
//  format(fmt_text, sizeof fmt_text, "Очки %d ", itog);
       format(withdraw_money,32,"~r~%d",itog);
GameTextForPlayer(playerid, withdraw_money, 2000, 6);
                timerochkov = SetTimer("Funchion3", 15000, true);
                return 1;
        }
					else      if(shetochkovferma==200)
        {
        itog=0;
        shetochkovferma=0;
        SendMessageToTeam(GetPlayerData(playerid, P_FAMILY), "Битва за феру гарель закончилась", 0x33CC66FF);
        KillTimer(timerochkov);
        return 1;
}	
KillTimer(timerochkov);
return 1;
        }

#define PVZ_COUNT 9
new PVZ_EntranceArea[PVZ_COUNT];
new PVZ_ExitArea = -1;

new Float:PVZ_Entrance[PVZ_COUNT][3] =
{
    {1803.149047, 2037.017944, 16.008436},
    {292.996765, 1541.501220, 12.156729},
    {614.631835, 579.856567, 12.188437},
    {2566.409179, -2516.000488, 22.119831},
    {2386.718017, -1708.890747, 22.084220},
    {-528.563598, -1788.569946, 41.065799},
    {-2265.864746, -322.510284, 28.101448},
    {-2457.938476, 1134.409301, 10.855109},
    {-1824.447631, 2717.559814, 57.766563}
};

stock CreatePVZSystem()
{
    for(new i = 0; i < PVZ_COUNT; i++)
    {
        PVZ_EntranceArea[i] = CreateDynamicSphere(PVZ_Entrance[i][0], PVZ_Entrance[i][1], PVZ_Entrance[i][2], 1.5, 0, 0);
        CreatePickup(1274, 23, PVZ_Entrance[i][0], PVZ_Entrance[i][1], PVZ_Entrance[i][2], -1);
    }

    PVZ_ExitArea = CreateDynamicSphere(2282.679199, 1836.778442, 1519.743286, 1.5, 1, 1);
    CreatePickup(1274, 23, 2282.679199, 1836.778442, 1519.743286, 1);
    return 1;
}

stock CreateDPSPost(Float:x, Float:y, Float:z, Float:radius = 200.0)
{
    if(TotalDPSPosts >= MAX_DPS_POSTS) return -1;

    new id = TotalDPSPosts;

    DPSPosts[id][DPS_X] = x;
    DPSPosts[id][DPS_Y] = y;
    DPSPosts[id][DPS_Z] = z;

    // Создаём только зону
    DPSPosts[id][DPS_AREA_ID] = CreateDynamicSphere(x, y, z, radius);

    TotalDPSPosts++;
    printf("[DPS] Создан пост #%d", id);
    return id;
}

// Создание всех постов
public OnPlayerEnterDynamicArea(playerid, areaid)
{
    for(new pvz = 0; pvz < PVZ_COUNT; pvz++)
    {
        if(areaid == PVZ_EntranceArea[pvz])
        {
            SetPlayerInterior(playerid, 1);
            SetPlayerVirtualWorld(playerid, 1);
            SetPlayerPos(playerid, 2283.669921, 1836.158691, 1519.743286);
            SetPlayerFacingAngle(playerid, 0.0);
            SendClientMessage(playerid, 0x66CCFFFF, "PVZ: Welcome. Approach the counter to open your orders.");
            return 1;
        }
    }

    if(areaid == PVZ_ExitArea)
    {
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, 1803.149047, 2037.017944, 16.008436);
        SetPlayerFacingAngle(playerid, 0.0);
        SendClientMessage(playerid, 0x66CCFFFF, "PVZ: You left the pickup point.");
        return 1;
    }

    if(areaid == FamilyAreaID)
    {
        if(GetPlayerIdFamily(playerid) != -1)
            return ShowFamilyGui(playerid);
        if(GetPlayerMoneyEx(playerid) < 3000000)
            return SendClientMessage(playerid, -1, "\xc4\xeb\xff \xf1\xee\xe7\xe4\xe0\xed\xe8\xff \xf1\xe5\xec\xfc\xe8 \xed\xe5\xee\xe1\xf5\xee\xe4\xe8\xec\xee 3.000.000 \xf0\xf3\xe1\xeb\xe5\xe9.");
        Dialog(playerid, 2238, DIALOG_STYLE_INPUT, "{FF0000}\xd1\xee\xe7\xe4\xe0\xed\xe8\xe5 \xf1\xe5\xec\xfc\xe8",
            "{FFFFFF}\xc2\xe2\xe5\xe4\xe8\xf2\xe5 \xed\xe0\xe7\xe2\xe0\xed\xe8\xe5 \xf1\xe5\xec\xfc\xe8 \xee\xf2 6 \xe4\xee 31 \xf1\xe8\xec\xe2\xee\xeb\xe0.\n\xd1\xf2\xee\xe8\xec\xee\xf1\xf2\xfc: {32A44B}3.000.000 \xf0\xf3\xe1\xeb\xe5\xe9", "\xd1\xee\xe7\xe4\xe0\xf2\xfc", "\xc7\xe0\xea\xf0\xfb\xf2\xfc");
        return 1;
    }

	if(RublevkaGates_HandleArea(playerid, areaid)) return 1;


	if(IsMedBedArea(areaid))
	{
		ToggleInteractionWindow(playerid, true);
		return 1;
	}

  for(new i = 0; i < sizeof(HelpArea); i++)
    {
        if(areaid == HelpArea[i])
        {
            ToggleInteractionWindow(playerid, true);
            return 1;
        }
    }
    

    for(new i = 0; i < sizeof(MikhailArea); i++)
    {
        if(areaid == MikhailArea[i])
        {
            ToggleInteractionWindow(playerid, true);
            return 1;
        }
    }



	if(WeaponShop_OnPlayerEnterDynamicArea(playerid, areaid)) return 1;
	for(new idx; idx < sizeof(ATM_Areas); idx++)
	{
		if(areaid == ATM_Areas[idx])
		{
			ToggleInteractionWindow(playerid, true);
			return 1;
		}
	}

if(areaid == moto_salon_range_area)
{
	if(GetPlayerInBiz(playerid) == STATIC_BIZ_ID_MOTO_SALON && GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID)
	{
		DebugMotoSalonLog(playerid, "Area:MOTO_RANGE:enter");
		ToggleInteractionWindow(playerid, true);
	}
	return 1;
}
	for(new idx; idx < sizeof g_casino_area; idx++)
{
    if(areaid == g_casino_area[idx])
    {
        ToggleInteractionWindow(playerid, true);
        return 1;
    }
}
for(new idx; idx < MAX_BJ_LOBBY; idx++)
{
    if(areaid == BlackJackSphere[idx])
    {
        ToggleInteractionWindow(playerid, true);
        return 1;
    }
}
