public: RestorePlayerPromotions(playerid)
{
	g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY] = JSON_Array();

	for(new i = 0; i < g_player_donate_data[playerid][ADDED_PROMOTIONS]; i++)
	{
		g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY] = JSON_Append(g_player_donate_data[playerid][JSON_PROMOTIONS_ARRAY], JSON_Array(
			JSON_Int(g_player_added_promotions_data[playerid][i][0]),
			JSON_Int(g_player_added_promotions_data[playerid][i][1]),
			JSON_Int(g_player_added_promotions_data[playerid][i][2])
		));
	}
}

stock Inv11Trade_ResetOfferSlot(playerid, slot)
{
    if(slot < 1 || slot > INV11_TRADE_MAX_INV_SLOTS) return 0;

    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_USED] = 0;
    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_ITEM_ID] = 0;
    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT] = 0;
    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_VALUE] = 0;
    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_PLATE_TYPE] = 0;
    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_PLATE][0] = '\0';
    g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_REGION][0] = '\0';
    return 1;
}

stock Inv11Trade_ClearOffers(playerid)
{
    for(new slot = 1; slot <= INV11_TRADE_MAX_INV_SLOTS; slot++)
    {
        Inv11Trade_ResetOfferSlot(playerid, slot);
    }
    return 1;
}

stock Inv11Trade_ResetInvite(playerid)
{
    g_inv11_trade_invite_from[playerid] = -1;
    g_inv11_trade_invite_to[playerid] = -1;
    g_inv11_trade_invite_time[playerid] = 0;

    g_inv11_trade_dialog_count[playerid] = 0;
    for(new i = 0; i < INV11_TRADE_NEARBY_MAX; i++)
    {
        g_inv11_trade_dialog_target[playerid][i] = -1;
    }
    return 1;
}

stock Inv11Trade_ResetSession(playerid)
{
    g_inv11_trade_active[playerid] = false;
    g_inv11_trade_starting[playerid] = false;
    g_inv11_trade_apply[playerid] = false;
    g_inv11_trade_confirm[playerid] = false;
    g_inv11_trade_money[playerid] = 0;
    g_inv11_trade_partner[playerid] = -1;
    g_inv11_trade_started_at[playerid] = 0;
    Inv11Trade_ClearOffers(playerid);
    return 1;
}

stock Inv11Trade_ResetPlayer(playerid)
{
    Inv11Trade_ResetInvite(playerid);
    Inv11Trade_ResetSession(playerid);
    return 1;
}

stock bool:Inv11Trade_IsTradeItem(item_id)
{
    // The inventory GUI can contain regular items in addition to skins/SIM/accessories/plates.
    // The old trade filter rejected every ordinary item, so money could be offered but items could not.
    return (item_id > 0);
}

stock bool:Inv11Trade_IsStackableItem(item_id)
{
    if(item_id <= 0) return false;
    if(item_id == 58 || item_id == 134) return false;
    if(Inventory11_IsAccessoryItem(item_id)) return false;
    if(Inventory11_IsPlateItem(item_id)) return false;
    return true;
}

stock Float:Inv11Trade_GetDistance(playerid, targetid)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    return GetPlayerDistanceFromPoint(targetid, x, y, z);
}

stock bool:Inv11Trade_IsNear(playerid, targetid, Float:range = INV11_TRADE_NEAR_RANGE)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return false;
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerState(targetid) != PLAYER_STATE_ONFOOT) return false;
    return (Inv11Trade_GetDistance(playerid, targetid) <= range);
}

stock Inv11Trade_GetExchangeValue(item_id, model_id, amount, extra_1, extra_2, old_skin, sim_value, oldsim_value)
{
    if(item_id == 22)
    {
        return (amount > 0) ? amount : 1;
    }

    if(item_id == 58)
    {
        if(oldsim_value > 0) return oldsim_value;
        if(model_id > 0) return model_id;
        if(extra_1 > 0) return extra_1;
        if(sim_value > 0) return sim_value;
        if(extra_2 > 0) return extra_2;
        return 0;
    }

    if(item_id == 134)
    {
        if(old_skin > 0) return old_skin;
        if(model_id > 0) return model_id;
        return 0;
    }

    if(Inventory11_IsAccessoryItem(item_id))
    {
        if(extra_1 > 0) return extra_1;
        if(model_id > 1) return model_id;
        return Inv11_GetAccModelByItem(item_id);
    }

    return 1;
}

stock Inv11Trade_BuildPlateText(plate_type, plate[], region[], out_text[], out_size)
{
    new display_plate[16];
    FormatPlateByTypeForDisplay(plate_type, plate, display_plate, sizeof(display_plate));

    if(PlateTypeUsesRegion(plate_type) && strlen(region))
        format(out_text, out_size, "%s %s", display_plate, region);
    else
        format(out_text, out_size, "%s", display_plate);

    return 1;
}

stock bool:Inv11Trade_GetInventorySlotData(playerid, slot, &item_id, &model_id, &amount, &extra_1, &extra_2, &old_skin, &sim_value, &oldsim_value)
{
    item_id = 0;
    model_id = 0;
    amount = 0;
    extra_1 = 0;
    extra_2 = 0;
    old_skin = 0;
    sim_value = 0;
    oldsim_value = 0;

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[256];
    mysql_format(mysql, query, sizeof(query), "SELECT item_id, model_id, amount, extra_1, extra_2, old_skin, sim, oldsim FROM inventory WHERE account_id = %d AND slot = %d LIMIT 1", account_id, slot);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][TRADE][ERROR] GetInventorySlotData failed: player=%d slot=%d errno=%d query=%s", playerid, slot, mysql_errno(), query);
        cache_delete(result);
        return false;
    }

    if(cache_num_rows() <= 0)
    {
        cache_delete(result);
        return false;
    }

    item_id = cache_get_field_content_int(0, "item_id");
    model_id = cache_get_field_content_int(0, "model_id");
    amount = cache_get_field_content_int(0, "amount");
    extra_1 = cache_get_field_content_int(0, "extra_1");
    extra_2 = cache_get_field_content_int(0, "extra_2");
    old_skin = cache_get_field_content_int(0, "old_skin");
    sim_value = cache_get_field_content_int(0, "sim");
    oldsim_value = cache_get_field_content_int(0, "oldsim");

    cache_delete(result);
    return true;
}

stock bool:Inv11Trade_InventorySlotMatches(playerid, item_id, db_slot)
{
    if(db_slot < 1 || db_slot > INV11_TRADE_MAX_INV_SLOTS) return false;

    new db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim;
    if(!Inv11Trade_GetInventorySlotData(playerid, db_slot, db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim))
        return false;

    return (db_item == item_id);
}

stock Inv11Trade_ResolveInventoryDbSlot(playerid, item_id, raw_s, raw_os, raw_sl, &source_field)
{
    source_field = 0;
    new db_slot;

    // Some client builds send the source cell as os/sl, newer inventory packets use s.
    // GUI cell indexes are 0-based while the inventory table uses slots 1..40.
    if(raw_os >= 0)
    {
        db_slot = raw_os + 1;
        if(Inv11Trade_InventorySlotMatches(playerid, item_id, db_slot)) { source_field = 1; return db_slot; }
        if(Inv11Trade_InventorySlotMatches(playerid, item_id, raw_os)) { source_field = 1; return raw_os; }
    }

    if(raw_sl >= 0)
    {
        db_slot = raw_sl + 1;
        if(Inv11Trade_InventorySlotMatches(playerid, item_id, db_slot)) { source_field = 2; return db_slot; }
        if(Inv11Trade_InventorySlotMatches(playerid, item_id, raw_sl)) { source_field = 2; return raw_sl; }
    }

    if(raw_s >= 0)
    {
        db_slot = raw_s + 1;
        if(Inv11Trade_InventorySlotMatches(playerid, item_id, db_slot)) { source_field = 3; return db_slot; }
        if(Inv11Trade_InventorySlotMatches(playerid, item_id, raw_s)) { source_field = 3; return raw_s; }
    }

    return -1;
}

stock bool:Inv11Trade_OfferSlotMatches(playerid, item_id, slot)
{
    if(slot < 1 || slot > INV11_TRADE_MAX_INV_SLOTS) return false;
    if(!g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_USED]) return false;
    return (g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_ITEM_ID] == item_id);
}

stock Inv11Trade_ResolveOfferSlot(playerid, item_id, raw_s, raw_os, raw_sl, &source_field)
{
    source_field = 0;
    new slot;

    if(raw_os >= 0)
    {
        slot = raw_os + 1;
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, slot)) { source_field = 1; return slot; }
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, raw_os)) { source_field = 1; return raw_os; }
    }

    if(raw_sl >= 0)
    {
        slot = raw_sl + 1;
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, slot)) { source_field = 2; return slot; }
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, raw_sl)) { source_field = 2; return raw_sl; }
    }

    if(raw_s >= 0)
    {
        slot = raw_s + 1;
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, slot)) { source_field = 3; return slot; }
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, raw_s)) { source_field = 3; return raw_s; }
    }

    // Last-resort compatibility for clients that send only item id + count when
    // returning an item from exchange.
    for(slot = 1; slot <= INV11_TRADE_MAX_INV_SLOTS; slot++)
    {
        if(Inv11Trade_OfferSlotMatches(playerid, item_id, slot))
            return slot;
    }

    return -1;
}

stock Inv11Trade_SendStatus(playerid, status)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new Node:resp = JSON_Object();
    JSON_SetInt(resp, "t", 7);
    JSON_SetInt(resp, "s", status);
    OnPacketIncoming(playerid, 33, resp);
    JSON_Cleanup(resp);
    return 1;
}

stock Inv11Trade_SendBothApplied(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new Node:resp = JSON_Object();
    JSON_SetInt(resp, "t", 26);
    OnPacketIncoming(playerid, 33, resp);
    JSON_Cleanup(resp);
    return 1;
}

stock Inv11Trade_SendOpenExchange(playerid, targetid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return 0;

    new Node:resp = JSON_Object();
    JSON_SetInt(resp, "t", 17);
    JSON_SetString(resp, "en", GetPlayerNameEx(targetid));
    OnPacketIncoming(playerid, 33, resp);
    JSON_Cleanup(resp);
    return 1;
}

stock Inv11Trade_SendPartnerItem(playerid, packet_type, item_id, item_value, plate_text[])
{
    if(!IsPlayerConnected(playerid)) return 0;

    new Node:resp = JSON_Object();
    JSON_SetInt(resp, "t", packet_type);
    JSON_SetInt(resp, "ga", item_id);
    JSON_SetInt(resp, "s", item_value);
    if(strlen(plate_text))
    {
        JSON_SetString(resp, "nt", plate_text, strlen(plate_text));
    }
    OnPacketIncoming(playerid, 33, resp);
    JSON_Cleanup(resp);
    return 1;
}

stock Inv11Trade_SendPartnerMoney(playerid, money_value)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new Node:resp = JSON_Object();
    JSON_SetInt(resp, "t", 3);
    JSON_SetInt(resp, "gm", money_value);
    OnPacketIncoming(playerid, 33, resp);
    JSON_Cleanup(resp);
    return 1;
}

stock Inv11Trade_ResetApplyState(playerid, targetid)
{
    new had_apply = 0;
    if(g_inv11_trade_apply[playerid] || g_inv11_trade_apply[targetid] || g_inv11_trade_confirm[playerid] || g_inv11_trade_confirm[targetid])
    {
        had_apply = 1;
    }

    g_inv11_trade_apply[playerid] = false;
    g_inv11_trade_apply[targetid] = false;
    g_inv11_trade_confirm[playerid] = false;
    g_inv11_trade_confirm[targetid] = false;

    if(had_apply)
    {
        Inv11Trade_SendStatus(playerid, 2);
        Inv11Trade_SendStatus(targetid, 2);
    }
    return 1;
}

stock Inv11Trade_EndSession(playerid, targetid, status_player = 4, status_target = 4)
{
    if(IsPlayerConnected(playerid)) Inv11Trade_SendStatus(playerid, status_player);
    if(IsPlayerConnected(targetid)) Inv11Trade_SendStatus(targetid, status_target);

    Inv11Trade_ResetSession(playerid);
    Inv11Trade_ResetSession(targetid);
    return 1;
}

forward Inv11Trade_DelayedOpenExchange(playerid, targetid);
public Inv11Trade_DelayedOpenExchange(playerid, targetid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid))
    {
        if(IsPlayerConnected(playerid)) Inv11Trade_ResetSession(playerid);
        if(IsPlayerConnected(targetid)) Inv11Trade_ResetSession(targetid);
        return 1;
    }

    if(!g_inv11_trade_active[playerid] || !g_inv11_trade_active[targetid] ||
        g_inv11_trade_partner[playerid] != targetid || g_inv11_trade_partner[targetid] != playerid)
    {
        g_inv11_trade_starting[playerid] = false;
        g_inv11_trade_starting[targetid] = false;
        return 1;
    }

    // Inventory GUI needs a moment to finish opening on the client.
    // Sending t=17 in the same tick as ShowPlayerGUI makes some client builds
    // stay in the normal inventory instead of switching to exchange mode.
    Inv11Trade_SendOpenExchange(playerid, targetid);
    Inv11Trade_SendOpenExchange(targetid, playerid);

    g_inv11_trade_starting[playerid] = false;
    g_inv11_trade_starting[targetid] = false;

    printf("[INV11][TRADE] exchange gui opened: %d <-> %d", playerid, targetid);
    return 1;
}

stock bool:Inv11Trade_StartSession(playerid, targetid)
{
    if(!RequireThreeHoursForEconomy(playerid) || !RequireThreeHoursForEconomy(targetid)) return false;
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return false;
    if(g_inv11_trade_active[playerid] || g_inv11_trade_active[targetid]) return false;

    Inv11Trade_ResetSession(playerid);
    Inv11Trade_ResetSession(targetid);

    g_inv11_trade_invite_from[playerid] = -1;
    g_inv11_trade_invite_from[targetid] = -1;
    g_inv11_trade_invite_to[playerid] = -1;
    g_inv11_trade_invite_to[targetid] = -1;
    g_inv11_trade_invite_time[playerid] = 0;
    g_inv11_trade_invite_time[targetid] = 0;

    // Mark the session before refreshing GUI. The old inventory instance can
    // send t=16/t=7 while it is being replaced; starting=true makes us ignore it.
    g_inv11_trade_active[playerid] = true;
    g_inv11_trade_active[targetid] = true;
    g_inv11_trade_partner[playerid] = targetid;
    g_inv11_trade_partner[targetid] = playerid;
    g_inv11_trade_started_at[playerid] = gettime();
    g_inv11_trade_started_at[targetid] = g_inv11_trade_started_at[playerid];
    g_inv11_trade_starting[playerid] = true;
    g_inv11_trade_starting[targetid] = true;

    Inventory11(playerid);
    Inventory11(targetid);

    // Do NOT send t=17 immediately after Inventory11(). On the mobile client
    // the fragment is still being created and that packet is lost.
    SetTimerEx("Inv11Trade_DelayedOpenExchange", 250, false, "ii", playerid, targetid);

    printf("[INV11][TRADE] session starting: %d <-> %d start_ts=%d", playerid, targetid, g_inv11_trade_started_at[playerid]);
    return true;
}

forward CarPass_HandleNotifyClick(playerid, notify_type, notify_id, notify_sub_id);

stock CarPass_ResetInvite(playerid)
{
    g_carpass_invite_from[playerid] = -1;
    g_carpass_invite_time[playerid] = 0;
    return 1;
}

stock BuildCarPassDialogText(ownerid, dialog_text[], size)
{
    new vehicleid = GetPlayerOwnableCar(ownerid);
    if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid)) return 0;

    new index = GetVehicleData(vehicleid, V_ACTION_ID);
    new model_id = GetVehicleModel(vehicleid);
    if(index < 0 || model_id < 400) return 0;

    new firmware_name[16], nitro_name[24], number_text[32], pdv_text[24], antiradar_text[24], own_number[32], dlg_line[256];
    new year, month, day;

    own_number[0] = EOS;
    dialog_text[0] = EOS;

    format(own_number, sizeof own_number, "%s", GetOwnableCarData(index, OC_NUMBER));

    switch(vInfo[index][vFstate])
    {
        case FSTATE_DRIFT: format(firmware_name, sizeof firmware_name, "Drift");
        case FSTATE_COMFORT: format(firmware_name, sizeof firmware_name, "Comfort");
        case FSTATE_SPORT: format(firmware_name, sizeof firmware_name, "Sport");
        case FSTATE_SPORT_PLUS: format(firmware_name, sizeof firmware_name, "Sport+");
        default: format(firmware_name, sizeof firmware_name, "Стандарт");
    }

    switch(vInfo[index][vNitro])
    {
        case 1: format(nitro_name, sizeof nitro_name, "x2");
        case 2: format(nitro_name, sizeof nitro_name, "x5");
        case 3: format(nitro_name, sizeof nitro_name, "x10");
        default: format(nitro_name, sizeof nitro_name, "не установлено");
    }

    if(strlen(own_number)) format(number_text, sizeof number_text, "%s", own_number);
    else format(number_text, sizeof number_text, "не установлен");

    format(pdv_text, sizeof pdv_text, ((GetOwnableCarData(index, OC_PDVRADAR) & 1) != 0) ? ("установлено") : ("не установлено"));
    format(antiradar_text, sizeof antiradar_text, ((GetOwnableCarData(index, OC_PDVRADAR) & 2) != 0) ? ("установлено") : ("не установлено"));
    getdate(year, month, day);

    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Владелец:\t\t{FFFF00}%s\n", GetPlayerNameEx(ownerid));
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Транспорт:\t{FFFF00}%s [%d]\n", GetVehicleName(vehicleid), vehicleid);
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Номер:\t\t{FFFF00}%s\n", number_text);
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Пробег:\t\t{FFFF00}%04d км.\n", floatround(GetVehicleData(vehicleid, V_MILEAGE), floatround_ceil));
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Гос. стоимость:\t{FFFF00}%d руб.\n", GetVehicleInfo(model_id - 400, VI_PRICE));
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Прошивка:\t{FFFF00}%s\n", firmware_name);
    strcat(dialog_text, dlg_line, size);
    strcat(dialog_text, "{FFFFFF}Тип топлива:\t{FFFF00}98\n", size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Нитро:\t\t{FFFF00}%s\n", nitro_name);
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}ПДВ:\t\t{FFFF00}%s\n", pdv_text);
    strcat(dialog_text, dlg_line, size);
    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Антирадар:\t{FFFF00}%s\n\n", antiradar_text);
    strcat(dialog_text, dlg_line, size);

    strcat(dialog_text, "{FFFFFF}Диагностика:\n", size);
    strcat(dialog_text, "{FFFFFF}Износ двигателя:        {FFFF00}0 из 10000\n", size);
    strcat(dialog_text, "{FFFFFF}Износ воздушного фильтра:        {FFFF00}0 из 3000\n", size);
    strcat(dialog_text, "{FFFFFF}Износ топливной системы:        {FFFF00}0 из 10000\n", size);
    strcat(dialog_text, "{FFFFFF}Износ трансмиссии:        {FFFF00}0 из 10000\n", size);
    strcat(dialog_text, "{FFFFFF}Износ подвески автомобиля:        {FFFF00}0 из 12400\n", size);
    strcat(dialog_text, "{FFFFFF}Износ свечей зажигания:        {FFFF00}0 из 7000\n", size);
    strcat(dialog_text, "{FFFFFF}Износ аккумулятора:        {FFFF00}0 из 100\n", size);

    format(dlg_line, sizeof(dlg_line), "{FFFFFF}Выполнена:        {FFFF00}%04d.%d.%d", year, month, day);
    strcat(dialog_text, dlg_line, size);
    return 1;
}


stock CarPass_HandleNotifyClick(playerid, notify_type, notify_id, notify_sub_id)
{
    new inviter = g_carpass_invite_from[playerid];
    if(inviter == -1) return 0;
    if(inviter != notify_id && inviter != notify_sub_id) return 0;
    if(notify_type != 0) return 1;

    if(!IsPlayerConnected(inviter) || !IsPlayerLogged(inviter))
    {
        CarPass_ResetInvite(playerid);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок недоступен", " ");
        return 1;
    }

    if(gettime() - g_carpass_invite_time[playerid] > CARPASS_INVITE_TIMEOUT)
    {
        CarPass_ResetInvite(playerid);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Предложение устарело", " ");
        return 1;
    }

    if(!IsPlayerInRangeOfPlayer(playerid, inviter, CARPASS_INVITE_RANGE))
    {
        CarPass_ResetInvite(playerid);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок находится слишком далеко", " ");
        return 1;
    }

    new dialog_text[2048];
    if(!BuildCarPassDialogText(inviter, dialog_text, sizeof dialog_text))
    {
        CarPass_ResetInvite(playerid);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "У игрока нет загруженного личного транспорта", " ");
        return 1;
    }

    new action_text[96];
    format(action_text, sizeof action_text, "%s показал свой тех.паспорт", GetPlayerNameEx(inviter));
    Action(inviter, action_text, _, false);
    ShowPlayerDialog(playerid, DIALOG_CARPASS_VIEW, DIALOG_STYLE_TABLIST_HEADERS, "{FF8C00}Тех. паспорт", dialog_text, "Закрыть", "");
    CarPass_ResetInvite(playerid);
    return 1;
}


stock bool:Inv11Trade_OpenNearbyDialog(playerid)
{
    if(g_inv11_trade_active[playerid])
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Вы уже участвуете в трейде", " ");
        return false;
    }

    g_inv11_trade_dialog_count[playerid] = 0;
    for(new i = 0; i < INV11_TRADE_NEARBY_MAX; i++)
    {
        g_inv11_trade_dialog_target[playerid][i] = -1;
    }

    new list_text[4096];
    list_text[0] = '\0';

    new count = 0;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(i == playerid) continue;
        if(!IsPlayerConnected(i) || !IsPlayerLogged(i)) continue;
        if(g_inv11_trade_active[i]) continue;

        new Float:dist = Inv11Trade_GetDistance(playerid, i);
        if(dist > INV11_TRADE_NEAR_RANGE) continue;

        if(count >= INV11_TRADE_NEARBY_MAX) break;

        g_inv11_trade_dialog_target[playerid][count] = i;

        new line_text[128];
        format(line_text, sizeof(line_text), "%d. %s[%d] - %.6f метров\n", count + 1, GetPlayerNameEx(i), i, dist);
        strcat(list_text, line_text, sizeof(list_text));

        count++;
    }

    g_inv11_trade_dialog_count[playerid] = count;

    if(count <= 0)
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Подходящих игроков для трейда поблизости - нет.", " ");
        return false;
    }

    ShowPlayerDialog(playerid, DIALOG_INV11_TRADE_SELECT, DIALOG_STYLE_LIST, "{FF0000}Трейд", list_text, "Далее", "Выйти");
    return true;
}

stock bool:Inv11Trade_HandleNotifyClick(playerid, notify_id, notify_sub_id)
{
    new inviter = g_inv11_trade_invite_from[playerid];
    if(inviter == -1) return false;

    if(inviter != notify_id && inviter != notify_sub_id) return false;

    if(!IsPlayerConnected(inviter) || !IsPlayerLogged(inviter))
    {
        Inv11Trade_ResetInvite(playerid);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок недоступен", " ");
        return true;
    }

    if(gettime() - g_inv11_trade_invite_time[playerid] > INV11_TRADE_INVITE_TIMEOUT)
    {
        Inv11Trade_ResetInvite(playerid);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Предложение трейда устарело", " ");
        return true;
    }

    new dialog_text[144];
    format(dialog_text, sizeof(dialog_text), "Игрок %s предлагает Вам трейд, Вы согласны?", GetPlayerNameEx(inviter));
    ShowPlayerDialog(playerid, DIALOG_INV11_TRADE_CONFIRM, DIALOG_STYLE_MSGBOX, "{FF0000}Трейд", dialog_text, "Далее", "Отмена");
    return true;
}

stock bool:Inv11Trade_MoveInvToExchange(playerid, item_id, slot, req_value, response)
{
    JSON_SetInt(response, "t", 5);
    JSON_SetInt(response, "w", Inventory11_GetCurrentWeightKg(playerid));

    if(!g_inv11_trade_active[playerid])
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    new targetid = g_inv11_trade_partner[playerid];
    if(targetid == -1 || !IsPlayerConnected(targetid))
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    if(slot < 1 || slot > INV11_TRADE_MAX_INV_SLOTS)
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    new db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim;
    if(!Inv11Trade_GetInventorySlotData(playerid, slot, db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim))
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    if(db_item != item_id || !Inv11Trade_IsTradeItem(db_item))
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    if(db_amount <= 0) db_amount = 1;

    new offer_used = g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_USED];
    new send_value = 1;
    new partner_plate_text[32];
    partner_plate_text[0] = '\0';

    if(Inv11Trade_IsStackableItem(db_item))
    {
        new offered = g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT];
        new available = db_amount - offered;
        if(available <= 0)
        {
            JSON_SetInt(response, "s", 0);
            return false;
        }

        new move_amount = req_value;
        if(move_amount <= 0) move_amount = 1;
        if(move_amount > available) move_amount = available;
        if(move_amount <= 0)
        {
            JSON_SetInt(response, "s", 0);
            return false;
        }

        if(!offer_used)
        {
            g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_USED] = 1;
            g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_ITEM_ID] = db_item;
            g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_VALUE] = db_model;
        }

        g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT] = offered + move_amount;
        send_value = move_amount;
    }
    else
    {
        if(offer_used)
        {
            JSON_SetInt(response, "s", 0);
            return false;
        }

        new offer_value = Inv11Trade_GetExchangeValue(db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim);
        if((db_item == 58 || db_item == 134) && offer_value <= 0)
        {
            JSON_SetInt(response, "s", 0);
            return false;
        }

        g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_USED] = 1;
        g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_ITEM_ID] = db_item;
        g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT] = 1;
        g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_VALUE] = offer_value;

        if(Inventory11_IsPlateItem(db_item))
        {
            new plate_type = PlateCountryToType(PlateItemIdToCountry(db_item));
            new plate[16], region[8];
            if(Inventory11_GetPlateData(playerid, slot, plate_type, plate, sizeof(plate), region, sizeof(region)))
            {
                g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_PLATE_TYPE] = plate_type;
                format(g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_PLATE], 16, "%s", plate);
                format(g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_REGION], 8, "%s", region);
                Inv11Trade_BuildPlateText(plate_type, plate, region, partner_plate_text, sizeof(partner_plate_text));
            }
            send_value = 1;
        }
        else if(db_item == 58 || db_item == 134)
        {
            send_value = offer_value;
        }
        else
        {
            send_value = 1;
        }
    }

    JSON_SetInt(response, "s", 1);

    Inv11Trade_SendPartnerItem(targetid, 0, db_item, send_value, partner_plate_text);
    Inv11Trade_ResetApplyState(playerid, targetid);

    printf("[INV11][TRADE] inv->exchange: player=%d target=%d db_slot=%d item=%d val=%d", playerid, targetid, slot, db_item, send_value);
    return true;
}

stock bool:Inv11Trade_MoveExchangeToInv(playerid, item_id, slot, req_value, response)
{
    JSON_SetInt(response, "t", 24);
    JSON_SetInt(response, "w", Inventory11_GetCurrentWeightKg(playerid));

    if(!g_inv11_trade_active[playerid])
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    new targetid = g_inv11_trade_partner[playerid];
    if(targetid == -1 || !IsPlayerConnected(targetid))
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    if(slot < 1 || slot > INV11_TRADE_MAX_INV_SLOTS)
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    if(!g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_USED])
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    if(g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_ITEM_ID] != item_id)
    {
        JSON_SetInt(response, "s", 0);
        return false;
    }

    new send_value = 1;
    new plate_text[32];
    plate_text[0] = '\0';

    if(Inv11Trade_IsStackableItem(item_id))
    {
        new offered = g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT];
        new move_amount = req_value;
        if(move_amount <= 0) move_amount = 1;
        if(move_amount > offered) move_amount = offered;
        if(move_amount <= 0)
        {
            JSON_SetInt(response, "s", 0);
            return false;
        }

        g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT] = offered - move_amount;
        if(g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_AMOUNT] <= 0)
        {
            Inv11Trade_ResetOfferSlot(playerid, slot);
        }

        send_value = move_amount;
    }
    else
    {
        if(item_id == 58 || item_id == 134)
        {
            send_value = g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_VALUE];
        }
        else
        {
            send_value = 1;
        }

        if(Inventory11_IsPlateItem(item_id))
        {
            new plate_type = g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_PLATE_TYPE];
            Inv11Trade_BuildPlateText(plate_type, g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_PLATE], g_inv11_trade_offer[playerid][slot][INV11_TRADE_OFFER_REGION], plate_text, sizeof(plate_text));
        }

        Inv11Trade_ResetOfferSlot(playerid, slot);
    }

    JSON_SetInt(response, "s", 1);

    Inv11Trade_SendPartnerItem(targetid, 1, item_id, send_value, plate_text);
    Inv11Trade_ResetApplyState(playerid, targetid);

    printf("[INV11][TRADE] exchange->inv: player=%d target=%d db_slot=%d item=%d val=%d", playerid, targetid, slot, item_id, send_value);
    return true;
}

stock bool:Inv11Trade_TransferDirection(fromid, toid)
{
    new account_id = GetPlayerAccountID(fromid);
    if(account_id <= 0) return false;

    for(new slot = 1; slot <= INV11_TRADE_MAX_INV_SLOTS; slot++)
    {
        if(!g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_USED]) continue;

        new item_id = g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_ITEM_ID];
        new offer_amount = g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_AMOUNT];
        new offer_value = g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_VALUE];
        if(offer_amount <= 0) offer_amount = 1;

        new db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim;
        if(!Inv11Trade_GetInventorySlotData(fromid, slot, db_item, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim))
        {
            printf("[INV11][TRADE][ERROR] TransferDirection slot missing: player=%d slot=%d", fromid, slot);
            return false;
        }

        if(db_item != item_id)
        {
            printf("[INV11][TRADE][ERROR] TransferDirection mismatch: player=%d slot=%d db_item=%d offer_item=%d", fromid, slot, db_item, item_id);
            return false;
        }

        if(Inv11Trade_IsStackableItem(item_id))
        {
            if(db_amount <= 0) db_amount = 1;
            if(db_amount < offer_amount)
            {
                printf("[INV11][TRADE][ERROR] TransferDirection stack amount mismatch: player=%d slot=%d item=%d db=%d offer=%d", fromid, slot, item_id, db_amount, offer_amount);
                return false;
            }

            if(db_amount == offer_amount)
            {
                if(!Inventory11_DeleteSlotFromDatabase(fromid, slot))
                {
                    return false;
                }
            }
            else
            {
                new left_amount = db_amount - offer_amount;
                new query[224];
                if(item_id == 22)
                    mysql_format(mysql, query, sizeof(query), "UPDATE inventory SET amount = %d, model_id = %d WHERE account_id = %d AND slot = %d AND item_id = %d LIMIT 1", left_amount, left_amount, account_id, slot, item_id);
                else
                    mysql_format(mysql, query, sizeof(query), "UPDATE inventory SET amount = %d WHERE account_id = %d AND slot = %d AND item_id = %d LIMIT 1", left_amount, account_id, slot, item_id);

                mysql_query(mysql, query, true);
                if(mysql_errno())
                {
                    printf("[INV11][TRADE][ERROR] TransferDirection stack update failed: player=%d slot=%d item=%d errno=%d query=%s", fromid, slot, item_id, mysql_errno(), query);
                    return false;
                }
            }

            new add_stack_slot;
            if(item_id == 22)
                add_stack_slot = Inventory11_AddItemToDatabase(toid, 22, offer_amount, offer_amount, 0, 0);
            else
                add_stack_slot = Inventory11_AddItemToDatabase(toid, item_id, db_model, offer_amount, db_extra_1, db_extra_2);

            if(add_stack_slot == -1)
            {
                printf("[INV11][TRADE][ERROR] TransferDirection add stack failed: from=%d to=%d item=%d amount=%d", fromid, toid, item_id, offer_amount);
                return false;
            }
            continue;
        }

        if(!Inventory11_DeleteSlotFromDatabase(fromid, slot))
        {
            return false;
        }

        new add_slot = -1;
        if(item_id == 58)
        {
            if(offer_value <= 0) offer_value = Inv11Trade_GetExchangeValue(item_id, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim);
            add_slot = Inventory11_AddItemToDatabase(toid, 58, 1, 1, offer_value, 0);
        }
					else if(item_id == 134)
        {
            if(offer_value <= 0) offer_value = Inv11Trade_GetExchangeValue(item_id, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim);
            add_slot = Inventory11_AddItemToDatabase(toid, 134, offer_value, 1, 0, 0);
        }
					else if(Inventory11_IsAccessoryItem(item_id))
        {
            if(offer_value <= 0) offer_value = Inv11Trade_GetExchangeValue(item_id, db_model, db_amount, db_extra_1, db_extra_2, db_old_skin, db_sim, db_oldsim);
            add_slot = Inventory11_AddItemToDatabase(toid, item_id, 1, 1, offer_value, 0);
        }
					else if(Inventory11_IsPlateItem(item_id))
        {
            new plate_type = g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_PLATE_TYPE];
            if(plate_type <= 0)
            {
                plate_type = PlateCountryToType(PlateItemIdToCountry(item_id));
            }

            add_slot = Inventory11_AddItemToDatabase(toid, item_id, PlateItemIdToModel(item_id), 1, 0, 0);
            if(add_slot != -1)
            {
                if(!Inventory11_SavePlateData(toid, add_slot, plate_type, g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_PLATE], g_inv11_trade_offer[fromid][slot][INV11_TRADE_OFFER_REGION]))
                {
                    printf("[INV11][TRADE][ERROR] TransferDirection save plate failed: from=%d to=%d slot=%d", fromid, toid, add_slot);
                    return false;
                }
            }
        }
					else
        {
            add_slot = Inventory11_AddItemToDatabase(toid, item_id, db_model, 1, db_extra_1, db_extra_2);
        }

        if(add_slot == -1)
        {
            printf("[INV11][TRADE][ERROR] TransferDirection add item failed: from=%d to=%d item=%d", fromid, toid, item_id);
            return false;
        }
    }

    return true;
}

stock bool:Inv11Trade_Finalize(playerid, targetid)
{
    new money_player = g_inv11_trade_money[playerid];
    new money_target = g_inv11_trade_money[targetid];

    if(money_player < 0) money_player = 0;
    if(money_target < 0) money_target = 0;

    if(GetPlayerMoneyEx(playerid) < money_player || GetPlayerMoneyEx(targetid) < money_target)
    {
        printf("[INV11][TRADE][ERROR] Finalize not enough money: p=%d(%d/%d) t=%d(%d/%d)", playerid, GetPlayerMoneyEx(playerid), money_player, targetid, GetPlayerMoneyEx(targetid), money_target);
        return false;
    }

    if(!Inv11Trade_TransferDirection(playerid, targetid)) return false;
    if(!Inv11Trade_TransferDirection(targetid, playerid)) return false;

    if(money_player > 0)
    {
        GivePlayerMoneyEx(playerid, -money_player, "Трейд", true, true);
        GivePlayerMoneyEx(targetid, money_player, "Трейд", true, true);
    }

    if(money_target > 0)
    {
        GivePlayerMoneyEx(targetid, -money_target, "Трейд", true, true);
        GivePlayerMoneyEx(playerid, money_target, "Трейд", true, true);
    }

    return true;
}

stock Inv11Trade_OnDisconnect(playerid)
{
    new partner = g_inv11_trade_partner[playerid];
    if(partner != -1 && g_inv11_trade_active[playerid])
    {
        if(IsPlayerConnected(partner))
        {
            Inv11Trade_SendStatus(partner, 4);
            ShowNotificationLaird(partner, 2, 6, 0, 0, "Игрок вышел из трейда", " ");
            Inv11Trade_ResetSession(partner);
        }
    }

    new invite_to = g_inv11_trade_invite_to[playerid];
    if(invite_to != -1 && IsPlayerConnected(invite_to) && g_inv11_trade_invite_from[invite_to] == playerid)
    {
        g_inv11_trade_invite_from[invite_to] = -1;
        g_inv11_trade_invite_time[invite_to] = 0;
    }

    new invite_from = g_inv11_trade_invite_from[playerid];
    if(invite_from != -1 && IsPlayerConnected(invite_from) && g_inv11_trade_invite_to[invite_from] == playerid)
    {
        g_inv11_trade_invite_to[invite_from] = -1;
    }

    Inv11Trade_ResetPlayer(playerid);
    return 1;
}

stock bool:Inv11Trade_HandlePacket(playerid, json, response, &refresh_inventory_after_response, &send_response)
{
    new type = -1;
    JSON_GetInt(json, "t", type);

    if(type != 5 && type != 6 && type != 7 && type != 8 && type != 9 && type != 16 && type != 24 && type != 25 && type != 27 && type != 31)
    {
        return false;
    }

    new targetid = g_inv11_trade_partner[playerid];

    switch(type)
    {
        case 25:
        {
            new ok = Inv11Trade_OpenNearbyDialog(playerid);
            JSON_SetInt(response, "t", 25);
            JSON_SetInt(response, "s", ok ? 1 : 0);
            return true;
        }

        case 31:
        {
            if(!g_inv11_trade_active[playerid] || targetid == -1 || !IsPlayerConnected(targetid))
            {
                send_response = 0;
                return true;
            }

            new tx[144];
            JSON_GetString(json, "tx", tx, sizeof(tx));
            if(!strlen(tx))
            {
                send_response = 0;
                return true;
            }

            new text[192];
            format(text, sizeof(text), "%s: %s", GetPlayerNameEx(playerid), tx);

            new Node:packet = JSON_Object();
            JSON_SetInt(packet, "t", 31);
            JSON_SetString(packet, "tx", text);
            OnPacketIncoming(playerid, 33, packet);
            OnPacketIncoming(targetid, 33, packet);
            JSON_Cleanup(packet);

            send_response = 0;
            return true;
        }

        case 16:
        {
            if(g_inv11_trade_starting[playerid])
            {
                printf("[INV11][TRADE] ignore close packet t=16 while starting: player=%d", playerid);
                send_response = 0;
                return true;
            }

            if(g_inv11_trade_active[playerid] && targetid != -1)
            {
                new started_at = g_inv11_trade_started_at[playerid];
                new since_start = (started_at > 0) ? (gettime() - started_at) : 9999;
                if(started_at > 0 && since_start <= INV11_TRADE_CLOSE_GRACE)
                {
                    printf("[INV11][TRADE] ignore close packet t=16 in grace: player=%d target=%d since=%d", playerid, targetid, since_start);
                    send_response = 0;
                    return true;
                }

                printf("[INV11][TRADE] close packet t=16 end session: player=%d target=%d", playerid, targetid);
                Inv11Trade_EndSession(playerid, targetid, 4, 4);
                send_response = 0;
                return true;
            }

            if(g_inv11_trade_active[playerid])
            {
                printf("[INV11][TRADE] close packet t=16 with invalid partner, reset session: player=%d target=%d", playerid, targetid);
                Inv11Trade_ResetSession(playerid);
                send_response = 0;
                return true;
            }

            JSON_SetInt(response, "t", 16);
            JSON_SetInt(response, "s", 1);
            return true;
        }

        case 7:
        {
            if(g_inv11_trade_starting[playerid])
            {
                printf("[INV11][TRADE] ignore close packet t=7 while starting: player=%d", playerid);
                send_response = 0;
                return true;
            }

            if(g_inv11_trade_active[playerid] && targetid != -1)
            {
                new started_at = g_inv11_trade_started_at[playerid];
                new since_start = (started_at > 0) ? (gettime() - started_at) : 9999;
                if(started_at > 0 && since_start <= INV11_TRADE_CLOSE_GRACE)
                {
                    printf("[INV11][TRADE] ignore close packet t=7 in grace: player=%d target=%d since=%d", playerid, targetid, since_start);
                    send_response = 0;
                    return true;
                }

                printf("[INV11][TRADE] close packet t=7 end session: player=%d target=%d", playerid, targetid);
                ShowNotificationLaird(playerid, 2, 6, 0, 0, "Вы отменили обмен", " ");
                if(IsPlayerConnected(targetid))
                {
                    ShowNotificationLaird(targetid, 2, 6, 0, 0, "Игрок отменил обмен", " ");
                }
                Inv11Trade_EndSession(playerid, targetid, 4, 4);
                send_response = 0;
                return true;
            }

            if(g_inv11_trade_active[playerid])
            {
                printf("[INV11][TRADE] close packet t=7 with invalid partner, reset session: player=%d target=%d", playerid, targetid);
                Inv11Trade_ResetSession(playerid);
                send_response = 0;
                return true;
            }

            JSON_SetInt(response, "t", 7);
            JSON_SetInt(response, "s", 4);
            return true;
        }

        case 6:
        {
            JSON_SetInt(response, "t", 6);

            if(!g_inv11_trade_active[playerid] || targetid == -1 || !IsPlayerConnected(targetid))
            {
                JSON_SetInt(response, "s", 0);
                return true;
            }

            new money_offer = 0;
            JSON_GetInt(json, "em", money_offer);
            if(money_offer < 0) money_offer = 0;

            if(money_offer > INV11_TRADE_MAX_MONEY || money_offer > GetPlayerMoneyEx(playerid))
            {
                JSON_SetInt(response, "s", 0);
                return true;
            }

            if(g_inv11_trade_money[playerid] != money_offer)
            {
                g_inv11_trade_money[playerid] = money_offer;
                Inv11Trade_ResetApplyState(playerid, targetid);
            }

            Inv11Trade_SendPartnerMoney(targetid, money_offer);
            JSON_SetInt(response, "s", 1);
            return true;
        }

        case 5:
        {
            new item_id = 0;
            new raw_s = -1, raw_os = -1, raw_sl = -1, raw_i = 0, raw_a = 0;
            JSON_GetInt(json, "ga", item_id);
            JSON_GetInt(json, "s", raw_s);
            JSON_GetInt(json, "os", raw_os);
            JSON_GetInt(json, "sl", raw_sl);
            JSON_GetInt(json, "i", raw_i);
            JSON_GetInt(json, "a", raw_a);

            new slot_source = 0;
            new slot = Inv11Trade_ResolveInventoryDbSlot(playerid, item_id, raw_s, raw_os, raw_sl, slot_source);

            new req_value = raw_i;
            if(req_value <= 0) req_value = raw_a;
            // Compatibility with the previous packet layout: os/sl = slot, s = amount.
            if(req_value <= 0 && slot_source != 3 && raw_s > 0) req_value = raw_s;
            if(req_value <= 0) req_value = 1;

            printf("[INV11][TRADE] t=5 request: player=%d item=%d raw_s=%d raw_os=%d raw_sl=%d raw_i=%d -> db_slot=%d amount=%d src=%d", playerid, item_id, raw_s, raw_os, raw_sl, raw_i, slot, req_value, slot_source);
            Inv11Trade_MoveInvToExchange(playerid, item_id, slot, req_value, response);
            return true;
        }

        case 24:
        {
            new item_id = 0;
            new raw_s = -1, raw_os = -1, raw_sl = -1, raw_i = 0, raw_a = 0;
            JSON_GetInt(json, "ga", item_id);
            JSON_GetInt(json, "s", raw_s);
            JSON_GetInt(json, "os", raw_os);
            JSON_GetInt(json, "sl", raw_sl);
            JSON_GetInt(json, "i", raw_i);
            JSON_GetInt(json, "a", raw_a);

            new slot_source = 0;
            new slot = Inv11Trade_ResolveOfferSlot(playerid, item_id, raw_s, raw_os, raw_sl, slot_source);

            new req_value = raw_i;
            if(req_value <= 0) req_value = raw_a;
            if(req_value <= 0 && slot_source != 3 && raw_s > 0) req_value = raw_s;
            if(req_value <= 0) req_value = 1;

            printf("[INV11][TRADE] t=24 request: player=%d item=%d raw_s=%d raw_os=%d raw_sl=%d raw_i=%d -> offer_slot=%d amount=%d src=%d", playerid, item_id, raw_s, raw_os, raw_sl, raw_i, slot, req_value, slot_source);
            Inv11Trade_MoveExchangeToInv(playerid, item_id, slot, req_value, response);
            return true;
        }

        case 27:
        {
            JSON_SetInt(response, "t", 27);

            if(!g_inv11_trade_active[playerid] || targetid == -1 || !IsPlayerConnected(targetid))
            {
                JSON_SetInt(response, "s", 0);
                return true;
            }

            new item_id = 0, old_pos = -1, pos = -1;
            JSON_GetInt(json, "ga", item_id);
            JSON_GetInt(json, "os", old_pos);
            JSON_GetInt(json, "s", pos);
        if(old_pos == 0) old_pos = 1;
        if(pos == 0) pos = 1;

            new bool:db_ok = false;
            new active_model = 0;
            new bool:is_active_acc_move = (Inventory11_IsAccessoryItem(item_id) && Inventory11_IsActiveAccessorySlot(playerid, old_pos, item_id));

            if(is_active_acc_move)
            {
                db_ok = Inventory11_MoveActiveAccessoryToInventorySlot(playerid, item_id, old_pos, pos, active_model);
                if(db_ok)
                {
                    Inventory11_SetAiArrayOnJson(playerid, response);
                    refresh_inventory_after_response = 1;
                }
            }
					else
            {
                db_ok = Inventory11_SwapSlotsInDatabase(playerid, old_pos, pos);
            }

            JSON_SetInt(response, "s", db_ok ? 1 : 0);
            JSON_SetInt(response, "nw", Inventory11_GetMaxWeightKg(playerid));
            JSON_SetInt(response, "ns", Inventory11_GetMaxSlots(playerid));
            JSON_SetInt(response, "v", Inventory11_GetVipForGui(playerid));

            if(db_ok)
            {
                Inv11Trade_ResetApplyState(playerid, targetid);
            }

            return true;
        }

        case 8:
        {
            JSON_SetInt(response, "t", 8);

            if(!g_inv11_trade_active[playerid] || targetid == -1 || !IsPlayerConnected(targetid))
            {
                JSON_SetInt(response, "s", 0);
                return true;
            }

            g_inv11_trade_apply[playerid] = true;
            g_inv11_trade_confirm[playerid] = false;
            JSON_SetInt(response, "s", 1);

            if(g_inv11_trade_apply[targetid])
            {
                JSON_SetInt(response, "t", 26);
                Inv11Trade_SendBothApplied(targetid);
                ShowNotificationLaird(targetid, 3, 6, 0, 0, "Теперь нужно нажать кнопку Подтвердить", " ");
            }
					else
            {
                ShowNotificationLaird(playerid, 3, 6, 0, 0, "Вам нужно подождать пока другой игрок подтвердит трейд", " ");
            }

            return true;
        }

        case 9:
        {
            JSON_SetInt(response, "t", 9);

            if(!g_inv11_trade_active[playerid] || targetid == -1 || !IsPlayerConnected(targetid) || !g_inv11_trade_apply[playerid] || !g_inv11_trade_apply[targetid])
            {
                JSON_SetInt(response, "s", 0);
                return true;
            }

            g_inv11_trade_confirm[playerid] = true;
            JSON_SetInt(response, "s", 1);

            if(g_inv11_trade_confirm[targetid])
            {
                if(Inv11Trade_Finalize(playerid, targetid))
                {
                    Inv11Trade_EndSession(playerid, targetid, 4, 4);
                    Inventory11(playerid);
                    Inventory11(targetid);
                    ShowNotificationLaird(playerid, 3, 6, 0, 0, "Обмен прошел успешно", " ");
                    ShowNotificationLaird(targetid, 3, 6, 0, 0, "Обмен прошел успешно", " ");
                    // Keep response packet for confirmer: some client builds keep dialog blocked without t=9 response.
                    send_response = 1;
                }
					else
                {
                    Inv11Trade_ResetApplyState(playerid, targetid);
                    ShowNotificationLaird(playerid, 2, 6, 0, 0, "Не удалось завершить трейд", " ");
                    ShowNotificationLaird(targetid, 2, 6, 0, 0, "Не удалось завершить трейд", " ");
                    JSON_SetInt(response, "s", 0);
                }
            }

            return true;
        }
    }

    return false;
}

stock Inventory11_ResetSkinSlots(playerid)
{
    new pvar_name[24];
    for(new slot = 0; slot < 128; slot++)
    {
        format(pvar_name, sizeof(pvar_name), "inv11_skin_%d", slot);
        if(GetPVarType(playerid, pvar_name))
        {
            DeletePVar(playerid, pvar_name);
        }
    }
    return 1;
}

stock Inventory11_SetSkinModelByPos(playerid, pos, modelid)
{
    new pvar_name[24];
    format(pvar_name, sizeof(pvar_name), "inv11_skin_%d", pos);
    SetPVarInt(playerid, pvar_name, modelid);
    printf("[INV11] player=%d slot=%d item=134 model=%d", playerid, pos, modelid);
    return 1;
}

stock Inventory11_AppendItemToJson(json_str[], json_size, item_id, item_value, slot, extra)
{
    // BR mobile inventory parser consumes ONE FLAT stream, exactly 4 values per cell:
    // [item_id, value/count, slot_index, extra]. Never append model_id as a fifth value.
    new temp[72];
    format(temp, sizeof(temp), "%d,%d,%d,%d,", item_id, item_value, slot, extra);
    strcat(json_str, temp, json_size);
    return 1;
}

stock Inventory11_AppendPlateItemToJson(json_str[], json_size, item_id, plate_text[], slot)
{
    new temp[128];
    // Plate text is allowed in the second field; record still has exactly 4 values.
    format(temp, sizeof(temp), "%d,\"%s\",%d,0,", item_id, plate_text, slot);
    strcat(json_str, temp, json_size);
    return 1;
}

stock Inventory11_DbSlotToClientSlot(db_slot)
{
    return db_slot - 1;
}

stock Inventory11_ClientSlotToDbSlot(client_slot)
{
    return client_slot + 1;
}



stock Inventory11_GetAccessoryAddWeightByModel(modelid)
{
    if(modelid <= 0)
    {
        return 0;
    }

    for(new i = 0; i < sizeof(Inventory11AccessoryAddWeightByModel); i++)
    {
        if(Inventory11AccessoryAddWeightByModel[i][0] == modelid)
        {
            return Inventory11AccessoryAddWeightByModel[i][1];
        }
    }

    return 0;
}

stock Inventory11_GetAdditionalWeightKg(playerid)
{
    new add_weight = 0;

    for(new slot = 0; slot < MAX_PLAYER_ATTACHED_OBJECTS; slot++)
    {
        if(!IsPlayerAttachedObjectSlotUsed(playerid, slot))
        {
            continue;
        }

        new modelid = floatround(gPlayerTempAccData[playerid][slot][0]);
        if(modelid <= 0)
        {
            continue;
        }

        add_weight += Inventory11_GetAccessoryAddWeightByModel(modelid);
    }

    return add_weight;
}

stock Inventory11_GetMaxWeightKg(playerid)
{
    #pragma unused playerid
    return INVENTORY11_MAX_WEIGHT_KG;
}

stock Inventory11_GetMaxSlots(playerid)
{
    #pragma unused playerid
    return INVENTORY11_MAX_SLOTS;
}

stock Inventory11_GetVipForGui(playerid)
{
    new vip = GetPlayerPremium(playerid);
    if(vip < 0) vip = 0;
    if(vip > 3) vip = 3;

    new premium_date = GetPlayerData(playerid, P_PREMIUM_DATE);
    if(vip > 0 && premium_date > 0 && premium_date <= gettime())
    {
        vip = 0;
    }
    return vip;
}

stock Inventory11_GetItemWeightX10(item_id, amount = 1)
{
    if(amount <= 0)
    {
        amount = 1;
    }

    new item_weight_x10 = InventoryCfg_GetItemWeightX10(item_id);
    if(item_weight_x10 <= 0)
    {
        item_weight_x10 = 10;
    }

    if(item_id == 22)
    {
        return item_weight_x10 * amount;
    }

    return item_weight_x10;
}

stock bool:Inventory11_CanAddItemWeight(playerid, item_id, amount = 1)
{
    new add_weight_x10 = Inventory11_GetItemWeightX10(item_id, amount);
    new max_weight_x10 = Inventory11_GetMaxWeightKg(playerid) * 10;

    return (Inventory11_GetCurrentWeightX10(playerid) + add_weight_x10 <= max_weight_x10);
}

stock bool:Inventory11_IsAccessoryItem(item_id)
{
    return (Inv11_GetAccModelByItem(item_id) > 0);
}

stock Inv11_GetAccModelByItem(item_id)
{
    for(new i = 0; i < sizeof(AccessoryMapping); i++)
    {
        if(AccessoryMapping[i][1] == item_id)
        {
            return AccessoryMapping[i][2];
        }
    }

    for(new i = 0; i < sizeof(CaseAccessoryRewardMapping); i++)
    {
        if(CaseAccessoryRewardMapping[i][0] == item_id)
        {
            return CaseAccessoryRewardMapping[i][1];
        }
    }

    return -1;
}
stock bool:Inv11_ResolveAccessoryReward(internal, &item_id, &modelid)
{
    item_id = -1;
    modelid = -1;

    // Case rewards usually pass inventory item id in internal.
    for(new i = 0; i < sizeof(AccessoryMapping); i++)
    {
        if(AccessoryMapping[i][1] == internal)
        {
            item_id = AccessoryMapping[i][1];
            modelid = AccessoryMapping[i][2];
            return true;
        }
    }

    for(new i = 0; i < sizeof(CaseAccessoryRewardMapping); i++)
    {
        if(CaseAccessoryRewardMapping[i][0] == internal)
        {
            item_id = internal;
            modelid = CaseAccessoryRewardMapping[i][1];
            return true;
        }
    }

    // Fallback for flows where internal is donate internal id.
    for(new i = 0; i < sizeof(AccessoryMapping); i++)
    {
        if(AccessoryMapping[i][0] == internal)
        {
            item_id = AccessoryMapping[i][1];
            modelid = AccessoryMapping[i][2];
            return true;
        }
    }

    if(AccessoryGetIndexByModel(internal) != -1)
    {
        item_id = internal;
        modelid = internal;
        return true;
    }

    return false;
}

stock bool:Inv11_GetAccModelBySlot(playerid, slot, item_id, &modelid)
{
    modelid = 0;

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[196];
    mysql_format(mysql, query, sizeof(query), "SELECT model_id, extra_1 FROM inventory WHERE account_id = %d AND slot = %d AND item_id = %d LIMIT 1", account_id, slot, item_id);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] GetAccessoryModelBySlot failed errno=%d account_id=%d slot=%d item=%d query=%s", mysql_errno(), account_id, slot, item_id, query);
        cache_delete(result);
        return false;
    }

    if(cache_num_rows() > 0)
    {
        new db_model = cache_get_field_content_int(0, "model_id");
        new db_extra = cache_get_field_content_int(0, "extra_1");

        // For Inventory11 accessories, real model should be in extra_1.
        // model_id can be 1 (amount placeholder), so do not use it blindly.
        if(db_extra > 0)
        {
            modelid = db_extra;
        }
					else if(db_model > 1)
        {
            modelid = db_model;
        }
					else if(db_model > 0 && FindAccsDataIndexByModel(db_model) != -1)
        {
            modelid = db_model;
        }
    }

    cache_delete(result);

    // Fallback for clients that send slot=0 and for legacy rows.
    if(modelid <= 0 && FindAccsDataIndexByModel(item_id) != -1)
    {
        modelid = item_id;
    }

    if(modelid <= 0)
    {
        modelid = Inv11_GetAccModelByItem(item_id);
    }

    // Mapping may be stale for some items (e.g. ga differs from actual model in current build).
    if(modelid > 0 && AccessoryGetIndexByModel(modelid) == -1 && FindAccsDataIndexByModel(item_id) != -1)
    {
        printf("[INV11][WARN] Accessory model fallback by item: player=%d item=%d mapped_model=%d", playerid, item_id, modelid);
        modelid = item_id;
    }

    return (modelid > 0);
}

stock Inventory11_FindFirstItemSlotById(playerid, item_id)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return -1;
    }

    new query[196];
    mysql_format(mysql, query, sizeof(query), "SELECT slot FROM inventory WHERE account_id = %d AND item_id = %d ORDER BY slot ASC LIMIT 1", account_id, item_id);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] FindFirstItemSlotById failed errno=%d account_id=%d item=%d query=%s", mysql_errno(), account_id, item_id, query);
        cache_delete(result);
        return -1;
    }

    if(cache_num_rows() <= 0)
    {
        cache_delete(result);
        return -1;
    }

    new slot = cache_get_field_content_int(0, "slot");
    cache_delete(result);
    return slot;
}

stock Inv11_GetAccItemByModel(modelid)
{
    for(new i = 0; i < sizeof(AccessoryMapping); i++)
    {
        if(AccessoryMapping[i][2] == modelid)
        {
            return AccessoryMapping[i][1];
        }
    }

    for(new i = 0; i < sizeof(CaseAccessoryRewardMapping); i++)
    {
        if(CaseAccessoryRewardMapping[i][1] == modelid)
        {
            return CaseAccessoryRewardMapping[i][0];
        }
    }

    if(Inventory11_IsAccessoryItem(modelid))
    {
        return modelid;
    }

    return -1;
}

stock Inventory11_GetActiveAccessories(playerid, &item_1, &model_1, &item_2, &model_2)
{
    item_1 = -1;
    model_1 = -1;
    item_2 = -1;
    model_2 = -1;

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return 0;
    }

    new query[160];
    mysql_format(mysql, query, sizeof(query), "SELECT slot, acs_id FROM accessories_players WHERE player_id = %d AND bone > 0 AND slot IN (1,2) ORDER BY slot ASC", account_id);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] GetActiveAccessories failed errno=%d account_id=%d query=%s", mysql_errno(), account_id, query);
        cache_delete(result);
        return 0;
    }

    new rows = cache_num_rows();
    for(new i = 0; i < rows; i++)
    {
        new active_slot = cache_get_field_content_int(i, "slot");
        new acs_id = cache_get_field_content_int(i, "acs_id");

        if(active_slot < 1 || active_slot > 2)
        {
            continue;
        }

        if(acs_id < 0 || acs_id >= sizeof(accessory))
        {
            continue;
        }

        new modelid = accessory[acs_id][ID_ACCESSORY];
        new item_id = Inv11_GetAccItemByModel(modelid);
        if(modelid <= 0 || item_id <= 0)
        {
            continue;
        }

        if(active_slot == 1)
        {
            item_1 = item_id;
            model_1 = modelid;
        }
					else
        {
            item_2 = item_id;
            model_2 = modelid;
        }
    }

    cache_delete(result);
    return rows;
}

stock bool:Inventory11_IsActiveAccessorySlot(playerid, active_slot, item_id)
{
    if(active_slot < 1 || active_slot > 2)
    {
        return false;
    }

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[180];
    mysql_format(mysql, query, sizeof(query), "SELECT acs_id FROM accessories_players WHERE player_id = %d AND bone > 0 AND slot = %d LIMIT 1", account_id, active_slot);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno() || cache_num_rows() <= 0)
    {
        cache_delete(result);
        return false;
    }

    new acs_id = cache_get_field_content_int(0, "acs_id");
    cache_delete(result);

    if(acs_id < 0 || acs_id >= sizeof(accessory))
    {
        return false;
    }

    new modelid = accessory[acs_id][ID_ACCESSORY];
    new active_item_id = Inv11_GetAccItemByModel(modelid);
    if(active_item_id <= 0)
    {
        active_item_id = item_id;
    }

    return (item_id <= 0 || active_item_id == item_id);
}

stock Inventory11_GetFreeActiveAccessorySlot(playerid, modelid, &active_slot)
{
    active_slot = 0;

    new item_1, model_1, item_2, model_2;
    Inventory11_GetActiveAccessories(playerid, item_1, model_1, item_2, model_2);

    if(model_1 == modelid)
    {
        active_slot = 1;
        return 2; // already equipped
    }

    if(model_2 == modelid)
    {
        active_slot = 2;
        return 2; // already equipped
    }

    if(model_1 <= 0)
    {
        active_slot = 1;
        return 1;
    }

    if(model_2 <= 0)
    {
        active_slot = 2;
        return 1;
    }

    return 0; // no free slots
}

stock bool:Inventory11_BuildAiJson(playerid, ai_json[], ai_size)
{
    new item_1, model_1, item_2, model_2;
    Inventory11_GetActiveAccessories(playerid, item_1, model_1, item_2, model_2);

    // Active-slot protocol is a FLAT stream of 4 values per item.
    // SIM is inserted by the client from `nm`, skin uses protocol slot 6.
    // Client maps protocol slot 0 -> UI cell 2, so we intentionally put the
    // player's first REAL equipped accessory into the former backpack cell.
    // Protocol slot 1 then becomes the second equipped accessory (UI cell 3).
    // Never synthesize the old fake `2,1,0,0` backpack item.
    format(ai_json, ai_size, "[134,%d,6,0", GetPlayerSkin(playerid));

    new temp[48];
    if(item_1 > 0 && model_1 > 0)
    {
        format(temp, sizeof(temp), ",%d,1,0,0", item_1);
        strcat(ai_json, temp, ai_size);
    }

    if(item_2 > 0 && model_2 > 0)
    {
        format(temp, sizeof(temp), ",%d,1,1,0", item_2);
        strcat(ai_json, temp, ai_size);
    }

    strcat(ai_json, "]", ai_size);
    return true;
}

stock Inventory11_SetAiArrayOnJson(playerid, json_obj)
{
    new ai_json[192];
    Inventory11_BuildAiJson(playerid, ai_json, sizeof(ai_json));

    new Node:aiArray = JSON_Array();
    JSON_Parse(ai_json, aiArray);
    JSON_SetArray(json_obj, "ai", aiArray);
    return 1;
}

stock Inventory11_SetFullStateOnJson(playerid, json_obj)
{
    new it_json[8192];
    TrunkTest_BuildInventoryJson(playerid, it_json, sizeof(it_json));

    new Node:itArray = JSON_Array();
    JSON_Parse(it_json, itArray);
    JSON_SetArray(json_obj, "it", itArray);
    JSON_SetInt(json_obj, "w", Inventory11_GetCurrentWeightKg(playerid));
    JSON_SetInt(json_obj, "nw", Inventory11_GetMaxWeightKg(playerid));
    JSON_SetInt(json_obj, "ns", Inventory11_GetMaxSlots(playerid));
    JSON_SetInt(json_obj, "sl", Inventory11_GetMaxSlots(playerid));
    JSON_SetInt(json_obj, "v", Inventory11_GetVipForGui(playerid));
    JSON_SetInt(json_obj, "nm", GetPlayerPhone(playerid));
    JSON_SetInt(json_obj, "ps", GetPlayerSkin(playerid));
    Inventory11_SetAiArrayOnJson(playerid, json_obj);
    return 1;
}

stock bool:Inventory11_HasInventoryItemInSlot(playerid, slot, item_id)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[180];
    mysql_format(mysql, query, sizeof(query), "SELECT 1 FROM inventory WHERE account_id = %d AND slot = %d AND item_id = %d LIMIT 1", account_id, slot, item_id);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] HasInventoryItemInSlot failed errno=%d account_id=%d slot=%d item=%d query=%s", mysql_errno(), account_id, slot, item_id, query);
        cache_delete(result);
        return false;
    }

    new bool:has_item = (cache_num_rows() > 0);
    cache_delete(result);
    return has_item;
}

stock bool:Inventory11_MoveActiveAccessoryToInventorySlot(playerid, item_id, active_slot, inventory_slot, &modelid)
{
    modelid = 0;

    if(active_slot < 1 || active_slot > 2)
    {
        return false;
    }

    if(inventory_slot < 1 || inventory_slot > Inventory11_GetMaxSlots(playerid))
    {
        printf("[INV11][WARN] MoveActiveAccessory invalid inventory slot: player=%d active_slot=%d inv_slot=%d item=%d", playerid, active_slot, inventory_slot, item_id);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Выберите другой слот в инвентаре", " ");
        return false;
    }

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[320];
    mysql_format(mysql, query, sizeof(query), "SELECT acs_id FROM accessories_players WHERE player_id = %d AND bone > 0 AND slot = %d LIMIT 1", account_id, active_slot);
    new Cache:active_result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] MoveActiveAccessory SELECT active failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, active_slot, query);
        cache_delete(active_result);
        return false;
    }

    if(cache_num_rows() <= 0)
    {
        cache_delete(active_result);
        return false;
    }

    new acs_id = cache_get_field_content_int(0, "acs_id");
    cache_delete(active_result);

    if(acs_id < 0 || acs_id >= sizeof(accessory))
    {
        printf("[INV11][ERROR] MoveActiveAccessory invalid acs_id=%d player=%d slot=%d", acs_id, playerid, active_slot);
        return false;
    }

    modelid = accessory[acs_id][ID_ACCESSORY];
    new inv_item_id = Inv11_GetAccItemByModel(modelid);
    if(inv_item_id <= 0) inv_item_id = item_id;

    mysql_format(mysql, query, sizeof(query), "SELECT 1 FROM inventory WHERE account_id = %d AND slot = %d AND item_id > 0 LIMIT 1", account_id, inventory_slot);
    new Cache:slot_result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] MoveActiveAccessory SELECT target failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, inventory_slot, query);
        cache_delete(slot_result);
        return false;
    }

    if(cache_num_rows() > 0)
    {
        cache_delete(slot_result);
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Слот инвентаря занят", " ");
        return false;
    }
    cache_delete(slot_result);

    // Accessory in inventory must have amount=1 and model in extra_1.
    mysql_format(mysql, query, sizeof(query), "INSERT INTO inventory (account_id, item_id, model_id, slot, amount, extra_1, extra_2, source_internal_id, old_skin, sim, oldsim) VALUES (%d, %d, 1, %d, 1, %d, 0, 0, 0, 0, 0)", account_id, inv_item_id, inventory_slot, modelid);
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] MoveActiveAccessory INSERT inventory failed errno=%d account_id=%d item=%d slot=%d model=%d query=%s", mysql_errno(), account_id, inv_item_id, inventory_slot, modelid, query);
        return false;
    }

    mysql_format(mysql, query, sizeof(query), "DELETE FROM accessories_players WHERE player_id = %d AND slot = %d LIMIT 1", account_id, active_slot);
    mysql_query(mysql, query, false);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] MoveActiveAccessory DELETE active failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, active_slot, query);

        mysql_format(mysql, query, sizeof(query), "DELETE FROM inventory WHERE account_id = %d AND slot = %d AND item_id = %d LIMIT 1", account_id, inventory_slot, inv_item_id);
        mysql_query(mysql, query, false);
        return false;
    }

    if(IsPlayerAttachedObjectSlotUsed(playerid, active_slot))
    {
        RemovePlayerAttachedObject(playerid, active_slot);
    }

    for(new p = 0; p <= 10; p++)
    {
        gPlayerTempAccData[playerid][active_slot][p] = 0.0;
    }

    printf("[INV11] MoveActiveAccessory success: player=%d item=%d model=%d active_slot=%d inv_slot=%d", playerid, inv_item_id, modelid, active_slot, inventory_slot);
    return true;
}

stock Inventory11_OpenAccessoryEditor(playerid, slot, acs_id, modelid, bone, Float:x, Float:y, Float:z, Float:rX, Float:rY, Float:rZ, Float:scale)
{
    for(new a; a < 12; a++) SendClientMessage(playerid, 0xFFFFFFFF, "");
    TogglePlayerHudElement(playerid, HUD_ELEMENT_CHAT, HUD_ELEMENT_HIDE);

    SetPVarInt(playerid, "slot", slot);
    SetPVarInt(playerid, "acs_id", acs_id);
    SetPVarInt(playerid, "bone", bone);
    DeletePVar(playerid, "inv_acs_db_id");
    SetPVarInt(playerid, "edit_modelid", modelid);

    SetPVarFloat(playerid, "edit_x", x);
    SetPVarFloat(playerid, "edit_y", y);
    SetPVarFloat(playerid, "edit_z", z);
    SetPVarFloat(playerid, "edit_rX", rX);
    SetPVarFloat(playerid, "edit_rY", rY);
    SetPVarFloat(playerid, "edit_rZ", rZ);
    SetPVarFloat(playerid, "edit_scale", scale);

    HidePlayerGUI(playerid, 33);
    HidePlayerGUI(playerid, GUICarsTrunkOrCloset);
    HideHud(playerid);
    SelectTextDraw(playerid, 0xFFFF00FF);

    for(new i; i < 11; i++) TextDrawShowForPlayer(playerid, acss_fix_TD[i]);
    TextDrawShowForPlayer(playerid, acss_fix_TD[17]);
    TextDrawShowForPlayer(playerid, acss_fix_TD[24]);
    TextDrawShowForPlayer(playerid, acss_fix_TD[25]);

    new acs_coords[18];
    format(acs_coords, sizeof acs_coords, "%f", GetPVarFloat(playerid, "edit_x"));

    AccessoryEdit_DestroyCoordsTextdraw(playerid);
    acss_coords_fix_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 521.3996, 292.8998, acs_coords);
    PlayerTextDrawLetterSize(playerid, acss_coords_fix_PTD[playerid][0], 0.3000, 1.6000);
    PlayerTextDrawAlignment(playerid, acss_coords_fix_PTD[playerid][0], 2);
    PlayerTextDrawColor(playerid, acss_coords_fix_PTD[playerid][0], 0xFFFFFFFF);
    PlayerTextDrawBackgroundColor(playerid, acss_coords_fix_PTD[playerid][0], 255);
    PlayerTextDrawFont(playerid, acss_coords_fix_PTD[playerid][0], 1);
    PlayerTextDrawSetProportional(playerid, acss_coords_fix_PTD[playerid][0], 1);
    PlayerTextDrawSetShadow(playerid, acss_coords_fix_PTD[playerid][0], 0);
    SetPVarInt(playerid, "acss_coords_td_created", 1);
    PlayerTextDrawShow(playerid, acss_coords_fix_PTD[playerid][0]);

    SetPVarInt(playerid, "acss_fix_TD_use", 1);
    TogglePlayerAllHudElements(playerid, HUD_ELEMENT_HIDE);
    AccessoryEditSetMovementLock(playerid, true);
    return 1;
}

stock bool:Inv11_OpenAccEditorBySlot(playerid, slot)
{
    if(slot < 1 || slot > 2)
    {
        return false;
    }

    if(!IsPlayerAttachedObjectSlotUsed(playerid, slot))
    {
        return false;
    }

    new modelid = floatround(gPlayerTempAccData[playerid][slot][0]);
    new bone = floatround(gPlayerTempAccData[playerid][slot][1]);
    new Float:x = gPlayerTempAccData[playerid][slot][2];
    new Float:y = gPlayerTempAccData[playerid][slot][3];
    new Float:z = gPlayerTempAccData[playerid][slot][4];
    new Float:rX = gPlayerTempAccData[playerid][slot][5];
    new Float:rY = gPlayerTempAccData[playerid][slot][6];
    new Float:rZ = gPlayerTempAccData[playerid][slot][7];
    new Float:scale = gPlayerTempAccData[playerid][slot][8];

    if(scale <= 0.0) scale = 1.0;

    new acs_id = AccessoryGetIndexByModel(modelid);
    if(acs_id < 0 || acs_id >= sizeof(accessory))
    {
        return false;
    }

    Inventory11_OpenAccessoryEditor(playerid, slot, acs_id, modelid, bone, x, y, z, rX, rY, rZ, scale);
    return true;
}
stock bool:Inventory11_EquipAccessoryFromInventory(playerid, inventory_slot, item_id, &active_slot, &modelid)
{
    active_slot = 0;
    modelid = 0;

    if(!Inv11_GetAccModelBySlot(playerid, inventory_slot, item_id, modelid))
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Не удалось прочитать аксессуар", " ");
        return false;
    }

    new slot_state = Inventory11_GetFreeActiveAccessorySlot(playerid, modelid, active_slot);
    if(slot_state == 2)
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Этот аксессуар уже надет", " ");
        return false;
    }

    if(slot_state == 0 || active_slot < 1 || active_slot > 2)
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Можно надеть только 2 аксессуара", " ");
        return false;
    }

    new acs_id = AccessoryGetIndexByModel(modelid);
    if(acs_id < 0 || acs_id >= sizeof(accessory))
    {
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Неверная модель аксессуара", " ");
        return false;
    }

    new bone = accessory[acs_id][BONE_ACCESSORY];

    new Float:x = 0.01, Float:y = 0.01, Float:z = 0.01;
    new Float:rX = 0.01, Float:rY = 0.01, Float:rZ = 0.01;
    new Float:scale_x = 1.01, Float:scale_y = 1.01, Float:scale_z = 1.01;

    new acc_index = FindAccsDataIndexByModel(modelid);
    if(acc_index != -1)
    {
        bone = AccsData[acc_index][accBone];
        x = AccsData[acc_index][accX];
        y = AccsData[acc_index][accY];
        z = AccsData[acc_index][accZ];
        rX = AccsData[acc_index][accRotX];
        rY = AccsData[acc_index][accRotY];
        rZ = AccsData[acc_index][accRotZ];
        scale_x = AccsData[acc_index][accScaleX];
        scale_y = AccsData[acc_index][accScaleY];
        scale_z = AccsData[acc_index][accScaleZ];
    }

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[320];
    mysql_format(mysql, query, sizeof(query), "DELETE FROM accessories_players WHERE player_id = %d AND slot = %d", account_id, active_slot);
    mysql_query(mysql, query, false);
    if(mysql_errno())
    {
        printf("[INV11][ERROR] EquipAccessory delete slot failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, active_slot, query);
    }

    mysql_format(mysql, query, sizeof(query),
        "INSERT INTO accessories_players (player_id, slot, bone, acs_id, x, y, z, rX, rY, rZ, scale) VALUES (%d, %d, %d, %d, %f, %f, %f, %f, %f, %f, %f)",
        account_id, active_slot, bone, acs_id, x, y, z, rX, rY, rZ, scale_x);
    mysql_query(mysql, query, false);
    if(mysql_errno())
    {
        printf("[INV11][ERROR] EquipAccessory insert failed errno=%d account_id=%d slot=%d item=%d model=%d query=%s", mysql_errno(), account_id, active_slot, item_id, modelid, query);
        return false;
    }

    if(IsPlayerAttachedObjectSlotUsed(playerid, active_slot))
    {
        RemovePlayerAttachedObject(playerid, active_slot);
    }
	if (bone < 1 || modelid < 1){
		return false;
	}
if (bone >0 && modelid > 0){
    SetPlayerAttachedObject(playerid, active_slot, modelid, bone, x, y, z, rX, rY, rZ, scale_x, scale_y, scale_z);
}
    gPlayerTempAccData[playerid][active_slot][0] = float(modelid);
    gPlayerTempAccData[playerid][active_slot][1] = float(bone);
    gPlayerTempAccData[playerid][active_slot][2] = x;
    gPlayerTempAccData[playerid][active_slot][3] = y;
    gPlayerTempAccData[playerid][active_slot][4] = z;
    gPlayerTempAccData[playerid][active_slot][5] = rX;
    gPlayerTempAccData[playerid][active_slot][6] = rY;
    gPlayerTempAccData[playerid][active_slot][7] = rZ;
    gPlayerTempAccData[playerid][active_slot][8] = scale_x;
    gPlayerTempAccData[playerid][active_slot][9] = scale_y;
    gPlayerTempAccData[playerid][active_slot][10] = scale_z;


    return true;
}
stock Inventory11_AddItemToDatabase(playerid, item_id, model_id, amount, extra_1, extra_2)
{
    new account_id = GetPlayerAccountID(playerid);
    printf("[INV11][TRACE] AddItemToDatabase start: player=%d account_id=%d item=%d model=%d amount=%d extra_1=%d extra_2=%d errno_pre=%d", playerid, account_id, item_id, model_id, amount, extra_1, extra_2, mysql_errno());

    if(account_id <= 0)
    {
        printf("[INV11][ERROR] AddItemToDatabase skipped: invalid account_id=%d player=%d item=%d errno=%d", account_id, playerid, item_id, mysql_errno());
        return -1;
    }

    if(model_id <= 0)
    {
        model_id = item_id;
    }

    if(amount <= 0)
    {
        amount = 1;
    }


    if(!Inventory11_CanAddItemWeight(playerid, item_id, amount))
    {
        printf("[INV11][WARN] AddItemToDatabase blocked by weight: player=%d item=%d amount=%d current=%d max=%d", playerid, item_id, amount, Inventory11_GetCurrentWeightKg(playerid), Inventory11_GetMaxWeightKg(playerid));
        return -1;
    }
    new sim_value = 0;
    new oldsim_value = 0;
    if(item_id == 58)
    {
        oldsim_value = extra_1;
        sim_value = GetPlayerPhone(playerid);
        if(sim_value <= 0) sim_value = oldsim_value;

        model_id = oldsim_value;
        extra_1 = oldsim_value;
        extra_2 = sim_value;

        printf("[INV11][TRACE] AddItem SIM normalized: player=%d oldsim=%d sim=%d model=%d extra_1=%d extra_2=%d", playerid, oldsim_value, sim_value, model_id, extra_1, extra_2);
    }

    if(item_id == 22)
    {
        new stack_query[196];
        mysql_format(mysql, stack_query, sizeof(stack_query), "SELECT slot, amount FROM inventory WHERE account_id = %d AND item_id = 22 ORDER BY slot ASC LIMIT 1", account_id);
        printf("[INV11][SQL] AddItem medkit SELECT: %s", stack_query);
        new Cache:stack_result = mysql_query(mysql, stack_query, true);

        if(mysql_errno())
        {
            printf("[INV11][ERROR] AddItemToDatabase medkit SELECT failed errno=%d account_id=%d query=%s", mysql_errno(), account_id, stack_query);
            cache_delete(stack_result);
            return -1;
        }

        printf("[INV11][TRACE] AddItem medkit SELECT rows=%d errno=%d", cache_num_rows(), mysql_errno());

        if(cache_num_rows() > 0)
        {
            new stack_slot = cache_get_field_content_int(0, "slot");
            new stack_amount = cache_get_field_content_int(0, "amount");
            cache_delete(stack_result);

            if(stack_amount <= 0) stack_amount = 0;
            new next_amount = stack_amount + amount;

            mysql_format(mysql, stack_query, sizeof(stack_query), "UPDATE inventory SET amount = %d, model_id = %d WHERE account_id = %d AND slot = %d LIMIT 1", next_amount, next_amount, account_id, stack_slot);
            printf("[INV11][SQL] AddItem medkit UPDATE: %s", stack_query);
            mysql_query(mysql, stack_query, true);

            if(mysql_errno())
            {
                printf("[INV11][ERROR] AddItemToDatabase medkit UPDATE failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, stack_slot, stack_query);
                return -1;
            }

            printf("[INV11][TRACE] Medkit stack updated: player=%d account_id=%d slot=%d amount=%d errno=%d", playerid, account_id, stack_slot, next_amount, mysql_errno());
            return stack_slot;
        }

        cache_delete(stack_result);
        model_id = amount;
    }

    new query[384];
    new next_slot = 0;
    new bool:used_slots[INVENTORY11_MAX_SLOTS + 1];

    for(new s = 1; s <= INVENTORY11_MAX_SLOTS; s++)
    {
        used_slots[s] = false;
    }

    mysql_format(mysql, query, sizeof(query), "SELECT slot FROM inventory WHERE account_id = %d AND slot BETWEEN 1 AND %d ORDER BY slot ASC", account_id, Inventory11_GetMaxSlots(playerid));
    printf("[INV11][SQL] AddItem SELECT slots: %s", query);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] AddItemToDatabase SELECT slots failed errno=%d account_id=%d item=%d query=%s", mysql_errno(), account_id, item_id, query);
        cache_delete(result);
        return -1;
    }

    new rows = cache_num_rows();
    printf("[INV11][TRACE] AddItem slots rows=%d errno=%d", rows, mysql_errno());

    for(new i = 0; i < rows; i++)
    {
        new slot_value = cache_get_field_content_int(i, "slot");
        if(slot_value >= 1 && slot_value <= Inventory11_GetMaxSlots(playerid))
        {
            used_slots[slot_value] = true;
        }
    }
    cache_delete(result);

    for(new s = 1; s <= Inventory11_GetMaxSlots(playerid); s++)
    {
        if(!used_slots[s])
        {
            next_slot = s;
            break;
        }
    }

    printf("[INV11][TRACE] AddItem selected slot=%d player=%d account_id=%d item=%d", next_slot, playerid, account_id, item_id);

    if(next_slot == 0)
    {
        printf("[INV11][ERROR] AddItemToDatabase failed: inventory full account_id=%d player=%d item=%d errno=%d", account_id, playerid, item_id, mysql_errno());
        return -1;
    }

    mysql_format(mysql, query, sizeof(query), "INSERT INTO inventory (account_id, item_id, model_id, slot, amount, extra_1, extra_2, source_internal_id, old_skin, sim, oldsim) VALUES (%d, %d, %d, %d, %d, %d, %d, 0, 0, %d, %d)", account_id, item_id, model_id, next_slot, amount, extra_1, extra_2, sim_value, oldsim_value);
    printf("[INV11][SQL] AddItem INSERT: %s", query);
    mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] AddItemToDatabase INSERT failed errno=%d account_id=%d item=%d slot=%d query=%s", mysql_errno(), account_id, item_id, next_slot, query);
        return -1;
    }

    printf("[INV11] AddItemToDatabase success: player=%d account_id=%d item=%d slot=%d amount=%d extra_1=%d extra_2=%d errno=%d", playerid, account_id, item_id, next_slot, amount, extra_1, extra_2, mysql_errno());
    return next_slot;
}

stock bool:Inventory11_ConsumeMedkitBySlot(playerid, slot, &left_amount)
{
    left_amount = 0;

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[196];
    mysql_format(mysql, query, sizeof(query), "SELECT amount FROM inventory WHERE account_id = %d AND slot = %d AND item_id = 22 LIMIT 1", account_id, slot);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] ConsumeMedkit SELECT failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, slot, query);
        cache_delete(result);
        return false;
    }

    if(cache_num_rows() <= 0)
    {
        cache_delete(result);
        return false;
    }

    new current_amount = cache_get_field_content_int(0, "amount");
    cache_delete(result);

    if(current_amount <= 1)
    {
        mysql_format(mysql, query, sizeof(query), "DELETE FROM inventory WHERE account_id = %d AND slot = %d AND item_id = 22 LIMIT 1", account_id, slot);
        mysql_query(mysql, query, false);

        if(mysql_errno())
        {
            printf("[INV11][ERROR] ConsumeMedkit DELETE failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, slot, query);
            return false;
        }

        left_amount = 0;
        return true;
    }

    left_amount = current_amount - 1;
    mysql_format(mysql, query, sizeof(query), "UPDATE inventory SET amount = %d, model_id = %d WHERE account_id = %d AND slot = %d AND item_id = 22 LIMIT 1", left_amount, left_amount, account_id, slot);
    mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] ConsumeMedkit UPDATE failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, slot, query);
        return false;
    }

    return true;
}
stock bool:Inventory11_GetSimBySlot(playerid, slot, &sim_number)
{
    sim_number = 0;

    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[196];
    mysql_format(mysql, query, sizeof(query), "SELECT sim, oldsim, model_id, extra_1 FROM inventory WHERE account_id = %d AND slot = %d AND item_id = 58 LIMIT 1", account_id, slot);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] GetSimBySlot failed errno=%d account_id=%d slot=%d query=%s", mysql_errno(), account_id, slot, query);
        cache_delete(result);
        return false;
    }

    if(cache_num_rows() <= 0)
    {
        cache_delete(result);
        return false;
    }

    sim_number = cache_get_field_content_int(0, "oldsim");
    if(sim_number <= 0) sim_number = cache_get_field_content_int(0, "model_id");
    if(sim_number <= 0) sim_number = cache_get_field_content_int(0, "extra_1");
    if(sim_number <= 0) sim_number = cache_get_field_content_int(0, "sim");
    cache_delete(result);

    return (sim_number > 0);
}

stock bool:Inventory11_SetSimBySlot(playerid, slot, current_number)
{
    new account_id = GetPlayerAccountID(playerid);
    if(account_id <= 0)
    {
        return false;
    }

    new query[256];
    new inv_sim = 0;

    mysql_format(mysql, query, sizeof(query), "SELECT sim, oldsim, model_id, extra_1 FROM inventory WHERE account_id = %d AND slot = %d AND item_id = 58 LIMIT 1", account_id, slot);
    new Cache:result = mysql_query(mysql, query, true);

    if(mysql_errno())
    {
        printf("[INV11][ERROR] SetSimBySlot SELECT failed errno=%d account_id=%d slot=%d current=%d query=%s", mysql_errno(), account_id, slot, current_number, query);
        cache_delete(result);
        return false;
    }

    if(cache_num_rows() > 0)
    {
