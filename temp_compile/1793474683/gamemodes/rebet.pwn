        "o.vynil_name=f.vynil_name,o.vinil_current=f.vinil_current,o.exhsuast_current=f.exhsuast_current,"\
        "o.strab_current=f.strab_current,o.EnableNeon=f.EnableNeon,o.horn_current=f.horn_current,"\
        "o.stroboscope_type=f.stroboscope_type,o.exhaust_type=f.exhaust_type,o.horn_id=f.horn_id,"\
        "o.f_state=f.f_state,o.nitro_level=f.nitro_level,o.launch=f.launch,o.pdvradar=f.pdvradar WHERE o.id=%d LIMIT 1",
        family_sql_id, ownable_sql_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars o JOIN family_cars f ON f.id=%d SET "\
        "o.comfort=f.comfort,o.sport=f.sport,o.drift=f.drift,o.sport_plus=f.sport_plus,"\
        "o.comfort1=f.comfort1,o.sport1=f.sport1,o.drift1=f.drift1,o.sport_plus1=f.sport_plus1,"\
        "o.comfort2=f.comfort2,o.sport2=f.sport2,o.drift2=f.drift2,o.sport_plus2=f.sport_plus2,"\
        "o.comfort3=f.comfort3,o.sport3=f.sport3,o.drift3=f.drift3,o.sport_plus3=f.sport_plus3,"\
        "o.comfort4=f.comfort4,o.sport4=f.sport4,o.drift4=f.drift4,o.sport_plus4=f.sport_plus4 WHERE o.id=%d LIMIT 1",
        family_sql_id, ownable_sql_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query,
        "UPDATE ownable_cars o JOIN family_cars f ON f.id=%d SET "\
        "o.lights_color=f.lights_color,o.underlights_color=f.underlights_color,"\
        "o.underlights_color_lf=f.underlights_color_lf,o.underlights_color_rt=f.underlights_color_rt,"\
        "o.is_FarLight_bought=f.is_FarLight_bought,o.is_FarLight_active=f.is_FarLight_active,"\
        "o.is_hydro_bought=f.is_hydro_bought,o.is_hydro_active=f.is_hydro_active,"\
        "o.is_pnevmo_bought=f.is_pnevmo_bought,o.pnevmo_selected=f.pnevmo_selected,"\
        "o.percentofclirness=f.percentofclirness,o.percentofclirnessZ=f.percentofclirnessZ,"\
        "o.wheel_offset_ft=f.wheel_offset_ft,o.wheel_offset_rr=f.wheel_offset_rr,"\
        "o.align_ft=f.align_ft,o.align_rr=f.align_rr,o.width_ft=f.width_ft,o.width_rr=f.width_rr,"\
        "o.wheel_radius=f.wheel_radius,o.wheel_colors=f.wheel_colors,o.body_colors=f.body_colors,"\
        "o.tonir_ft=f.tonir_ft,o.tonir_rr=f.tonir_rr,o.wheel_comp=f.wheel_comp WHERE o.id=%d LIMIT 1",
        family_sql_id, ownable_sql_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query,
        "UPDATE vehicle_store_components SET vehicleid=%d WHERE vehicleid=%d",
        ownable_sql_id, GetFamilyCarComponentStorageID(family_sql_id));
    mysql_query(mysql, query, false);
    return 1;
}


