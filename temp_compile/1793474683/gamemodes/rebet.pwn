stock SyncVehicleFrontLights(vehicleid)
{
    if(!IsValidVehicle(vehicleid)) return 0;

    new light_state = GetVehicleParam(vehicleid, V_LIGHTS) ? 1 : 0;
    new runtime_index = GetVehicleTuningRuntimeIndex(vehicleid);
    if(runtime_index >= 0 && vInfo[runtime_index][IsFarLightActive]) light_state = 1;

    foreach(new playerid: streamed_players_in_veh[vehicleid])
    {
        SetVehicleHighLightForPlayer(playerid, vehicleid, light_state);
    }
    return 1;
}

stock SetVehicleSpeedometerInfo(vehicleid, Float:fuel = 52.0, Float:mileage = 1488.0)
{
	if(!IsValidVehicle(vehicleid)) return 0;

	SetVehicleData(vehicleid, V_FUEL, fuel);
	SetVehicleData(vehicleid, V_MILEAGE, mileage);

	vInfo[vehicleid][vFuel] = fuel;
	vInfo[vehicleid][vMileage] = mileage;

	foreach(new playerid: Player)
	{
		if(GetPlayerVehicleID(playerid) == vehicleid && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) SetVehicleSpeedometerInfoFP(playerid, vehicleid, fuel, mileage);
		else continue;
	}
	return 1;
}

