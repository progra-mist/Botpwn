					fmt_text[248];

				mysql_format(mysql, fmt_text, sizeof fmt_text, "UPDATE `unitpay_payments` SET status=0 WHERE account='%s'", GetPlayerNameEx(playerid));
				mysql_query(mysql, fmt_text, false);

