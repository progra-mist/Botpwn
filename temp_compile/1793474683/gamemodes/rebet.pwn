        return Music_OnAudioGuiPacket(playerid, json);
    }

case 3:
{
    new actionType, orderMask;

    JSON_GetInt(JSONObject, "t", actionType);
    JSON_GetInt(JSONObject, "r", orderMask);

    if(actionType == 1 && orderMask > 0)
    {
        new totalCost = CalculateTotalCost(orderMask);

        if(GetPlayerMoneyEx(playerid) >= totalCost)
        {
            GivePlayerMoneyEx(playerid, -totalCost, "Покупка еды в ларьке", false, false);

            new biz_id = GetPVarInt(playerid, "larek_biz_id");
            if(biz_id >= 0) Auction_AddBusinessIncomeById(biz_id, totalCost);

            new hungerRestore = CalculateHungerRestore(orderMask);

            PlayerHunger[playerid] += hungerRestore;
            if(PlayerHunger[playerid] > 100) PlayerHunger[playerid] = 100;

            HungerWarning[playerid] = 0;

            UpdatePlayerDatabaseInt(playerid, "hunger", PlayerHunger[playerid]);

            new str[128];
            format(str, sizeof(str), "Вы купили еду! Голод: %d/100", PlayerHunger[playerid]);
            ShowNotificationNew(playerid, 1, 5, 0, 0, str, "");

            DeletePVar(playerid, "larek_biz_id");
        }
        else
        {
            ShowNotificationNew(playerid, 2, 5, 1, 1, "Недостаточно денег!", "");
        }
    }

    new Node:json_packet_data = JSON_Object();
    JSON_SetInt(json_packet_data, "c", 1);
    OnPacketIncoming(playerid, 3, json_packet_data);
    JSON_Cleanup(json_packet_data);
}



    case 14:
    {
        new t, i;

        JSON_GetInt(json, "t", t);
        JSON_GetInt(json, "i", i);

        switch(t)
        {
            case 0:  callcmd::gps(playerid, "");
            case 1:  ShowNotificationNew(playerid, 2, 5, 0, 0, "Данный раздел находится в разработке.", " ");
            case 2:  callcmd::mm(playerid, "");
            case 4:  callcmd::inv(playerid, "");
            case 5:  callcmd::anim(playerid, "");
            case 6:  callcmd::donate(playerid, "");
            case 7:  callcmd::car(playerid, "");
            case 8:  callcmd::promo(playerid, "");
            case 9:  callcmd::report(playerid, "");
            case 12: ShowNotificationNew(playerid, 2, 5, 0, 0, "Данный раздел находится в разработке.", " ");
        }

        // Подтверждаем обработку GUI 14 клиенту.
