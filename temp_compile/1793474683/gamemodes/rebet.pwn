					}
					else
					{
					    if(strlen(inputtext))
						format(g_ask[ask_id][ASK_TEXT], 128, inputtext);
						
						format(fmt_text, sizeof fmt_text, "{8B4513}Агент Поддержки {CD853F}%s[%d] {8B4513}ответил на Ваш вопрос", GetPlayerNameEx(playerid), playerid);
                    	SendClientMessage(GetAskData(ask_id, ASK_CREATOR), 0x00CC00FF, fmt_text);
