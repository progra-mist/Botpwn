        PlayerHunger[playerid] = cache_get_field_content_int(0, "hunger");
if(PlayerHunger[playerid] == 0) PlayerHunger[playerid] = 100;

if(HungerTimer[playerid] != 0) KillTimer(HungerTimer[playerid]);
