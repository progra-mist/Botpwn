CMD:musicddd(playerid, params[])
{
	if(IsPlayerDriver(playerid))
	{
	    if(GetPVarInt(playerid, "server_radio_enabled") == 1)
	    {
	        //playerid, "");
	        DeletePVar(playerid, "server_radio_enabled");
	        SendClientMessage(playerid, COR_SERVER, ""SC"Вы выключили радио");
	        //Action(playerid, "выключил(-а) радио", _, false);
	    }

	    Dialog
	    (
	        playerid, DIALOG_CAR_RADIO, DIALOG_STYLE_LIST,
	        "{FFFF00}Онлайн радио",
	        g_server_radio_items,
	        "Выбрать", "Закрыть"
	    );
	    return 1;
	}
					else
	{
	 	if(GetPlayerData(playerid, P_PLAY_PLAYER) <= 0) return SendClientMessage(playerid, 0xCECECEFF, ""USC"У Вас нет наушников!");

	    if(GetPVarInt(playerid, "server_radio_enabled") == 1)
	    {
	        //playerid, "");
	        DeletePVar(playerid, "server_radio_enabled");
	        SendClientMessage(playerid, COR_SERVER, ""SC"Вы убрали источник звука");
	        //Action(playerid, "выключил(-а) наушники.", _, false);
	        RemovePlayerAttachedObject(playerid, 3);
	    }

	    Dialog
	    (
	        playerid, DIALOG_PLAY_RADIO, DIALOG_STYLE_LIST,
	        "{FFFF00}Онлайн радио",
	        g_server_radio_items,
	        "Выбрать", "Закрыть"
	    );
	    return 1;
	}
    
}

stock TogglePlayerChat(playerid, toggle)
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, 27);
    BS_WriteValue(bitstream, PR_UINT8, toggle);
    PR_SendRPC(bitstream, playerid, 168, PR_LOW_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bitstream);
    return 1;
}

stock AnimMenu_SetEditorState(playerid, bool:enabled)
{
    if(enabled)
    {
        SetPVarInt(playerid, "anim_editor_active", 1);
        TogglePlayerControllable(playerid, false);
        HideHud(playerid);
        TogglePlayerAllHudElements(playerid, HUD_ELEMENT_HIDE);
        TogglePlayerChat(playerid, 0);
    }
    else if(GetPVarInt(playerid, "anim_editor_active"))
    {
        DeletePVar(playerid, "anim_editor_active");
        TogglePlayerControllable(playerid, true);
        TogglePlayerAllHudElements(playerid, HUD_ELEMENT_SHOW);
        TogglePlayerChat(playerid, 1);
        ShowHud(playerid);
    }
    return 1;
}

CMD:anim(playerid, params[])
{
    // Re-entering /anim while an animation is active stops it immediately.
    if(IsPlayerUseAnim(playerid) || gAnimCommandId[playerid] != 0)
    {
        ClearPlayerUseAnim(playerid);
        return 1;
    }

    if(strlen(params))
    {
        extract params -> new animid;
        if(!(1 <= animid <= sizeof anim_list))
        {
            return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /anim [номер анимации]");
        }

        if(!SetPlayerAnimation(playerid, animid - 1))
        {
            if(IsPlayerInAnyVehicle(playerid))
                return SendClientMessage(playerid, 0xCECECEFF, "Анимации нельзя использовать в транспорте");

            return SendClientMessage(playerid, 0x999999FF, "Не удалось запустить выбранную анимацию");
        }
        return 1;
    }

    AnimMenu_SetEditorState(playerid, true);
    Dialog
    (
        playerid, DIALOG_ANIM_LIST, DIALOG_STYLE_LIST,
        "{9966FF}Анимации",
        anim_list_items,
        "Выбрать", "Закрыть"
    );
    return 1;
}
