							}
					else KillEndJobTimer(playerid);
						}
					else
						{
							RemovePlayerFromVehicle(playerid);
							SendClientMessage(playerid, 0xCECECEFF, "Вы не водитель автобуса");
						}
					}*/
					case VEHICLE_ACTION_TYPE_TAXI_DRIVER: // Таксист
					{
