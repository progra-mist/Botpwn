            JSON_Cleanup(playersArray);
            JSON_Cleanup(response);
            
            return 1;
        }

        case 2: // закрытие окна
        {
            printf("[CASE 25][TYPE 2] Игрок %d закрыл окно", playerid);
            return 1;
        }
        
        default:
        {
            printf("[CASE 25][ERROR] Неизвестный тип пакета: %d от игрока %d", type, playerid);
            return 0;
        }
    }
