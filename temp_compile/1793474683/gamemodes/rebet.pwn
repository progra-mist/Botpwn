						SetBusinessData(sell_biz_id, B_OWNER_ID, 0);
						SetBusinessData(sell_biz_id, B_IMPROVEMENTS, 		0);

						SetBusinessData(sell_biz_id, B_PRODS, 			0);
						SetBusinessData(sell_biz_id, B_PROD_PRICE,		0);

