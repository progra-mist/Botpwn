}

stock CreateAcsTextDraw(playerid)
{
    // This legacy editor is still used by DIALOG_ACS_EDIT and /editacss.
    // Its TextDraws used to be disabled with #if 0, leaving only the coordinate PTD visible.
    if(!CreateLegacyAcsTextDraws())
    {
        printf("[ACS][LEGACY_TD] Open failed for player %d", playerid);
        SendClientMessage(playerid, 0xFF5252FF, "Accessory editor UI could not be initialized.");
        return 0;
    }

	SelectTextDraw(playerid, COR_SERVER);

	TextDrawShowForPlayer(playerid, acs_TD[0]);
	TextDrawShowForPlayer(playerid, acs_TD[1]);
	TextDrawShowForPlayer(playerid, acs_TD[2]);
	TextDrawShowForPlayer(playerid, acs_TD[4]);
	TextDrawShowForPlayer(playerid, acs_TD[5]);
	TextDrawShowForPlayer(playerid, acs_TD[6]);
	TextDrawShowForPlayer(playerid, acs_TD[7]);
	TextDrawShowForPlayer(playerid, acs_TD[8]);
	TextDrawShowForPlayer(playerid, acs_TD[9]);
	TextDrawShowForPlayer(playerid, acs_TD[10]);
	TextDrawShowForPlayer(playerid, acs_TD[17]);
	TextDrawShowForPlayer(playerid, acs_TD[24]);
	TextDrawShowForPlayer(playerid, acs_TD[25]);

	new acs_coords[144];
	format(acs_coords, sizeof acs_coords, "%f", GetPVarFloat(playerid, "num_1"));

	acs_coords_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 521.3996, 292.8998, acs_coords);
	PlayerTextDrawLetterSize(playerid, acs_coords_PTD[playerid][0], 0.3000, 1.6000);
	PlayerTextDrawAlignment(playerid, acs_coords_PTD[playerid][0], 2);
	PlayerTextDrawColor(playerid, acs_coords_PTD[playerid][0], 0xFFFFFFFF);
	PlayerTextDrawBackgroundColor(playerid, acs_coords_PTD[playerid][0], 255);
	PlayerTextDrawFont(playerid, acs_coords_PTD[playerid][0], 1);
	PlayerTextDrawSetProportional(playerid, acs_coords_PTD[playerid][0], 1);
	PlayerTextDrawSetShadow(playerid, acs_coords_PTD[playerid][0], 0);

	PlayerTextDrawShow(playerid, acs_coords_PTD[playerid][0]);

	SetPVarInt(playerid, "acs_td_use", 1);
	TogglePlayerControllable(playerid, true);
}

CMD:editacss(playerid, params[])
{
	extract params -> new slot; else return SCM(playerid, -1, "{FFFF00}| {FFFFFF}Используйте: {FFFF00}/{FFFFFF}editacs [слот]");

	if(!(0 <= slot <= 9)) return SCM(playerid, -1, "{FFFF00}| {FFFFFF}Используйте: слот от 0 до 9");

    new query[220], rows, Cache: result;

	format(query, sizeof query, "SELECT modelid, bone, x, y, z, rX, rY, rZ, scale FROM accessories WHERE id=%d AND slot=%d", GetPlayerAccountID(playerid), slot);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

	new modelid = cache_get_field_content_int(0, "modelid"),
	bone = cache_get_field_content_int(0, "bone"),
	Float: x =  cache_get_field_content_float(0, "x"),
  	Float: y =  cache_get_field_content_float(0, "y"),
   	Float: z =  cache_get_field_content_float(0, "z"),
   	Float: rX = cache_get_field_content_int(0, "rX"),
   	Float: rY = cache_get_field_content_int(0, "rY"),
   	Float: rZ = cache_get_field_content_int(0, "rZ"),
   	Float: scale =  cache_get_field_content_float(0, "scale");

	if(rows)
	{
       	SetPVarInt(playerid, "slot", slot);
		SetPVarInt(playerid, "modelid", modelid);
		SetPVarInt(playerid, "bone", bone);
		SetPVarFloat(playerid, "num_1", x);
		SetPVarFloat(playerid, "num_2", y);
		SetPVarFloat(playerid, "num_3", z);
		SetPVarFloat(playerid, "num_4", rX);
		SetPVarFloat(playerid, "num_5", rY);
		SetPVarFloat(playerid, "num_6", rZ);
		SetPVarFloat(playerid, "num_7", scale);

		CreateAcsTextDraw(playerid);

        if (GetPVarInt(playerid, "bone") > 0 && GetPVarInt(playerid, "modelid") > 0){
		SetPlayerAttachedObject
		(
			playerid,
			GetPVarInt(playerid, "slot"),
			GetPVarInt(playerid, "modelid"),
			GetPVarInt(playerid, "bone"),
			GetPVarFloat(playerid, "num_1"),
			GetPVarFloat(playerid, "num_2"),
   			GetPVarFloat(playerid, "num_3"),
      		GetPVarFloat(playerid, "num_4"),
			GetPVarFloat(playerid, "num_5"),
			GetPVarFloat(playerid, "num_6"),
			GetPVarFloat(playerid, "num_7"),
			GetPVarFloat(playerid, "num_7"),
			GetPVarFloat(playerid, "num_7"),
			0
		);
		}
		SetPVarInt(playerid, "acs_use", 1);
		SetPVarInt(playerid, "updateacs", 1);
	}
					else
	{
	    SCM(playerid, -1, "{FFFF00}| {FFFFFF}В данном слоту нет аксессуара");
	}

	cache_delete(result);

	return 1;

}

CMD:delacs(playerid, params[])
{
	extract params -> new slot; else return SCM(playerid, -1, "{FFFF00}| {FFFFFF}Используйте: {FFFF00}/{FFFFFF}delacs [слот]");

	new query[220], rows, Cache: result;

	format(query, sizeof query, "SELECT x FROM accessories WHERE id=%d AND slot=%d", GetPlayerAccountID(playerid), slot);
	result = mysql_query(mysql, query, true);

	rows = cache_num_rows();

 	if(rows)
 	{
 		format(query, sizeof query, "DELETE FROM accessories WHERE id=%d AND slot=%d", GetPlayerAccountID(playerid), slot);
		result = mysql_query(mysql, query, true);
		RemovePlayerAttachedObject(playerid, slot);
		SCM(playerid, -1, "{FFFF00}| {FFFFFF}Аксессуар успешно удален");
	}
					else
	{
		SCM(playerid, -1, "{FFFF00}| {FFFFFF}Нет аксессуара в этом слоту");
	}

	cache_delete(result);

	return 1;
}

stock TrafficLights_GetPoleAxis(Float:angle)
{
    while(angle < 0.0) angle += 360.0;
    while(angle >= 360.0) angle -= 360.0;

    if((angle >= 45.0 && angle < 135.0) || (angle >= 225.0 && angle < 315.0))
        return TRAFFIC_AXIS_EW;

    return TRAFFIC_AXIS_NS;
}

stock TrafficLights_GetAxisState(intersectionid, axis)
{
    if(intersectionid < 0 || intersectionid >= sizeof TrafficIntersections)
        return TRAFFIC_LIGHT_RED;

    // A small phase offset makes different intersections feel independent,
    // while every pole of one intersection remains perfectly synchronized.
    new second = (gTrafficLightCycleSecond + (intersectionid * 6)) % TRAFFIC_LIGHT_CYCLE_SECONDS;

    // 0..9: N/S green, E/W red
    if(second < 10)
        return (axis == TRAFFIC_AXIS_NS) ? TRAFFIC_LIGHT_GREEN : TRAFFIC_LIGHT_RED;

    // 10..12: N/S yellow, E/W red
    if(second < 13)
        return (axis == TRAFFIC_AXIS_NS) ? TRAFFIC_LIGHT_YELLOW : TRAFFIC_LIGHT_RED;

    // 13..14: safety all-red
    if(second < 15)
        return TRAFFIC_LIGHT_RED;

    // 15..24: E/W green, N/S red
    if(second < 25)
        return (axis == TRAFFIC_AXIS_EW) ? TRAFFIC_LIGHT_GREEN : TRAFFIC_LIGHT_RED;

    // 25..27: E/W yellow, N/S red
    if(second < 28)
        return (axis == TRAFFIC_AXIS_EW) ? TRAFFIC_LIGHT_YELLOW : TRAFFIC_LIGHT_RED;

    // 28..29: safety all-red
    return TRAFFIC_LIGHT_RED;
}

stock TrafficLights_SetPoleState(i, light_state)
{
    if(i < 0 || i >= sizeof SvetforsPos)
        return 0;

    if(SvetforsState[i] == light_state && SvetforsColor[i] != INVALID_OBJECT_ID)
        return 1;

    if(SvetforsColor[i] != INVALID_OBJECT_ID)
    {
        DestroyObject(SvetforsColor[i]);
        SvetforsColor[i] = INVALID_OBJECT_ID;
    }

    new modelid = 930;
    switch(light_state)
    {
        case TRAFFIC_LIGHT_GREEN:  modelid = 928;
        case TRAFFIC_LIGHT_YELLOW: modelid = 929;
        default:                   modelid = 930;
    }

    SvetforsColor[i] = CreateObject(
        modelid,
        SvetforsPos[i][0],
        SvetforsPos[i][1],
        SvetforsPos[i][2],
        0.0,
        0.0,
        SvetforsPos[i][3]
    );
    SvetforsState[i] = light_state;
    return 1;
}

stock TrafficLights_UpdateVisuals()
{
    for(new i; i < sizeof SvetforsPos; i++)
    {
        new intersectionid = TrafficLightIntersectionOf[i];
        new axis = TrafficLights_GetPoleAxis(SvetforsPos[i][3]);
        new light_state = TrafficLights_GetAxisState(intersectionid, axis);
        TrafficLights_SetPoleState(i, light_state);
    }
    return 1;
}

stock TrafficLights_FindClosestPole(intersectionid, Float:x, Float:y, Float:z)
{
    new best_pole = -1;
    new Float:best_dist = 999999.0;

    for(new i; i < sizeof SvetforsPos; i++)
    {
        if(TrafficLightIntersectionOf[i] != intersectionid) continue;

        new Float:dx = x - SvetforsPos[i][0];
        new Float:dy = y - SvetforsPos[i][1];
        new Float:dz = z - SvetforsPos[i][2];
        new Float:dist = (dx * dx) + (dy * dy) + (dz * dz);

        if(dist < best_dist)
        {
            best_dist = dist;
            best_pole = i;
        }
    }
    return best_pole;
}

stock TrafficLights_ResetPlayer(playerid)
{
    gTrafficTrackedVehicle[playerid] = INVALID_VEHICLE_ID;
    gTrafficLastFineTick[playerid] = 0;

    for(new intersectionid; intersectionid < sizeof TrafficIntersections; intersectionid++)
    {
        gTrafficWasInside[playerid][intersectionid] = false;
        gTrafficApproachPole[playerid][intersectionid] = -1;
    }

    return 1;
}

stock TrafficLights_ProcessPlayer(playerid)
{
    if(!IsPlayerConnected(playerid) ||
       !IsPlayerLogged(playerid) ||
       GetPlayerState(playerid) != PLAYER_STATE_DRIVER ||
       GetPlayerVirtualWorld(playerid) != 0 ||
       GetPlayerInterior(playerid) != 0)
    {
        if(gTrafficTrackedVehicle[playerid] != INVALID_VEHICLE_ID)
            TrafficLights_ResetPlayer(playerid);

        return 1;
    }

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == INVALID_VEHICLE_ID)
    {
        TrafficLights_ResetPlayer(playerid);
        return 1;
    }

    // If the player has just become a driver, remember the current zones first.
    // This prevents a false fine when entering a car already standing on a crossing.
    if(gTrafficTrackedVehicle[playerid] != vehicleid)
    {
        gTrafficTrackedVehicle[playerid] = vehicleid;

        new Float:init_x, Float:init_y, Float:init_z;
        GetVehiclePos(vehicleid, init_x, init_y, init_z);

        for(new intersectionid; intersectionid < sizeof TrafficIntersections; intersectionid++)
        {
            gTrafficWasInside[playerid][intersectionid] = IsPlayerInRangeOfPoint(
                playerid,
                TrafficIntersections[intersectionid][3],
                TrafficIntersections[intersectionid][0],
                TrafficIntersections[intersectionid][1],
                TrafficIntersections[intersectionid][2]
            );
            gTrafficApproachPole[playerid][intersectionid] = -1;

            new Float:idx = init_x - TrafficIntersections[intersectionid][0];
            new Float:idy = init_y - TrafficIntersections[intersectionid][1];
            if((idx * idx) + (idy * idy) <= 2500.0)
                gTrafficApproachPole[playerid][intersectionid] = TrafficLights_FindClosestPole(intersectionid, init_x, init_y, init_z);
        }
        return 1;
    }

    new Float:veh_x, Float:veh_y, Float:veh_z;
    GetVehiclePos(vehicleid, veh_x, veh_y, veh_z);

    for(new intersectionid; intersectionid < sizeof TrafficIntersections; intersectionid++)
    {
        new bool:is_inside = IsPlayerInRangeOfPoint(
            playerid,
            TrafficIntersections[intersectionid][3],
            TrafficIntersections[intersectionid][0],
            TrafficIntersections[intersectionid][1],
            TrafficIntersections[intersectionid][2]
        );

        new Float:dx_center = veh_x - TrafficIntersections[intersectionid][0];
        new Float:dy_center = veh_y - TrafficIntersections[intersectionid][1];
        new Float:center_dist_sq = (dx_center * dx_center) + (dy_center * dy_center);

        if(!is_inside)
        {
            gTrafficWasInside[playerid][intersectionid] = false;

            // While approaching the crossing remember the physically closest pole.
            // Its SvetforsState is exactly the colour rendered to the player, so
            // the fine can never disagree with a visible green light.
            if(center_dist_sq <= 2500.0)
                gTrafficApproachPole[playerid][intersectionid] = TrafficLights_FindClosestPole(intersectionid, veh_x, veh_y, veh_z);
            else
                gTrafficApproachPole[playerid][intersectionid] = -1;

            continue;
        }

        // The violation is checked exactly once when crossing into the core zone.
        if(gTrafficWasInside[playerid][intersectionid])
            continue;

        gTrafficWasInside[playerid][intersectionid] = true;

        // A stopped/creeping vehicle has not run the light.
        if(GetPlayerSpeed(playerid) < TRAFFIC_LIGHT_MIN_SPEED)
            continue;

        new pole = gTrafficApproachPole[playerid][intersectionid];
        if(pole < 0 || pole >= sizeof SvetforsPos || TrafficLightIntersectionOf[pole] != intersectionid)
            pole = TrafficLights_FindClosestPole(intersectionid, veh_x, veh_y, veh_z);

        if(pole < 0)
            continue;

        // IMPORTANT: use the actual state of the pole the car approached, not a
        // velocity-derived axis. This fixes fines on visually green signals.
        if(SvetforsState[pole] != TRAFFIC_LIGHT_RED)
            continue;

        new now_tick = GetTickCount();
        if(gTrafficLastFineTick[playerid] != 0 && now_tick - gTrafficLastFineTick[playerid] < 4000)
            continue;

        gTrafficLastFineTick[playerid] = now_tick;

        GivePlayerMoneyEx(
            playerid,
            -TRAFFIC_LIGHT_FINE,
            "\xd8\xf2\xf0\xe0\xf4 \xe7\xe0 \xef\xf0\xee\xe5\xe7\xe4 \xed\xe0 \xea\xf0\xe0\xf1\xed\xfb\xe9 \xf1\xe2\xe5\xf2",
            true,
            true
        );

        new msg[160];
        format(
            msg,
            sizeof msg,
            "{FFFFFF}\xc4\xee\xf0\xee\xe6\xed\xe0\xff \xea\xe0\xec\xe5\xf0\xe0: \xef\xf0\xee\xe5\xe7\xe4 \xed\xe0 {FF3B30}\xea\xf0\xe0\xf1\xed\xfb\xe9{FFFFFF}. \xd8\xf2\xf0\xe0\xf4 {00C8FF}%d \xf0\xf3\xe1\xeb\xe5\xe9{FFFFFF} \xf1\xef\xe8\xf1\xe0\xed.",
            TRAFFIC_LIGHT_FINE
        );
        SendClientMessage(playerid, 0xFFFFFFFF, msg);
    }
    return 1;
}

stock LoadSvetfor()
{
    gTrafficLightCycleSecond = 0;

    for(new i; i < sizeof SvetforsPos; i++)
    {
        CreateObject(
            931,
            SvetforsPos[i][0],
            SvetforsPos[i][1],
            SvetforsPos[i][2],
            0.0,
            0.0,
            SvetforsPos[i][3]
        );

        SvetforsColor[i] = INVALID_OBJECT_ID;
        SvetforsState[i] = 0;
    }

    TrafficLights_UpdateVisuals();

    SetTimer("TrafficLights_Tick", 1000, true);
    SetTimer("TrafficLights_PlayerTick", 250, true);
    return 1;
}

forward TrafficLights_Tick();
public TrafficLights_Tick()
{
    gTrafficLightCycleSecond++;
    if(gTrafficLightCycleSecond >= TRAFFIC_LIGHT_CYCLE_SECONDS)
        gTrafficLightCycleSecond = 0;

    TrafficLights_UpdateVisuals();
    return 1;
}

forward TrafficLights_PlayerTick();
public TrafficLights_PlayerTick()
{
    foreach(new playerid : Player)
        TrafficLights_ProcessPlayer(playerid);

    return 1;
}

CMD:matddffg(playerid, params[])
{
    
	if(GetPlayerAdminEx(playerid) < 4) return ShowNotification(playerid, 2, "У вас нет доступа к использованию данной команде", 3, "", "");


	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"Используйте: /mat [ID игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotification(playerid, 2, "Такого игрока нет", 4, " ", "");

	new mute_time = 30;
	if(GetPlayerData(to_player, P_MUTE) > 0) return SendClientMessage(playerid, 0xCECECEFF, ""SC"У этого игрока уже есть мут");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"Нельзя выдать мут администратору выше вашего ранга");

	if(AntiSliv(playerid, "/mat")) return true;

	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, "Администратор %s выдал блокировку чата игроку %s на %d минут", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), mute_time);

	format(fmt_msg, sizeof fmt_msg, "%s. Причина: Мат в вип чат", fmt_msg);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_MUTE, mute_time * 60);
	UpdatePlayerDatabaseInt(to_player, "mute", mute_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, ""SC"Время до окончания бана чата: {CCCC00}/time");
	SendClientMessage(to_player, 0xCECECEFF, ""SC"Советуем ознакомится с правилами сервера, чтобы не получать подобных наказаний.");
	ShowNotification(to_player, 2, "{FFFFFF}У вас имеется активный мут. Время до\n{FFFFFF}разблокировки: {CCCC00}/time");

	format(fmt_msg, sizeof fmt_msg, "Выдал %s[acc:%d] блокировку чата на %d минут. Причина: Мат в вип чат",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:rem(playerid, params[])
{
   if(!IsPlayerDriver(playerid)) return SendClientMessage(playerid, COLOR_WHITE, ""USC"Вы должны находиться в транспорте");
   Action(playerid, "пристегнул ремень безопасности");
   ShowNotification(playerid, 3, "Вы успешно пристегнули ремень безопасности", 4, " ", "");
}

CMD:remoff(playerid, params[])
{
   if(!IsPlayerDriver(playerid)) return SendClientMessage(playerid, COLOR_WHITE, ""USC"Вы должны находиться в транспорте");
   Action(playerid, "отстегнул ремень безопасности");
   ShowNotification(playerid, 3, "Вы успешно отстегнули ремень безопасности", 4, " ", "");
}

CMD:delveh(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 4 && GetPlayerYouTubeEx(playerid) < 1) 
        return ShowNotification(playerid, 2, "У вас нет доступа к использованию данной команде", 3, "", "");

    if(PlayerVehicleCount[playerid] == 0)
        return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff} У вас нет созданных машин.");

    new slot;
    if(sscanf(params, "i", slot))
    {
        new info[256];
        format(info, sizeof(info), "{ffff00}|{ffffff} Используйте: /delveh [слот 1-%d]", PlayerVehicleCount[playerid]);
        SendClientMessage(playerid, 0xCECECEFF, info);
        
        // Показываем список созданных машин
        SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff} Ваши созданные машины:");
        for(new i = 0; i < PlayerVehicleCount[playerid]; i++)
        {
            if(IsValidVehicle(PlayerCreatedVehicles[playerid][i]))
            {
                new model = GetVehicleModel(PlayerCreatedVehicles[playerid][i]);
                format(info, sizeof(info), "Слот %d: ID %d, Модель %d, Номер %s %s", 
                    i+1, PlayerCreatedVehicles[playerid][i], model, 
                    g_VehicleNumberPlate[PlayerCreatedVehicles[playerid][i]], 
                    g_VehicleRegion[PlayerCreatedVehicles[playerid][i]]);
                SendClientMessage(playerid, 0x999999FF, info);
            }
					else
            {
                format(info, sizeof(info), "Слот %d: УДАЛЕН", i+1);
                SendClientMessage(playerid, 0x999999FF, info);
            }
        }
        return 1;
    }

    if(slot < 1 || slot > PlayerVehicleCount[playerid])
    {
        new info[128];
        format(info, sizeof(info), "{ffff00}|{ffffff} Используйте слот от 1 до %d", PlayerVehicleCount[playerid]);
        return SendClientMessage(playerid, 0xCECECEFF, info);
    }

    // Корректируем индекс (пользователь вводит 1-5, мы используем 0-4)
    slot--;

    if(!IsValidVehicle(PlayerCreatedVehicles[playerid][slot]))
        return SendClientMessage(playerid, 0xCECECEFF, "{ffff00}|{ffffff} Транспорт в этом слоте уже удален.");

    // Удаляем транспорт
    DestroyVehicle(PlayerCreatedVehicles[playerid][slot]);
    
    // Сдвигаем массив
    for(new i = slot; i < PlayerVehicleCount[playerid] - 1; i++)
    {
        PlayerCreatedVehicles[playerid][i] = PlayerCreatedVehicles[playerid][i+1];
    }
    
    // Обнуляем последний элемент и уменьшаем счетчик
    PlayerCreatedVehicles[playerid][PlayerVehicleCount[playerid] - 1] = 0;
    PlayerVehicleCount[playerid]--;

    new fmt_text[128];
    format(fmt_text, sizeof(fmt_text), "{ffff00}|{ffffff} Вы удалили транспорт. У вас осталось %d/5 машин.", PlayerVehicleCount[playerid]);
    SendClientMessage(playerid, 0xCECECEFF, fmt_text);

    // Логирование
    format(fmt_text, sizeof(fmt_text), "[A] %s[%d] удалил созданный транспорт (слот %d)", 
        GetPlayerNameEx(playerid), playerid, slot+1);
    SendMessageToAdmins(fmt_text, 0x999999FF);

    return 1;
}


CMD:reset_cash(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotification(playerid, 2, "У вас нет доступа к использованию данной команде", 3, "", "");
	//else if(admin_logged[playerid] == false) return SendClientMessage(playerid, 0x999999FF, "Вы не авторизированы, для этого используйте /alogin");

	extract params -> new to_player, cash; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /reset_cash [ID игрока] [cумма]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotification(playerid, 2, "Такого игрока нет", 4, " ", "");

	new reason[999];
	new fmt_msg[999];
	format(reason, sizeof reason, "{1E90FF}Администратор %s[%d] обнулил вам деньги", GetPlayerNameEx(playerid), playerid);
	GivePlayerMoneyEx(to_player, -cash, reason, true, true);
	SendClientMessage(to_player, 0x66CC00FF, reason);
	
    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] обнулил деньги игроку %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);	

	format(reason, sizeof reason, "{1E90FF}Вы обнулили %s %d рублей", GetPlayerNameEx(to_player), cash);
	SendClientMessage(playerid, 0x66CC00FF, reason);

	format(reason, sizeof reason, "Обнулил %s[%d] %d руб", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), cash);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, reason);
	return 1;
}

CMD:reset_donate(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return ShowNotification(playerid, 2, "У вас нет доступа к использованию данной команде", 3, "", "");
	//else if(admin_logged[playerid] == false) return SendClientMessage(playerid, 0x999999FF, "Вы не авторизированы, для этого используйте /alogin");

	extract params -> new to_player, donate; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /reset_donate [ID игрока] [cумма]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return ShowNotification(playerid, 2, "Такого игрока нет", 4, " ", "");

	new reason[999];
	new fmt_msg[999];
	format(reason, sizeof reason, "{1E90FF}Администратор %s[%d] обнулил вам донат", GetPlayerNameEx(playerid), playerid);
	GivePlayerDonateRub(to_player, -donate, reason, true, true);
	SendClientMessage(to_player, 0x66CC00FF, reason);
	
    format(fmt_msg, sizeof fmt_msg, "[A] %s[%d] обнулил донат игроку %s[%d]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
    SendMessageToAdmins(fmt_msg, 0x999999FF);		

	format(reason, sizeof reason, "{1E90FF}Вы обнулили %s %d доната", GetPlayerNameEx(to_player), donate);
	SendClientMessage(playerid, 0x66CC00FF, reason);

	format(reason, sizeof reason, "Обнулил %s[%d] %d доната", GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), donate);
	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, reason);
	return 1;
}

CMD:givevip(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 13) return SendClientMessage(playerid, 0xCECECEFF, "У вас нет доступа к использованию данной команде");
	extract params -> new to_player, premium, days; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /givevip [ID игрока] [уровень премиум-аккаунта] [время (в днях)]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "Такого игрока нет");

	if(!(1 <= premium <= 3)) return SendClientMessage(playerid, 0x999999FF, "Уровень премиум-аккаунта от 1 до 3 (чтобы отобрать, используйте кол-во дней: 0)");

	if(!(0 <= days <= 30)) return SendClientMessage(playerid, 0x999999FF, "Количество дней от 0 до 30");

	new fmt_msg[999];

	new premium_rank[3][17] =
	{
		"{C0C0C0}Silver",
		"{FFD700}Gold",
		"{E5E4E2}Platinum"
	};

	new premium_expires = gettime() + days * 86400;
	SetPlayerData(to_player, P_PREMIUM, premium);
	SetPlayerData(to_player, P_PREMIUM_DATE, premium_expires);
	SetPlayerData(to_player, P_PREMIUM_TIME, premium_expires);
	SetPlayerData(to_player, P_PREMIUM_CHAT, 1);

	UpdatePlayerDatabaseInt(to_player, "premium", premium);
	UpdatePlayerDatabaseInt(to_player, "premium_date", premium_expires);
	UpdatePlayerDatabaseInt(to_player, "premium_time", premium_expires);

	format(fmt_msg, sizeof fmt_msg, "%s выдал Вам %s {3399FF}премиум-аккаунт на %d дн.", GetPlayerNameEx(playerid), premium_rank[premium - 1], days);
	SendClientMessage(to_player, 0x3399FFFF, fmt_msg);

	format(fmt_msg, sizeof fmt_msg, "Вы выдали %s %s {3399FF}премиум-аккаунт на %d дн.", GetPlayerNameEx(to_player), premium_rank[premium - 1], days);
	SendClientMessage(playerid, 0x3399FFFF, fmt_msg);


	return 1;
}

