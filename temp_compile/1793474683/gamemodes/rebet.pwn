    EnsureFamilyCarTuningColumn("tonir_rr", "INT NOT NULL DEFAULT 0");
    EnsureFamilyCarTuningColumn("wheel_comp", "INT NOT NULL DEFAULT 0");
    // Bridge fields used when a personal vehicle is moved into the family.
    // Keep the original personal SQL id so trunk rows can be restored when the car is taken back.
    EnsureFamilyCarTuningColumn("trunk_source_oc_id", "INT NOT NULL DEFAULT 0");
