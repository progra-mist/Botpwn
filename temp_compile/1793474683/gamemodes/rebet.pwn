                {
                    new db_old_slot = TrunkTest_ResolveInventorySourceSlot(playerid, ga, client_os, raw_s, raw_sl);
                    new requested_trunk_slot = client_ns;

                    // ns is the only unambiguous destination field. In several client
                    // revisions s is the SOURCE inventory position, so using it as a trunk
