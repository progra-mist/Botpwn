stock PrepareFamilyCarTuningRuntime(vehicleid, family_index, row)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 0;
    if(!(0 <= family_index < MAX_OWNABLE_CARS)) return 0;

    vInfo[vehicleid][vSQLID] = GetFamilyCarComponentStorageID(GetCarFamily(family_index, CAR_F_database));
    vInfo[vehicleid][vModelID] = GetCarFamily(family_index, V_F_MODEL);
    vInfo[vehicleid][iscase] = 0;
    vInfo[vehicleid][vLaunchControls] = 0;
    EnableStrob[vehicleid] = false;
    vInfo[vehicleid][vNitro] = cache_get_field_content_int(row, "nitro_level");
    vInfo[vehicleid][vLaunchControl] = cache_get_field_content_int(row, "launch");
    vInfo[vehicleid][pdvradar] = cache_get_field_content_int(row, "pdvradar");

    vInfo[vehicleid][vinil_current] = cache_get_field_content_int(row, "vinil_current");
    vInfo[vehicleid][exhsuast_current] = cache_get_field_content_int(row, "exhsuast_current");
    vInfo[vehicleid][strab_current] = cache_get_field_content_int(row, "strab_current");
    vInfo[vehicleid][horn_current] = cache_get_field_content_int(row, "horn_current");
    vInfo[vehicleid][vEnableNeon] = cache_get_field_content_int(row, "EnableNeon");
    vInfo[vehicleid][vStrob] = cache_get_field_content_int(row, "stroboscope_type");
    // Strobes are installed/selected, but activation is a runtime state and must start OFF after spawn.
    EnableStrob[vehicleid] = false;
    vInfo[vehicleid][vExhaustSound] = cache_get_field_content_int(row, "exhaust_type");
    vInfo[vehicleid][vHornSound] = cache_get_field_content_int(row, "horn_id");

    vInfo[vehicleid][vComfort] = cache_get_field_content_int(row, "comfort");
    vInfo[vehicleid][vSport] = cache_get_field_content_int(row, "sport");
    vInfo[vehicleid][vDrift] = cache_get_field_content_int(row, "drift");
    vInfo[vehicleid][vSportPlus] = cache_get_field_content_int(row, "sport_plus");
    vInfo[vehicleid][vComfort1] = cache_get_field_content_int(row, "comfort1");
    vInfo[vehicleid][vSport1] = cache_get_field_content_int(row, "sport1");
    vInfo[vehicleid][vDrift1] = cache_get_field_content_int(row, "drift1");
    vInfo[vehicleid][vSportPlus1] = cache_get_field_content_int(row, "sport_plus1");
    vInfo[vehicleid][vComfort2] = cache_get_field_content_int(row, "comfort2");
    vInfo[vehicleid][vSport2] = cache_get_field_content_int(row, "sport2");
    vInfo[vehicleid][vDrift2] = cache_get_field_content_int(row, "drift2");
    vInfo[vehicleid][vSportPlus2] = cache_get_field_content_int(row, "sport_plus2");
    vInfo[vehicleid][vComfort3] = cache_get_field_content_int(row, "comfort3");
    vInfo[vehicleid][vSport3] = cache_get_field_content_int(row, "sport3");
    vInfo[vehicleid][vDrift3] = cache_get_field_content_int(row, "drift3");
    vInfo[vehicleid][vSportPlus3] = cache_get_field_content_int(row, "sport_plus3");
    vInfo[vehicleid][vComfort4] = cache_get_field_content_int(row, "comfort4");
    vInfo[vehicleid][vSport4] = cache_get_field_content_int(row, "sport4");
    vInfo[vehicleid][vDrift4] = cache_get_field_content_int(row, "drift4");
    vInfo[vehicleid][vSportPlus4] = cache_get_field_content_int(row, "sport_plus4");
    vInfo[vehicleid][vFstate] = cache_get_field_content_int(row, "f_state");

    vInfo[vehicleid][IsHydroBought] = cache_get_field_content_int(row, "is_hydro_bought");
    vInfo[vehicleid][IsHydroActive] = cache_get_field_content_int(row, "is_hydro_active");
    vInfo[vehicleid][IsFarLightBought] = cache_get_field_content_int(row, "is_FarLight_bought");
    // High beam must never come back enabled just because the vehicle was unloaded/reloaded.
    vInfo[vehicleid][IsFarLightActive] = 0;
    vInfo[vehicleid][IsPnevmoBought] = cache_get_field_content_int(row, "is_pnevmo_bought");
    vInfo[vehicleid][SelectedPnevmo] = cache_get_field_content_int(row, "pnevmo_selected");
    vInfo[vehicleid][percentofclirness] = cache_get_field_content_int(row, "percentofclirness");
    vInfo[vehicleid][percentofclirnessz] = cache_get_field_content_int(row, "percentofclirnessZ");

    vInfo[vehicleid][wheel_offset_ft] = cache_get_field_content_int(row, "wheel_offset_ft");
    vInfo[vehicleid][wheel_offset_rr] = cache_get_field_content_int(row, "wheel_offset_rr");
    vInfo[vehicleid][align_ft] = cache_get_field_content_int(row, "align_ft");
    vInfo[vehicleid][align_rr] = cache_get_field_content_int(row, "align_rr");
    vInfo[vehicleid][width_ft] = cache_get_field_content_int(row, "width_ft");
    vInfo[vehicleid][width_rr] = cache_get_field_content_int(row, "width_rr");
    vInfo[vehicleid][wheel_radius] = cache_get_field_content_int(row, "wheel_radius");
    vInfo[vehicleid][wheel_colors] = cache_get_field_content_int(row, "wheel_colors");
    vInfo[vehicleid][body_colors] = cache_get_field_content_int(row, "body_colors");
    vInfo[vehicleid][tonir_ft] = cache_get_field_content_int(row, "tonir_ft");
    vInfo[vehicleid][tonir_rr] = cache_get_field_content_int(row, "tonir_rr");
    vInfo[vehicleid][wheel_comp] = cache_get_field_content_int(row, "wheel_comp");
    vInfo[vehicleid][lights_color] = cache_get_field_content_int(row, "lights_color");
    vInfo[vehicleid][underlights_color] = cache_get_field_content_int(row, "underlights_color");
    vInfo[vehicleid][underlights_color_lf] = cache_get_field_content_int(row, "underlights_color_lf");
    vInfo[vehicleid][underlights_color_rt] = cache_get_field_content_int(row, "underlights_color_rt");
    cache_get_field_content(row, "vynil_name", vInfo[vehicleid][vynil_name], mysql, 32);
    return 1;
}

stock ResetFamilyCarTuningRuntime(vehicleid, family_index)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 0;
    if(!(0 <= family_index < MAX_OWNABLE_CARS)) return 0;

    vInfo[vehicleid][vSQLID] = GetFamilyCarComponentStorageID(GetCarFamily(family_index, CAR_F_database));
    vInfo[vehicleid][vModelID] = GetCarFamily(family_index, V_F_MODEL);
    vInfo[vehicleid][iscase] = 0;
    vInfo[vehicleid][vLaunchControls] = 0;
    EnableStrob[vehicleid] = false;
    vInfo[vehicleid][vVinylTexture][0] = '\0';
    vInfo[vehicleid][vNitro] = 0;
    vInfo[vehicleid][vLaunchControl] = 0;
    vInfo[vehicleid][pdvradar] = 0;
    vInfo[vehicleid][vinil_current] = 0;
    vInfo[vehicleid][exhsuast_current] = 0;
    vInfo[vehicleid][strab_current] = 0;
    vInfo[vehicleid][horn_current] = 0;
    vInfo[vehicleid][vEnableNeon] = 0;
    vInfo[vehicleid][vStrob] = 0;
    vInfo[vehicleid][vExhaustSound] = 0;
    vInfo[vehicleid][vHornSound] = 0;
    vInfo[vehicleid][vFstate] = 0;
    vInfo[vehicleid][IsHydroBought] = 0;
    vInfo[vehicleid][IsHydroActive] = 0;
    vInfo[vehicleid][IsFarLightBought] = 0;
    vInfo[vehicleid][IsFarLightActive] = 0;
    vInfo[vehicleid][IsPnevmoBought] = 0;
    vInfo[vehicleid][SelectedPnevmo] = 0;
    vInfo[vehicleid][percentofclirness] = 0;
    vInfo[vehicleid][percentofclirnessz] = 0;
    vInfo[vehicleid][wheel_offset_ft] = 0;
    vInfo[vehicleid][wheel_offset_rr] = 0;
    vInfo[vehicleid][align_ft] = 0;
    vInfo[vehicleid][align_rr] = 0;
    vInfo[vehicleid][width_ft] = 0;
    vInfo[vehicleid][width_rr] = 0;
    vInfo[vehicleid][wheel_radius] = 0;
    vInfo[vehicleid][wheel_colors] = 0;
    vInfo[vehicleid][body_colors] = 0;
    vInfo[vehicleid][tonir_ft] = 0;
    vInfo[vehicleid][tonir_rr] = 0;
    vInfo[vehicleid][wheel_comp] = 0;
    vInfo[vehicleid][lights_color] = 0;
    vInfo[vehicleid][underlights_color] = 0;
    vInfo[vehicleid][underlights_color_lf] = 0;
    vInfo[vehicleid][underlights_color_rt] = 0;
    vInfo[vehicleid][vynil_name][0] = '\0';

    vInfo[vehicleid][vComfort] = 0; vInfo[vehicleid][vSport] = 0; vInfo[vehicleid][vDrift] = 0; vInfo[vehicleid][vSportPlus] = 0;
    vInfo[vehicleid][vComfort1] = 0; vInfo[vehicleid][vSport1] = 0; vInfo[vehicleid][vDrift1] = 0; vInfo[vehicleid][vSportPlus1] = 0;
    vInfo[vehicleid][vComfort2] = 0; vInfo[vehicleid][vSport2] = 0; vInfo[vehicleid][vDrift2] = 0; vInfo[vehicleid][vSportPlus2] = 0;
    vInfo[vehicleid][vComfort3] = 0; vInfo[vehicleid][vSport3] = 0; vInfo[vehicleid][vDrift3] = 0; vInfo[vehicleid][vSportPlus3] = 0;
    vInfo[vehicleid][vComfort4] = 0; vInfo[vehicleid][vSport4] = 0; vInfo[vehicleid][vDrift4] = 0; vInfo[vehicleid][vSportPlus4] = 0;
    return 1;
}

stock BuildFamilyAwareTuningQuery(playerid, const source_query[], dest_query[], dest_size)
{
    format(dest_query, dest_size, "%s", source_query);

    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid <= 0 || GetVehicleData(vehicleid, V_ACTION_TYPE) != VEHICLE_ACTION_TYPE_FAMILY_CAR)
        return 1;

    new pos = strfind(dest_query, "ownable_cars", true);
    if(pos == -1) return 1;

    new tail[768];
    strmid(tail, dest_query, pos + 12, strlen(dest_query), sizeof tail);
    dest_query[pos] = '\0';
    strcat(dest_query, "family_cars", dest_size);
    strcat(dest_query, tail, dest_size);
    return 1;
}

stock Cache:FamilyAwareTuningQuery(playerid, const source_query[], bool:use_cache = true)
{
    new query[768];
    BuildFamilyAwareTuningQuery(playerid, source_query, query, sizeof query);
    return mysql_query(mysql, query, use_cache);
}

stock FamilyAwareTuningTQuery(playerid, const source_query[])
{
    new query[768];
    BuildFamilyAwareTuningQuery(playerid, source_query, query, sizeof query);
    mysql_tquery(mysql, query);
    return 1;
}

stock CopyVehicleTuningOwnableToFamily(ownable_sql_id, family_sql_id)
{
    if(ownable_sql_id <= 0 || family_sql_id <= 0) return 0;

    new query[1536];
    mysql_format(mysql, query, sizeof query,
        "UPDATE family_cars f JOIN ownable_cars o ON o.id=%d SET "\
        "f.vynil_name=o.vynil_name,f.vinil_current=o.vinil_current,f.exhsuast_current=o.exhsuast_current,"\
        "f.strab_current=o.strab_current,f.EnableNeon=o.EnableNeon,f.horn_current=o.horn_current,"\
        "f.stroboscope_type=o.stroboscope_type,f.exhaust_type=o.exhaust_type,f.horn_id=o.horn_id,"\
        "f.f_state=o.f_state,f.nitro_level=o.nitro_level,f.launch=o.launch,f.pdvradar=o.pdvradar WHERE f.id=%d LIMIT 1",
        ownable_sql_id, family_sql_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query,
        "UPDATE family_cars f JOIN ownable_cars o ON o.id=%d SET "\
        "f.comfort=o.comfort,f.sport=o.sport,f.drift=o.drift,f.sport_plus=o.sport_plus,"\
        "f.comfort1=o.comfort1,f.sport1=o.sport1,f.drift1=o.drift1,f.sport_plus1=o.sport_plus1,"\
        "f.comfort2=o.comfort2,f.sport2=o.sport2,f.drift2=o.drift2,f.sport_plus2=o.sport_plus2,"\
        "f.comfort3=o.comfort3,f.sport3=o.sport3,f.drift3=o.drift3,f.sport_plus3=o.sport_plus3,"\
        "f.comfort4=o.comfort4,f.sport4=o.sport4,f.drift4=o.drift4,f.sport_plus4=o.sport_plus4 WHERE f.id=%d LIMIT 1",
        ownable_sql_id, family_sql_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query,
        "UPDATE family_cars f JOIN ownable_cars o ON o.id=%d SET "\
        "f.lights_color=o.lights_color,f.underlights_color=o.underlights_color,"\
        "f.underlights_color_lf=o.underlights_color_lf,f.underlights_color_rt=o.underlights_color_rt,"\
        "f.is_FarLight_bought=o.is_FarLight_bought,f.is_FarLight_active=o.is_FarLight_active,"\
        "f.is_hydro_bought=o.is_hydro_bought,f.is_hydro_active=o.is_hydro_active,"\
        "f.is_pnevmo_bought=o.is_pnevmo_bought,f.pnevmo_selected=o.pnevmo_selected,"\
        "f.percentofclirness=o.percentofclirness,f.percentofclirnessZ=o.percentofclirnessZ,"\
        "f.wheel_offset_ft=o.wheel_offset_ft,f.wheel_offset_rr=o.wheel_offset_rr,"\
        "f.align_ft=o.align_ft,f.align_rr=o.align_rr,f.width_ft=o.width_ft,f.width_rr=o.width_rr,"\
        "f.wheel_radius=o.wheel_radius,f.wheel_colors=o.wheel_colors,f.body_colors=o.body_colors,"\
        "f.tonir_ft=o.tonir_ft,f.tonir_rr=o.tonir_rr,f.wheel_comp=o.wheel_comp WHERE f.id=%d LIMIT 1",
        ownable_sql_id, family_sql_id);
    mysql_query(mysql, query, false);

    mysql_format(mysql, query, sizeof query,
        "UPDATE vehicle_store_components SET vehicleid=%d WHERE vehicleid=%d",
        GetFamilyCarComponentStorageID(family_sql_id), ownable_sql_id);
    mysql_query(mysql, query, false);
    return 1;
}

stock CopyVehicleTuningFamilyToOwnable(family_sql_id, ownable_sql_id)
{
    if(family_sql_id <= 0 || ownable_sql_id <= 0) return 0;

    new query[1536];
    mysql_format(mysql, query, sizeof query,
