case DIALOG_RENT_BIKE:
{
    if(!response) return 1;

    new rent_item_id = GetPlayerListitemValue(playerid, listitem);

    switch(rent_item_id)
    {
        case RENT_BIKE_ITEM_SCOOTER:
        {
            new rented_vehicle = GetPlayerData(playerid, P_RENT_BIKE);
            if(rented_vehicle != INVALID_VEHICLE_ID && IsValidVehicle(rented_vehicle))
                return ShowNotification(playerid, 2, "Вы уже арендовали скутер!", 4, "", "");

            // Repair a stale vehicle id left by an old rental/session.
            SetPlayerData(playerid, P_RENT_BIKE, 0);

            const scooter_rent_price = 5000;
            if(GetPlayerMoneyEx(playerid) < scooter_rent_price)
                return ShowNotification(playerid, 2, "У вас недостаточно средств для аренды скутера за 5000 рублей!", 4, "", "");

            new Float:POS[4];
            new zone_id = GetPVarInt(playerid, "rent_zone_id");

            if(0 <= zone_id < TotalRentZones && gRentZoneSlotCount[zone_id] > 0)
            {
                new rand_idx = random(gRentZoneSlotCount[zone_id]);
                POS[0] = gRentZoneParking[zone_id][rand_idx][0];
                POS[1] = gRentZoneParking[zone_id][rand_idx][1];
                POS[2] = gRentZoneParking[zone_id][rand_idx][2];
                POS[3] = gRentZoneParking[zone_id][rand_idx][3];
            }
            else
            {
                GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
                GetPlayerFacingAngle(playerid, POS[3]);
            }

            new vehicleid = CreateVehicle(462, POS[0], POS[1], POS[2], POS[3], 0, 0, 300, 0, VEHICLE_ACTION_TYPE_RENT_BIKE);
            if(vehicleid == INVALID_VEHICLE_ID || !IsValidVehicle(vehicleid))
                return ShowNotification(playerid, 2, "Не удалось создать скутер. Попробуйте ещё раз.", 4, "", "");

            SetPlayerData(playerid, P_RENT_BIKE, vehicleid);
            GivePlayerMoneyEx(playerid, -scooter_rent_price, "Аренда скутера", true);
            BlackPass_OnScooterRent(playerid);

            PutPlayerInVehicle(playerid, vehicleid, 0);
            ShowNotification(playerid, 1, "Скутер арендован за 5000 рублей.", 4, "", "");
            return 1;
        }
        case RENT_BIKE_ITEM_PREV:
            return ShowRentBikeDialog(playerid, gRentBikeDialogPage[playerid] - 1);

        case RENT_BIKE_ITEM_NEXT:
            return ShowRentBikeDialog(playerid, gRentBikeDialogPage[playerid] + 1);

        default:
        {
            if(rent_item_id > 0)
                ShowOwnableCarLoadDialog(playerid, rent_item_id, false, true);
        }
    }
    return 1;
}

            case DIALOG_ORG_CAR_GET:
