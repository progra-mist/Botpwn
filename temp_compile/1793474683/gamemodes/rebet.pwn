                    // If ns is absent, simply choose a free/merge slot server-side.
                    if(TrunkTest_LoadVehicleFromDatabase(playerid, vehicleid))
                    {
                        requested_trunk_slot = TrunkTest_ResolveTrunkTargetSlot(vehicleid, ga, requested_trunk_slot);
                    }

