stock CalculateTotalCost(orderMask)
{
    new cost = 0;

    if(orderMask & (1 << 0)) cost += 120;
    if(orderMask & (1 << 1)) cost += 230;
    if(orderMask & (1 << 2)) cost += 320;
    if(orderMask & (1 << 3)) cost += 580;
    if(orderMask & (1 << 4)) cost += 80;
    if(orderMask & (1 << 5)) cost += 30;

    return cost;
}
CMD:larek(playerid, params[])
{
    new Node:json = JSON_Object();

    JSON_SetInt(json, "o", 1);
    JSON_SetInt(json, "m", GetPlayerMoney(playerid));

    ShowPlayerGUI(playerid, 3, json);
    return 1;
}


forward OnPlayerHungerUpdate(playerid);
public OnPlayerHungerUpdate(playerid)
{
    if(!IsPlayerLogged(playerid)) return 1;

    PlayerHunger[playerid] -= 2;
    if(PlayerHunger[playerid] < 0) PlayerHunger[playerid] = 0;

    UpdatePlayerDatabaseInt(playerid, "hunger", PlayerHunger[playerid]);

    if(PlayerHunger[playerid] <= 20 && PlayerHunger[playerid] > 10 && !HungerWarning[playerid])
    {
        ShowNotificationNew(playerid, 2, 8, 0, 0, "Вы проголодались! Купите еду в ларьке!");
        HungerWarning[playerid] = 1;
    }

    if(PlayerHunger[playerid] <= 10)
    {
        new Float:health;
        GetPlayerHealth(playerid, health);
        SetPlayerHealth(playerid, health - 5.0);
    }

    return 1;
}

stock CalculateHungerRestore(orderMask)
{
    new restore = 0;
    if(orderMask & 1) restore += 5;
    if(orderMask & 2) restore += 10;
    if(orderMask & 4) restore += 15;
    if(orderMask & 8) restore += 20;
    if(orderMask & 16) restore += 3;
    if(orderMask & 32) restore += 2;
    return restore;
}

CMD:sethunger(playerid, params[])
{
    if(GetPlayerAdminEx(playerid) < 5)
        return SendClientMessage(playerid, 0xFF0000FF, "Нет доступа!");

    new targetid, value;
    if(sscanf(params, "ud", targetid, value))
        return SendClientMessage(playerid, -1, "/sethunger [id] [0-100]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "Игрок не в сети!");

    if(value < 0 || value > 100)
        return SendClientMessage(playerid, -1, "Значение от 0 до 100!");

    PlayerHunger[targetid] = value;
    HungerWarning[targetid] = 0;
    UpdatePlayerDatabaseInt(targetid, "hunger", value);

    new msg[128];
    format(msg, sizeof(msg), "Вы установили голод %d для %s", value, GetPlayerNameEx(targetid));
    SendClientMessage(playerid, 0x00FF00FF, msg);

    format(msg, sizeof(msg), "Админ установил вам голод: %d/100", value);
    SendClientMessage(targetid, 0xFFFF00FF, msg);

    return 1;
}

stock GetBusinessOwnerID(biz_id)
{
    return GetBusinessData(biz_id, B_OWNER_ID);
}

stock GetBusinessBudget(biz_id)
{
    return GetBusinessData(biz_id, B_BALANCE);
