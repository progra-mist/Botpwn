				PlayerTextDrawSetString(playerid, speedometr02_PTD[playerid][0], fmt_str);

				format
				(
					fmt_str, sizeof fmt_str,
					"%s.",
					GetVehicleParamEx(vehicleid, V_ENGINE) == VEHICLE_PARAM_ON ? ("") : ("~r~")
				);
