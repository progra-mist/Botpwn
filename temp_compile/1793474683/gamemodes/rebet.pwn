stock AutosalonApplyBlackRussiaCatalog()
{
	for(new idx; idx < sizeof(car_market_data[]); idx ++)
	{
		car_market_data[2][idx][CM_MODELID] = 0;
		car_market_data[2][idx][CM_COST] = 0;
		car_market_data[2][idx][CM_SPEED] = 0;
		car_market_data[2][idx][CM_ACCELERATION] = 0.0;
		car_market_data[2][idx][CM_NAME][0] = 0;
	}

	for(new idx; idx < sizeof(g_blackrussia_premium_catalog); idx ++)
	{
		car_market_data[2][idx][CM_MODELID] = g_blackrussia_premium_catalog[idx][CM_MODELID];
		car_market_data[2][idx][CM_COST] = g_blackrussia_premium_catalog[idx][CM_COST];
		car_market_data[2][idx][CM_SPEED] = g_blackrussia_premium_catalog[idx][CM_SPEED];
		car_market_data[2][idx][CM_ACCELERATION] = g_blackrussia_premium_catalog[idx][CM_ACCELERATION];
		format(car_market_data[2][idx][CM_NAME], 48, "%s", g_blackrussia_premium_catalog[idx][CM_NAME]);
	}

	printf("[AUTOSALON] Premium catalog applied: %d realistic vehicles", sizeof(g_blackrussia_premium_catalog));
	return 1;
}

stock AutosalonInitDatabase()
{
	new query[512];
	format(query, sizeof query,
		"CREATE TABLE IF NOT EXISTS autosalon (" \
		"market_id TINYINT NOT NULL,model_id INT NOT NULL,slots INT NOT NULL DEFAULT 0," \
		"PRIMARY KEY (market_id,model_id)) " \
		"ENGINE=InnoDB DEFAULT CHARSET=cp1251");

	new Cache:result = mysql_query(mysql, query, true);
	new error = mysql_errno();
	cache_delete(result);

	if(error)
	{
		printf("[MYSQL][AUTOSALON] table create failed, errno=%d", error);
		return 0;
	}

	print("[MYSQL][AUTOSALON] table autosalon is ready");
	return 1;
}

stock AutosalonGetDefaultStock(marketid)
{
	if(marketid < 0 || marketid >= sizeof(g_autosalon_default_stock)) return 1;
	return g_autosalon_default_stock[marketid];
}

stock AutosalonFindSlotRow(marketid, modelid)
{
	for(new idx; idx < g_autosalon_slots_loaded; idx ++)
	{
		if(g_autosalon_slots[idx][AS_MARKET_ID] != marketid) continue;
		if(g_autosalon_slots[idx][AS_MODEL_ID] != modelid) continue;

		return idx;
	}
	return -1;
}

stock AutosalonGetRawSlots(marketid, modelid)
{
	new row = AutosalonFindSlotRow(marketid, modelid);
	if(row == -1) return 0;

	return g_autosalon_slots[row][AS_SLOTS];
}

stock GetAutosalonVehicleSlots(marketid, modelid)
{
	if(marketid < 0 || marketid > 4) return 0;

	new row = AutosalonFindSlotRow(marketid, modelid);
	if(row != -1 && g_autosalon_slots[row][AS_SLOTS] > 0)
		return g_autosalon_slots[row][AS_SLOTS];

	row = AutosalonFindSlotRow(marketid, 0);
	if(row != -1 && g_autosalon_slots[row][AS_SLOTS] > 0)
		return g_autosalon_slots[row][AS_SLOTS];

	// Emergency availability: the purchase handler will persist a fresh delivery.
	return AutosalonGetDefaultStock(marketid);
}

stock bool:AutosalonHasVehicleSlots(marketid, modelid)
{
	if(GetAutosalonVehicleSlots(marketid, modelid) > 0) return true;
	return false;
}

stock AutosalonSetVehicleSlots(marketid, modelid, slots)
{
	if(marketid < 0 || marketid > 4) return 0;
	if(slots < 0) slots = 0;

	new query[192];
	mysql_format(mysql, query, sizeof query, "INSERT INTO autosalon (market_id, model_id, slots) VALUES (%d, %d, %d) ON DUPLICATE KEY UPDATE slots=%d",
		marketid, modelid, slots, slots);
	mysql_query(mysql, query, false);
	if(mysql_errno()) return 0;

	new row = AutosalonFindSlotRow(marketid, modelid);
	if(row == -1)
	{
		if(g_autosalon_slots_loaded >= MAX_AUTOSALON_SLOT_ROWS) return 0;

		row = g_autosalon_slots_loaded++;
		g_autosalon_slots[row][AS_MARKET_ID] = marketid;
		g_autosalon_slots[row][AS_MODEL_ID] = modelid;
	}

	g_autosalon_slots[row][AS_SLOTS] = slots;
	return 1;
}

stock AutosalonAddVehicleSlot(marketid, modelid, amount)
{
	new slots = AutosalonGetRawSlots(marketid, modelid) + amount;
	if(slots < 0) slots = 0;

	return AutosalonSetVehicleSlots(marketid, modelid, slots);
}

stock bool:AutosalonTakeVehicleSlot(marketid, modelid, &slot_modelid)
{
	if(marketid < 0 || marketid > 4) return false;
	new row = AutosalonFindSlotRow(marketid, modelid);
	slot_modelid = modelid;

	if(row == -1)
	{
		row = AutosalonFindSlotRow(marketid, 0);
		slot_modelid = 0;
	}

	// If the warehouse is empty, create an emergency delivery so the salon
	// never shows an unavailable vehicle.
	if(row == -1 || g_autosalon_slots[row][AS_SLOTS] <= 0)
	{
		slot_modelid = modelid;
		if(!AutosalonSetVehicleSlots(marketid, modelid, AutosalonGetDefaultStock(marketid)))
			return false;

		row = AutosalonFindSlotRow(marketid, modelid);
		if(row == -1 || g_autosalon_slots[row][AS_SLOTS] <= 0)
			return false;
	}

	new old_slots = g_autosalon_slots[row][AS_SLOTS];
	g_autosalon_slots[row][AS_SLOTS] = old_slots - 1;

	new query[144];
	mysql_format(mysql, query, sizeof query, "UPDATE autosalon SET slots=%d WHERE market_id=%d AND model_id=%d LIMIT 1",
		g_autosalon_slots[row][AS_SLOTS], marketid, slot_modelid);
	mysql_query(mysql, query, false);
	if(mysql_errno())
	{
		g_autosalon_slots[row][AS_SLOTS] = old_slots;
		return false;
	}

	return true;
}

stock AutosalonEnsureCatalogStock(bool:force_fill = false)
{
	new updated;

	for(new marketid; marketid < sizeof(car_market_data); marketid ++)
	{
		new target = AutosalonGetDefaultStock(marketid);

		for(new idx; idx < sizeof(car_market_data[]); idx ++)
		{
			new modelid = car_market_data[marketid][idx][CM_MODELID];
			if(modelid <= 0) continue;

			new row = AutosalonFindSlotRow(marketid, modelid);
			if(row == -1)
			{
				if(AutosalonSetVehicleSlots(marketid, modelid, target)) updated ++;
				continue;
			}

			if(force_fill && g_autosalon_slots[row][AS_SLOTS] < target)
			{
				if(AutosalonSetVehicleSlots(marketid, modelid, target)) updated ++;
			}
		}
	}

	printf("[AUTOSALON] Auto delivery completed, refreshed rows: %d", updated);
	return updated;
}

stock GetCarMarketModelIndex(marketid, modelid)
{
	if(marketid < 0 || marketid > 4) return -1;

	for(new idx; idx < sizeof(car_market_data[]); idx ++)
	{
		if(car_market_data[marketid][idx][CM_MODELID] == modelid)
			return idx;
	}
	return -1;
}

stock LoadAutosalonSlots()
{
	g_autosalon_slots_loaded = 0;

	new query[64], Cache: result;
	mysql_format(mysql, query, sizeof query, "SELECT market_id, model_id, slots FROM autosalon");
	result = mysql_query(mysql, query, true);
	if(mysql_errno())
	{
		cache_delete(result);
		return 0;
	}

	new rows = cache_num_rows();
	for(new idx; idx < rows; idx ++)
	{
		new marketid = cache_get_field_content_int(idx, "market_id");
		new modelid = cache_get_field_content_int(idx, "model_id");
		new slots = cache_get_field_content_int(idx, "slots");
		if(marketid < 0 || marketid > 4 || modelid < 0) continue;
		if(slots < 0) slots = 0;

		new row = AutosalonFindSlotRow(marketid, modelid);
		if(row == -1)
		{
			if(g_autosalon_slots_loaded >= MAX_AUTOSALON_SLOT_ROWS) break;
			row = g_autosalon_slots_loaded ++;
			g_autosalon_slots[row][AS_MARKET_ID] = marketid;
			g_autosalon_slots[row][AS_MODEL_ID] = modelid;
		}
		g_autosalon_slots[row][AS_SLOTS] = slots;
	}

	cache_delete(result);
	printf("[MYSQL][AUTOSALON] Loaded %d slot rows", g_autosalon_slots_loaded);
	return 1;
}

stock RefreshAutosalonSlotsForPlayers(market_filter = -1)
{
	foreach(new playerid : Player)
	{
		if(GetPlayerData(playerid, P_BUY_CAR) == INVALID_VEHICLE_ID) continue;

		new biz_id = GetPlayerInBiz(playerid);
		if(biz_id == -1) continue;

		new car_market_id = GetCarMarketIdByBizId(biz_id);
		if(car_market_id < 0 || car_market_id >= sizeof(car_market_data)) continue;
		if(market_filter != -1 && car_market_id != market_filter) continue;

		new select_car = buy_car_select_car[playerid];
		if(select_car < 0 || select_car >= sizeof(car_market_data[])) continue;
		if(car_market_data[car_market_id][select_car][CM_MODELID] <= 0) continue;

		BuyCarPTDUpdate(playerid);
	}
	return 1;
}
forward AutosalonAutoDelivery();
public AutosalonAutoDelivery()
{
	AutosalonEnsureCatalogStock(true);
	RefreshAutosalonSlotsForPlayers();
	return 1;
}

