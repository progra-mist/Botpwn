forward StroboscopeTick(playerid);
public StroboscopeTick(playerid)
{
    if(!IsPlayerConnected(playerid) || !IsPlayerInAnyVehicle(playerid))
    {
        if(gStroboscopeTimer[playerid]) KillTimer(gStroboscopeTimer[playerid]);
        gStroboscopeTimer[playerid] = 0;
        gStroboscopeBlue[playerid] = false;
        return 1;
    }

    gStroboscopeBlue[playerid] = !gStroboscopeBlue[playerid];
    if(gStroboscopeBlue[playerid]) SetVehicleLightsColors(GetPlayerVehicleID(playerid), 0, 0, 255);
    else SetVehicleLightsColors(GetPlayerVehicleID(playerid), 255, 0, 0);
    return 1;
}

CMD:stt(playerid, params[])
{
    #pragma unused params

    if(gStroboscopeTimer[playerid])
    {
        KillTimer(gStroboscopeTimer[playerid]);
        gStroboscopeTimer[playerid] = 0;
        gStroboscopeBlue[playerid] = false;
        if(IsPlayerInAnyVehicle(playerid)) SetVehicleLightsColors(GetPlayerVehicleID(playerid), 255, 255, 254);
        return 1;
    }

    if(!IsPlayerInAnyVehicle(playerid)) return 1;
    gStroboscopeBlue[playerid] = false;
    gStroboscopeTimer[playerid] = SetTimerEx("StroboscopeTick", 300, true, "i", playerid);
    StroboscopeTick(playerid);
    return 1;
}

stock CreateActorEx(name[],text[], skinid, Float:posx,Float:posy,Float:posz,Float:rot,virt = 0,inter = 0,inv = 1)
{
    for(new i = 0; i < MAX_ACTORS; i++)
    {
        if(IsValidActor(i)) continue;
        CreateActor(skinid,posx,posy,posz,rot);
        new string[144];
        SetActorVirtualWorld(i,virt);
        SetActorInvulnerable(i,inv);
        if(strlen(name) || strlen(text))
        {
            format(string,sizeof(string),"{FFFFFF}%s\n%s",name,text);
            CreateDynamic3DTextLabel(string,0xFFFF00AA,posx,posy,posz+1.2,10.0,INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, virt, inter);
        }
        return i;
    }
    return -1;
}

