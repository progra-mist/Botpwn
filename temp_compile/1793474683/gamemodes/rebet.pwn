            new probe_db_source = TrunkTest_ResolveInventorySourceSlot(playerid, probe_ga, probe_os, probe_s, probe_sl);
            new bool:looks_like_item_move = (probe_db_source > 0 || (probe_ga > 0 && (probe_os >= 0 || probe_ns >= 0 || probe_s >= 0 || probe_sl >= 0)));

            printf("[TRUNKTEST][RAW] player=%d wire_t=%d ga=%d os=%d ns=%d s=%d sl=%d db_source=%d move=%d", playerid, wire_type, probe_ga, probe_os, probe_ns, probe_s, probe_sl, probe_db_source, looks_like_item_move);

            // Compatibility with Inventory11-style Android packets. Some client
