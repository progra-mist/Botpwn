                    new all_colors_str[1808], color_str[15];

                    for(new idxx; idxx < 128; idxx ++)
                    {
                        format(color_str, sizeof color_str, "{%06x}%d | ", VehicleColoursTableRGBA[idxx]>>> 8, idxx);
