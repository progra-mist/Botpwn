						format(fmt_text, sizeof fmt_text, "{8B4513}Ответ на вопрос: {CD853F}%s", GetAskData(ask_id, ASK_TEXT));SendClientMessage(GetAskData(ask_id, ASK_CREATOR), 0x00CC00FF, fmt_text);
					
