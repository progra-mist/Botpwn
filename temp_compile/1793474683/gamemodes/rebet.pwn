#define MAX_CASES               (30)
#define MAX_CASE_BONUSES        (5)
#define CASE_BONUS_STR_LEN      (1024)

#define CASE_BONUS_STATE_LOCKED     (1)
#define CASE_BONUS_STATE_AVAILABLE  (2)
