stock FamilyZoneScoreTick(active_pvar[], player_field, const player_db_field[], family_field, const family_db_field[])
{
    new bool:dirty_family[200];
    new bool:any_active = false;

    foreach(new playerid : Player)
    {
        if(!GetPVarInt(playerid, active_pvar)) continue;

        new fam_id = GetPlayerData(playerid, P_FAMILY) + 1;
        if(fam_id <= 0 || fam_id >= sizeof(g_family)) continue;

        any_active = true;
        new player_points = GetPlayerData(playerid, player_field) + 1;
        SetPlayerData(playerid, player_field, player_points);

        new player_query[144];
        mysql_format(mysql, player_query, sizeof(player_query), "UPDATE accounts SET `%s`=%d WHERE id=%d LIMIT 1", player_db_field, player_points, GetPlayerAccountID(playerid));
        mysql_tquery(mysql, player_query);

        AddFamilyData(fam_id, family_field, +, 1);
        dirty_family[fam_id] = true;

        new current_text[24];
        format(current_text, sizeof(current_text), "%d", GetFamilyData(fam_id, family_field));
        PlayerTextDrawSetString(playerid, zakaz3_PTD[playerid][0], current_text);
    }

    if(!any_active) return 1;

    new query[144];
    for(new fam_id = 1; fam_id <= g_family_loaded && fam_id < sizeof(g_family); fam_id++)
    {
        if(!dirty_family[fam_id]) continue;
        mysql_format(mysql, query, sizeof(query), "UPDATE family SET `%s`=%d WHERE id=%d LIMIT 1", family_db_field, GetFamilyData(fam_id, family_field), fam_id);
        mysql_tquery(mysql, query);
    }

    new leader_points = 0;
    for(new fam_id = 1; fam_id <= g_family_loaded && fam_id < sizeof(g_family); fam_id++)
    {
        new points = GetFamilyData(fam_id, family_field);
        if(points > leader_points) leader_points = points;
    }

    new leader_text[24];
    format(leader_text, sizeof(leader_text), "%d", leader_points);
    TextDrawSetString(zakaz3_TD[1], leader_text);
    return 1;
}

