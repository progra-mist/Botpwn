                        (
                            playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
                            "Информация",
                            "Для быстрого запуска используйте {FFFFFF}/anim [номер анимации]\n\nПовторный ввод {FFFFFF}/anim {AFAFAF}останавливает активную анимацию.",
                            "Закрыть", ""
                        );
                    }
                    else if(!SetPlayerAnimation(playerid, listitem))
                    {
                        if(IsPlayerInAnyVehicle(playerid))
                            SendClientMessage(playerid, 0xCECECEFF, "Анимации нельзя использовать в транспорте");
                        else
                            SendClientMessage(playerid, 0x999999FF, "Не удалось запустить выбранную анимацию");
