public OnPlayerStreamIn(playerid, forplayerid)
{
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_ADMIN_CAR) return sc_OnVehicleStreamIn(vehicleid, forplayerid);
	for(new i = 0; i < streamed_players_in_veh_count[vehicleid]; i++)
    {
        if(streamed_players_in_veh_list[vehicleid][i] == forplayerid) return 1;
    }

    // Добавляем
    new idx = streamed_players_in_veh_count[vehicleid];
    streamed_players_in_veh_list[vehicleid][idx] = forplayerid;
    streamed_players_in_veh_count[vehicleid]++;

    // Prime tuning state before ANY visual packet is sent to the client.
    // This prevents a newly streamed personal car from briefly using stale/default values.
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_OWNABLE_CAR)
    {
        new ownable_idx = GetVehicleData(vehicleid, V_ACTION_ID);
        if(ownable_idx >= 0 && ownable_idx < MAX_OWNABLE_CARS && !g_ownable_tuning_ready[ownable_idx])
        {
            PrepareOwnableCarTuningRuntime(vehicleid);
        }
    }

	UpdateVehicleVisualForPlayer(forplayerid, vehicleid);
    Iter_Add(streamed_players_in_veh[vehicleid], forplayerid);
	Iter_Add(vehicle_in_stream[forplayerid], vehicleid);

    // Personal and family cars already have their stored tuning state loaded
    // before stream-in, so apply it immediately instead of showing a stock car
    // for half a second. Keep one short retry for slow custom clients.
    new vehicle_action_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
    if(vehicle_action_type == VEHICLE_ACTION_TYPE_OWNABLE_CAR || vehicle_action_type == VEHICLE_ACTION_TYPE_FAMILY_CAR)
    {
        SetTimerEx("ApplyVehicleTuning", 1, false, "dd", forplayerid, vehicleid);
        SetTimerEx("ApplyVehicleTuning", 100, false, "dd", forplayerid, vehicleid);
    }
    else
    {
        SetTimerEx("ApplyVehicleTuning", 500, false, "dd", forplayerid, vehicleid);
    }
	
	SetTimerEx("ApplyVehicleFirmware", 1500, false, "dd", forplayerid, vehicleid);
	sc_OnVehicleStreamIn(vehicleid, forplayerid);
	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
	sc_OnVehicleStreamIn(vehicleid, forplayerid);
	 for(new i = 0; i < streamed_players_in_veh_count[vehicleid]; i++)
    {
        if(streamed_players_in_veh_list[vehicleid][i] == forplayerid)
        {
            // сдвигаем всех после i
            for(new j = i; j < streamed_players_in_veh_count[vehicleid]-1; j++)
            {
                streamed_players_in_veh_list[vehicleid][j] = streamed_players_in_veh_list[vehicleid][j+1];
            }
            streamed_players_in_veh_count[vehicleid]--;
            break;
        }
    }
	Iter_Remove(streamed_players_in_veh[vehicleid], forplayerid);
	Iter_Remove(vehicle_in_stream[forplayerid], vehicleid);
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(FB_HandleDialog(playerid, dialogid, response)) return 1;

	if(Garage_HandleDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
	if(TCompany_HandleDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
	if(SP_HandleTemplateDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(Market_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
    if (WeaponShop_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;

    if(dialogid == DIALOG_DPS_NUMBER_RADAR)
    {
        if(!response) return 1;

        switch(listitem)
        {
            case 0: // Прокрут номеров
            {
                new Node:plate_json = JSON_Object();
                DeletePVar(playerid, PVAR_PLATE_BUY_ACCESS);
                DeletePVar(playerid, PVAR_PLATE_BC_PRICE);
                ClearPlateDraftCache(playerid);
                gPlayerCountry[playerid] = -1;
                PlateDraft_EnsureLoaded(playerid);
                JSON_SetInt(plate_json, "t", 0);
                ShowPlayerGUI(playerid, 1, plate_json);
                JSON_Cleanup(plate_json);
            }
            case 1: // Купить стационарный радар
            {
                if(GetPlayerTeamEx(playerid) != TEAM_DPS)
                {
                    ShowNotificationLaird(playerid, 2, 6, 0, 0, "Радар доступен только сотрудникам ГИБДД", " ");
                    return 1;
                }

                if(GetPlayerMoneyEx(playerid) < DPS_RADAR_PRICE)
                {
                    ShowNotificationLaird(playerid, 2, 6, 0, 0, "Недостаточно денег. Стоимость радара: 50.000 рублей", " ");
                    return 1;
                }

                new radar_inv_slot = Inventory11_AddItemToDatabase(playerid, DPS_RADAR_ITEM_ID, DPS_RADAR_MODEL_ID, 1, 0, 0);
                if(radar_inv_slot == -1)
                {
                    ShowNotificationLaird(playerid, 2, 6, 0, 0, "Нет места или допустимого веса в инвентаре", " ");
                    return 1;
                }

                GivePlayerMoneyEx(playerid, -DPS_RADAR_PRICE, "Покупка стационарного радара", true, true);
                ShowNotificationLaird(playerid, 3, 6, 0, 0, "Стационарный радар добавлен в инвентарь", " ");
                SendClientMessage(playerid, 0xFFFFFFFF, "{FFFFFF}Используйте радар из инвентаря в месте, где хотите его установить.");
            }
        }
        return 1;
    }

    if(dialogid == DIALOG_ANTIDM_ZONES)
    {
        if(!response) return 1;

        new green_zone_id = GetPlayerListitemValue(playerid, listitem);
        return ShowAntiDmGreenZoneInfo(playerid, green_zone_id);
    }

    if(dialogid == DIALOG_ANTIDM_INFO)
    {
        return ShowAntiDmGreenZonesDialog(playerid);
    }

    if(dialogid == 34150)
    {
        if(!response) return 1;
        return StartAutosalonTestDrive(playerid);
    }

    if(dialogid == DIALOG_ID_INV11_ACC_CUSTOMIZE)
    {
        if(response)
        {
            new acc_slot = GetPVarInt(playerid, "inv11_acc_edit_slot");
            if(!Inv11_OpenAccEditorBySlot(playerid, acc_slot))
            {
                ShowNotificationLaird(playerid, 2, 6, 0, 0, "Не удалось открыть редактирование аксессуара", " ");
            }
        }

        DeletePVar(playerid, "inv11_acc_edit_slot");
        return 1;
    }

    if(dialogid == DIALOG_INV11_TRADE_SELECT)
    {
        if(!response) return 1;

        if(listitem < 0 || listitem >= g_inv11_trade_dialog_count[playerid])
        {
            return 1;
        }

        new targetid = g_inv11_trade_dialog_target[playerid][listitem];
        if(targetid == -1 || !IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок недоступен", " ");
            return 1;
        }

        if(!Inv11Trade_IsNear(playerid, targetid, INV11_TRADE_NEAR_RANGE))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок слишком далеко для трейда", " ");
            return 1;
        }

        if(g_inv11_trade_active[playerid] || g_inv11_trade_active[targetid])
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Один из игроков уже в трейде", " ");
            return 1;
        }

        if(g_inv11_trade_invite_from[targetid] != -1 && g_inv11_trade_invite_from[targetid] != playerid && gettime() - g_inv11_trade_invite_time[targetid] <= INV11_TRADE_INVITE_TIMEOUT)
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок уже получил другое предложение", " ");
            return 1;
        }

        g_inv11_trade_invite_from[targetid] = playerid;
        g_inv11_trade_invite_time[targetid] = gettime();
        g_inv11_trade_invite_to[playerid] = targetid;

        new wait_msg[128];
        format(wait_msg, sizeof(wait_msg), "Ожидайте принятия трейда от %s", GetPlayerNameEx(targetid));
        SendClientMessage(playerid, 0xFFFFFFFF, wait_msg);
        ShowNotificationLaird(playerid, 3, 6, 0, 0, "Вы отправили предложения трейда, ожидайте принятия.", " ");
        new incoming_msg[128];
        format(incoming_msg, sizeof(incoming_msg), "Игрок %s предлагает вам трейд", GetPlayerNameEx(playerid));
        SendClientMessage(targetid, 0x55CCFFFF, incoming_msg);

        new notify_text[96];
        format(notify_text, sizeof(notify_text), "Предложение от %s", GetPlayerNameEx(playerid));
        ShowNotificationLaird(targetid, 4, 6, playerid, 0, notify_text, ">>");

        return 1;
    }

    if(dialogid == DIALOG_INV11_TRADE_CONFIRM)
    {
        new inviter = g_inv11_trade_invite_from[playerid];
        if(inviter == -1)
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Предложение не найдено", " ");
            return 1;
        }

        if(!response)
        {
            if(IsPlayerConnected(inviter) && g_inv11_trade_invite_to[inviter] == playerid)
            {
                SendClientMessage(inviter, 0xFFFFFFFF, "Игрок отклонил предложение трейда.");
                g_inv11_trade_invite_to[inviter] = -1;
            }
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(!IsPlayerConnected(inviter) || !IsPlayerLogged(inviter))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игрок недоступен", " ");
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(gettime() - g_inv11_trade_invite_time[playerid] > INV11_TRADE_INVITE_TIMEOUT)
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Предложение трейда устарело", " ");
            if(g_inv11_trade_invite_to[inviter] == playerid) g_inv11_trade_invite_to[inviter] = -1;
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(!Inv11Trade_IsNear(playerid, inviter, INV11_TRADE_NEAR_RANGE))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Подойдите ближе к игроку", " ");
            if(g_inv11_trade_invite_to[inviter] == playerid) g_inv11_trade_invite_to[inviter] = -1;
            Inv11Trade_ResetInvite(playerid);
            return 1;
        }

        if(g_inv11_trade_invite_to[inviter] == playerid) g_inv11_trade_invite_to[inviter] = -1;
        Inv11Trade_ResetInvite(playerid);

        if(!Inv11Trade_StartSession(inviter, playerid))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Не удалось начать трейд", " ");
            if(IsPlayerConnected(inviter))
            {
                ShowNotificationLaird(inviter, 2, 6, 0, 0, "Не удалось начать трейд", " ");
            }
            return 1;
        }

        SendClientMessage(inviter, 0xFFFFFFFF, "Игрок принял предложение трейда.");
        SendClientMessage(playerid, 0xFFFFFFFF, "Вы приняли предложение трейда.");
        ShowNotificationLaird(inviter, 3, 6, 0, 0, "Вы начали трейд, у Вас есть 5 минут.", " ");
        ShowNotificationLaird(playerid, 3, 6, 0, 0, "Вы начали трейд, у Вас есть 5 минут.", " ");
        return 1;
    }
    if(dialogid == DIALOG_CASINO_HIRE_ROLE)
    {
        if(!response)
        {
            DeletePVar(playerid, "casino_hire_target");
            DeletePVar(playerid, "casino_hire_biz");
            return 1;
        }

        new casino_biz = GetPVarInt(playerid, "casino_hire_biz") - 1;
        new to_player = GetPVarInt(playerid, "casino_hire_target");
        DeletePVar(playerid, "casino_hire_target");
        DeletePVar(playerid, "casino_hire_biz");

        if(!(0 <= casino_biz < g_business_loaded) || GetBusinessData(casino_biz, B_TYPE) != BUSINESS_TYPE_CASINO)
            return SendClientMessage(playerid, 0xCECECEFF, "Казино не найдено");
        if(GetPlayerBusiness(playerid) != casino_biz || GetBusinessData(casino_biz, B_OWNER_ID) != GetPlayerAccountID(playerid))
            return SendClientMessage(playerid, 0xCECECEFF, "Вы больше не являетесь владельцем этого казино");
        if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
            return SendClientMessage(playerid, 0xCECECEFF, "Игрок вышел с сервера");
        if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0))
            return SendClientMessage(playerid, 0xCECECEFF, "Игрок находится слишком далеко");

        new casino_role = listitem == 1 ? CASINO_ROLE_MANAGER : CASINO_ROLE_DEALER;
        SendPlayerOffer(playerid, to_player, OFFER_TYPE_BUSINESS_MANAGER, casino_biz, casino_role);
        return 1;
    }

    if(dialogid == DIALOG_CASINO_JOB_SELECT)
    {
        if(!response)
        {
            DeletePVar(playerid, "casino_start_biz");
            DeletePVar(playerid, "casino_start_role");
            return 1;
        }

        new casino_biz = GetPVarInt(playerid, "casino_start_biz") - 1;
        new casino_role = GetPVarInt(playerid, "casino_start_role");
        DeletePVar(playerid, "casino_start_biz");
        DeletePVar(playerid, "casino_start_role");

        if(!(0 <= casino_biz < g_business_loaded) || GetPlayerInBiz(playerid) != casino_biz || GetBusinessData(casino_biz, B_TYPE) != BUSINESS_TYPE_CASINO)
            return SendClientMessage(playerid, 0xCECECEFF, "Вы должны находиться в казино");

        new saved_role = CasinoGetStaffRole(playerid, casino_biz);
        if(saved_role == CASINO_ROLE_NONE)
            return SendClientMessage(playerid, 0xCECECEFF, "Вы больше не числитесь сотрудником этого казино");
        casino_role = saved_role;

        pInfo[playerid][CasinoDiceBetPaid] = false;
        pInfo[playerid][CasinoDiceBetPaidTable] = 0;
        pInfo[playerid][CasinoDealerJob] = (casino_role == CASINO_ROLE_DEALER);
        pInfo[playerid][CasinoManagerJob] = (casino_role == CASINO_ROLE_MANAGER);
        SetPVarInt(playerid, "casino_work_biz", casino_biz + 1);

        if(casino_role == CASINO_ROLE_MANAGER)
        {
            SetPlayerSkin(playerid, 170);
            ShowNotificationLaird(playerid, 3, 6, 0, 0, "Вы начали рабочий день менеджера", " ");
        }
        else
        {
            SetPlayerSkin(playerid, 173);
            ShowNotificationLaird(playerid, 3, 6, 0, 0, "Вы начали рабочий день крупье", " ");
        }
        return 1;
    }

    if(dialogid == DIALOG_CASINO_JOB_QUIT)
    {
        if(!response) return 1;

        if(pInfo[playerid][CasinoDealerJob] || pInfo[playerid][CasinoManagerJob])
        {
            for(new idx = 0; idx < sizeof g_casino_table_dealer; idx++)
            {
                if(g_casino_table_dealer[idx] != playerid) continue;

                g_casino_table_dealer[idx] = INVALID_PLAYER_ID;
                g_casino_table_bet[idx] = 1000;
                g_casino_table_bet_set[idx] = false;

                if(g_casino_round_active[idx]) StopCasinoDiceRound(idx);
            }
        }

        if(pInfo[playerid][CasinoDiceUiOpen])
        {
            HideCasinoDiceUi(playerid);
        }

        pInfo[playerid][CasinoDealerJob] = false;
        pInfo[playerid][CasinoManagerJob] = false;
        DeletePVar(playerid, "casino_work_biz");
        pInfo[playerid][CasinoDiceBetPaid] = false;
        pInfo[playerid][CasinoDiceBetPaidTable] = 0;

        SetPlayerSkin(playerid, GetPlayerSkinEx(playerid));
        ShowNotificationLaird(playerid, 2, 6, 0, 0, "Вы уволились", " ");
        return 1;
    }
    if(dialogid == DIALOG_CASINO_TABLE_SETBET)
    {
        if(!response)
        {
            if(pInfo[playerid][CasinoDiceUiOpen]) SelectTextDraw(playerid, 0xFFFF00FF);
            return 1;
        }

        if(!pInfo[playerid][CasinoDiceUiOpen]) return 1;

        new table_idx = pInfo[playerid][CasinoDiceTable] - 1;
        if(!IsPlayerCasinoDealer(playerid, table_idx))
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Только крупье или менеджер может установить ставку", " ");
            return 1;
        }

        if(g_casino_round_active[table_idx])
        {
            ShowNotificationLaird(playerid, 2, 6, 0, 0, "Игра уже началась", " ");
            return 1;
        }

        new bet = strval(inputtext);
        if(!(CASINO_DICE_MIN_BET <= bet <= CASINO_DICE_MAX_BET))
        {
            ShowPlayerDialog
            (
                playerid,
                DIALOG_CASINO_TABLE_SETBET,
                DIALOG_STYLE_INPUT,
                "{FF0000}Установки ставки для игры:",
                "Ставка должна быть не менее 1000 рублей и не более 10000000",
                "Далее",
                "Отмена"
            );
            return 1;
        }

        g_casino_table_bet[table_idx] = bet;
        g_casino_table_bet_set[table_idx] = true;
        pInfo[playerid][CasinoDiceBet] = bet;
        ResetCasinoTablePaidPlayers(table_idx);

        RefreshCasinoDicePlayersListForTable(table_idx);
        ShowNotificationLaird(playerid, 3, 6, 0, 0, "Ставка успешно установлена", " ");

        if(pInfo[playerid][CasinoDiceUiOpen]) SelectTextDraw(playerid, 0xFFFF00FF);

        return 1;
    }

    if(dialogid == DIALOG_CASINO_TABLE_TARGET)
    {
        if(!response)
        {
            if(pInfo[playerid][CasinoDiceUiOpen]) SelectTextDraw(playerid, 0xFFFF00FF);
            return 1;
        }

        if(!IsPlayerInRangeOfAnyCasinoTable(playerid))
        {
            HideCasinoDiceUi(playerid);
            return SendClientMessage(playerid, 0x999999FF, "You left the casino table area");
        }

        new target = strval(inputtext);
        if(!IsPlayerConnected(target) || target == playerid)
        {
            SendClientMessage(playerid, 0x999999FF, "Invalid player ID");
            ShowPlayerDialog(playerid, DIALOG_CASINO_TABLE_TARGET, DIALOG_STYLE_INPUT, "Casino: Opponent", "Enter player ID for invite", "Send", "Cancel");
            return 1;
        }

        if(!IsPlayerLogged(target))
        {
            SendClientMessage(playerid, 0x999999FF, "Player is not authorized");
            ShowPlayerDialog(playerid, DIALOG_CASINO_TABLE_TARGET, DIALOG_STYLE_INPUT, "Casino: Opponent", "Enter player ID for invite", "Send", "Cancel");
            return 1;
        }

        new lobby_bet = pInfo[playerid][CasinoDiceBet];
        if(!(1 <= lobby_bet <= CASINO_DICE_MAX_BET)) lobby_bet = CASINO_DICE_MIN_BET;

        new cmd_params[32];
        format(cmd_params, sizeof cmd_params, "%d %d", target, lobby_bet);

        callcmd::dice(playerid, cmd_params);

        HideCasinoDiceUi(playerid);

        return 1;
    }
    if(dialogid == DIALOG_EURO_EXCHANGE)
	{
		if(!response) return 1;
		new amount;
		if(sscanf(inputtext, "d", amount))
		{
			SendClientMessage(playerid, 0xFFFFFFFF, "Введите корректное число");
			return 1;
		}
		if(amount < EURO_EXCHANGE_MIN || amount > EURO_EXCHANGE_MAX)
		{
			new string[128];
			format(string, sizeof(string), "Количество должно быть от %d до %d Евро", EURO_EXCHANGE_MIN, EURO_EXCHANGE_MAX);
			SendClientMessage(playerid, 0xFFFFFFFF, string);
			return 1;
		}
		if(!Euro_HasEnough(playerid, amount))
		{
			SendClientMessage(playerid, 0xFFFFFFFF, "У вас недостаточно Евро");
			return 1;
		}
		Euro_ExchangeToRubles(playerid, amount);
		new rubles = Euro_ToRubles(amount);
		new string[160];
		format(string, sizeof(string), "Вы обменяли %d Евро на %d рублей", amount, rubles);
		SendClientMessage(playerid, 0xFFFFFFFF, string);
		return 1;
   }
    // ================================
    // ?? DIALOG_ID_EDITACS_SELECT
    // ================================
	if(dialogid == DIALOG_ID_EDITACS_SELECT)
    {
        if(!response) return 1; // Нажал "Отмена"

        new slot = -1;
        new tmp = 0;
        
        for(new i = 0; i < MAX_PLAYER_ATTACHED_OBJECTS; i++)
        {
            if(IsPlayerAttachedObjectSlotUsed(playerid, i))
            {
                if(tmp == listitem)
                {
                    slot = i;
                    break;
                }
                tmp++;
            }
        }

        if(slot == -1 || !IsPlayerAttachedObjectSlotUsed(playerid, slot))
        {
            SendClientMessage(playerid, -1, "{FF0000}Ошибка: Неверный слот.");
            return 1;
        }

        SetPVarInt(playerid, "EditingAccSlot", slot);
        ShowEditAccessoryDialog(playerid, slot);
        return 1;
    }

	if (dialogid == DIALOG_MUSIC)
