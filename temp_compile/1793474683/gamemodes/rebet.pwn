//#include "../include/system/mchs.pwn" // legacy MCHS disabled: replaced by firesystem
#include "../include/system/inventory_skin.pwn"
// Full family system transplanted from the working donor gamemode.
stock SendPacketToClientString(playerid, guiid, const json_string[])
{
    new BitStream:bitstream = BS_New();
    BS_WriteValue(bitstream, PR_UINT8, PACKET_BLACKRRPC);
    BS_WriteValue(bitstream, PR_UINT16, guiid);
    new data_len = strlen(json_string);
    BS_WriteValue(bitstream, PR_UINT32, data_len);
    BS_WriteValue(bitstream, PR_STRING, json_string);
    PR_SendPacket(bitstream, playerid, PR_HIGH_PRIORITY, PR_RELIABLE);
    BS_Delete(bitstream);
    return 1;
}

#include "../gamemodes/sile/gui/family/family.pwn"
#include "../gamemodes/sile/gui/family/family_addition.pwn"
#include "../include/system/family_storage_adapter.pwn"
#include "../include/system/family_battle_integrated.inc"

stock FamilyGuiHandlePacket(playerid, Node:request)
{
    return PacketIncomingFamily(playerid, request);
}

stock FamilyHandleInviteNotification(playerid, notify_type, notify_id, notify_sub_id)
{
    #pragma unused playerid
    #pragma unused notify_type
    #pragma unused notify_id
    #pragma unused notify_sub_id
    return 0;
}

#define FAMILY_TUNING_COMPONENT_KEY_BASE (1000000000)

stock GetFamilyCarComponentStorageID(family_car_sql_id)
{
    if(family_car_sql_id <= 0) return 0;
    return FAMILY_TUNING_COMPONENT_KEY_BASE + family_car_sql_id;
}

stock GetVehicleTuningRuntimeIndex(vehicleid)
{
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
        return vehicleid;

    return GetVehicleData(vehicleid, V_ACTION_ID);
}

stock GetVehicleTuningDatabaseID(vehicleid)
{
    new action_id = GetVehicleData(vehicleid, V_ACTION_ID);
    if(GetVehicleData(vehicleid, V_ACTION_TYPE) == VEHICLE_ACTION_TYPE_FAMILY_CAR)
        return GetCarFamily(action_id, CAR_F_database);

    return GetOwnableCarData(action_id, OC_SQL_ID);
}

stock EnsureFamilyCarTuningColumn(const column_name[], const column_definition[])
{
    new query[256];
    mysql_format(mysql, query, sizeof query, "SHOW COLUMNS FROM `family_cars` LIKE '%e'", column_name);
    new Cache:result = mysql_query(mysql, query, true);
    new bool:exists = (cache_num_rows() > 0);
    cache_delete(result);

    if(!exists)
    {
        mysql_format(mysql, query, sizeof query, "ALTER TABLE `family_cars` ADD `%e` %s", column_name, column_definition);
        mysql_query(mysql, query, false);
        if(mysql_errno())
            printf("[FamilyCars][Tuning] Failed to add column %s, mysql errno=%d", column_name, mysql_errno());
    }
    return 1;
}

stock EnsureFamilyCarTuningSchema()
{
    EnsureFamilyCarTuningColumn("vynil_name", "VARCHAR(32) NOT NULL DEFAULT ''");
    EnsureFamilyCarTuningColumn("vinil_current", "INT NOT NULL DEFAULT 0");
