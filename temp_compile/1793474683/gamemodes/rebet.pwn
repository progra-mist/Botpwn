	SendClientMessage(to_player, 0xCECECEFF, ""SC"Время до окончания бана чата: {CCCC00}/time");
	SendClientMessage(to_player, 0xCECECEFF, ""SC"Советуем ознакомится с правилами сервера, чтобы не получать подобных наказаний.");
	ShowNotificationLaird(to_player, 2, 5, 0, 0, "{FFFFFF}У вас имеется активный мут. Время до\n{FFFFFF}разблокировки: {CCCC00}/time", " ");

	format(fmt_msg, sizeof fmt_msg, "Выдал %s[acc:%d] блокировку чата на %d минут. Причина: CapsLock",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), mute_time);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

CMD:sk(playerid, params[])
{

	if(GetPlayerAdminEx(playerid) < 1) return ShowNotificationLaird(playerid, 2, 3, 0, 0, "У вас нет доступа к использованию данной команде", " ");

	if(!strlen(params)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"Используйте: /sk [ID игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	return ShowNotificationLaird(playerid, 2, 4, 0, 0, "Такого игрока нет", " ");

	new jail_time = 30;
	if(GetPlayerData(to_player, P_JAIL) > 0) return SendClientMessage(playerid, 0xCECECEFF, ""SC"Этот игрок уже сидит в тюрьме");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SendClientMessage(playerid, 0xCECECEFF, ""SC"Нельзя посадить в тюрьму администратора выше вашего ранга");
	if(AntiSliv(playerid, "/sk")) return true;

	new fmt_msg[999];
	format(fmt_msg, sizeof fmt_msg, "Администратор %s посадил в тюрьму игрока %s на %d минут", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), jail_time);

	format(fmt_msg, sizeof fmt_msg, "%s. Причина: Spawn Kill (SK)", fmt_msg);

	SendClientMessageToAll(0xFF5533FF, fmt_msg);

	SetPlayerData(to_player, P_JAIL, jail_time * 60);
	UpdatePlayerDatabaseInt(to_player, "jail", jail_time * 60);

	SendClientMessage(to_player, 0xCECECEFF, ""SC"Время до окончания заключения: {CCCC00}/time");
    SendClientMessage(to_player, 0xCECECEFF, ""SC"Советуем ознакомится с правилами сервера, чтобы не получать подобных наказаний.");
    ShowNotificationLaird(to_player, 2, 6, 0, 0, "{FFFFFF}Время до окончания заключения: {CCCC00}/time", "");

	JailPlayer(to_player, jail_time);

	format(fmt_msg, sizeof fmt_msg, "Выдал %s[acc:%d] посадил в тюрьму на %d минут. Причина: SpawnKill",
	GetPlayerNameEx(to_player), GetPlayerAccountID(to_player), jail_time);

	SendLog(playerid, LOG_TYPE_ADMIN_ACTION, fmt_msg);

	return 1;
}

stock GetPlayerStatus(level, status[], size)
{
    if(level < 5)
        format(status, size, "{4CAF50}Развивающийся");
    else if(level < 10)
        format(status, size, "{8BC34A}Новичок");
    else if(level < 15)
        format(status, size, "{03A9F4}Опытный");
    else if(level < 20)
        format(status, size, "{2196F3}Продвинутый");
    else if(level < 25)
        format(status, size, "{FF9800}Профессионал");
    else if(level < 30)
        format(status, size, "{9C27B0}Ветеран");
    else if(level < 40)
        format(status, size, "{FFD700}Элита");
    else if(level < 50)
        format(status, size, "{F44336}Легенда");
    else
        format(status, size, "{B71C1C}Император");
    return 1;
}
stock SendAdminMessage(color, const text[])
{
    foreach(new i : Player)
    {
        if(GetPlayerAdminEx(i) > 1)
        {
            SendClientMessage(i, color, text);
        }
    }
    return 1;
}
CMD:fuelfill(playerid, params[])
{
    #pragma unused params

    new vehicleid = GetPlayerVehicleID(playerid);
    new stationid = GetNearestFuelStation(playerid, 10.0);

    return AZC_ShowFuelStation(playerid, vehicleid, stationid);
}

forward WoundForceRespawn(playerid);
public WoundForceRespawn(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(GetPVarInt(playerid, "WoundActive") != 1 || GetPVarInt(playerid, "WoundHospital") != 0) return 1;

    // If OnPlayerSpawn already ran naturally, do not spawn a second time.
    if(GetPVarInt(playerid, "WoundSpawnDone") == 1) return 1;

    SpawnPlayer(playerid);
    return 1;
}

forward WoundStabilizeAfterSpawn(playerid);
public WoundStabilizeAfterSpawn(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(GetPVarInt(playerid, "WoundActive") != 1 || GetPVarInt(playerid, "WoundHospital") != 0) return 1;

    new Float:wound_x = GetPVarFloat(playerid, "WoundX");
    new Float:wound_y = GetPVarFloat(playerid, "WoundY");
    new Float:wound_z = GetPVarFloat(playerid, "WoundZ");
    new Float:wound_a = GetPVarFloat(playerid, "WoundA");

    SetPlayerInterior(playerid, GetPVarInt(playerid, "WoundInterior"));
    SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "WoundVW"));
    SetPlayerPos(playerid, wound_x, wound_y, wound_z + 0.15);
    SetPlayerFacingAngle(playerid, wound_a);

    // Kill the native death camera after the client has completed its spawn.
    SetCameraBehindPlayer(playerid);
    TogglePlayerControllable(playerid, false);

    PreloadAnimLib(playerid, "SWAT");
    ClearAnimations(playerid);
    ApplyAnimation(playerid, "SWAT", "gnstwall_injurd", 4.1, 1, 1, 1, 1, 0, 1);
    return 1;
}

forward CheckWoundTimer();
public CheckWoundTimer()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && GetPVarInt(i, "WoundActive") == 1)
        {
            new timer = GetPVarInt(i, "WoundTimer");
            if(gettime() >= timer) // Если 30 секунд истекли
            {
                SpawnPlayerKmonarch(i); // Отправляем в больницу автоматически
            }
        }
    }
    return 1;
}

CMD:wound(playerid, params[])
{
    ShowWoundSystem(playerid);
    return 1;
}

stock ShowWoundSystem(playerid, killerid = INVALID_PLAYER_ID)
{
    if(!IsPlayerConnected(playerid)) return 0;

    // Save the actual death point before the client requests a respawn. Without
    // this the old code used SetPlayerSpawnInit() and sent the player to a random spawn.
    new Float:wound_x, Float:wound_y, Float:wound_z, Float:wound_a;
    GetPlayerPos(playerid, wound_x, wound_y, wound_z);
    GetPlayerFacingAngle(playerid, wound_a);

    SetPVarFloat(playerid, "WoundX", wound_x);
    SetPVarFloat(playerid, "WoundY", wound_y);
    SetPVarFloat(playerid, "WoundZ", wound_z);
    SetPVarFloat(playerid, "WoundA", wound_a);
    SetPVarInt(playerid, "WoundInterior", GetPlayerInterior(playerid));
    SetPVarInt(playerid, "WoundVW", GetPlayerVirtualWorld(playerid));

    SetSpawnInfo
    (
        playerid,
        0,
        GetPlayerSkinEx(playerid),
        wound_x,
        wound_y,
        wound_z + 0.15,
        wound_a,
        0, 0, 0, 0, 0, 0
    );

    SetPVarInt(playerid, "WoundActive", 1);
    SetPVarInt(playerid, "WoundTimer", gettime() + 30);
    SetPVarInt(playerid, "WoundHospital", 0);
    SetPVarInt(playerid, "WoundSpawnDone", 0);

    // GUI packet itself is centralized in ShowWoundGUI so real deaths and admin HP tests
    // use exactly the same client interface.
    ShowWoundGUI(playerid, killerid);

    // Start/restart the wounded state. For real deaths this will be applied again
    // after the forced respawn; for /wound and admin HP tests it works immediately.
    PreloadAnimLib(playerid, "SWAT");
    SetCameraBehindPlayer(playerid);
    TogglePlayerControllable(playerid, false);
    ApplyAnimation(playerid,
        "SWAT",
        "gnstwall_injurd",
        4.1,
        1,
        1,
        1,
        1,
        0,
        1
    );

    return 1;
}



stock SpawnPlayerKmonarch(playerid)
{
    // 1. Сбрасываем переменные стадии смерти СРАЗУ
    SetPVarInt(playerid, "WoundActive", 0);
    SetPVarInt(playerid, "WoundTimer", 0);
    SetPVarInt(playerid, "WoundHospital", 1);

    // 2. Принудительно закрываем GUI смерти на экране
    HidePlayerGUI(playerid, 40);

    // 3. Очищаем все анимации стадии смерти и размораживаем игрока
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);
    SetCameraBehindPlayer(playerid);

   // Сначала телепорт
    SetPlayerPos(playerid, 1484.7207, 2493.9463, 2501.0403);
    SetPlayerFacingAngle(playerid, 0.8286);

    // Потом мир и интерьер
    SetPlayerInterior(playerid, 1);
    SetPlayerVirtualWorld(playerid, 1);

    printf("[KMONARCH] VW=%d INT=%d",
    GetPlayerVirtualWorld(playerid),
    GetPlayerInterior(playerid)
    );
    // 6. Устанавливаем здоровье на 15.0 (для прохождения лечения)
    SetPlayerHealth(playerid, 15.0);
    SetPlayerArmour(playerid, 0.0);

    #if defined P_HOSPITAL
        SetPlayerData(playerid, P_HOSPITAL, false);
    #endif


    SendClientMessage(playerid, 0xFFFF00FF, "Вы были успешно доставлены в больницу! Пройдите курс лечения.");
    return 1;
}
stock CreateAllDPSPosts()
{
    CreateDPSPost(1635.563354, -598.572753, 39.368892, 50.0);
