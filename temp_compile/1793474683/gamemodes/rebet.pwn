            JSON_GetInt(json, "os", os);
            JSON_GetInt(json, "ns", ns);
            JSON_GetInt(json, "s", raw_s);
            JSON_GetInt(json, "sl", raw_sl);
            JSON_GetInt(json, "v", value);
            JSON_GetInt(json, "i", raw_i);
            JSON_GetInt(json, "a", raw_a);

            if(value <= 0) value = raw_i;
            if(value <= 0) value = raw_a;
            if(value <= 0) value = 1;

            new client_os = os;
            new client_ns = ns;

