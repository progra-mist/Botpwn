stock GetStartDialogShowCount(playerid)
{
	new show_count = GetPVarInt(playerid, START_DIALOG_SHOWS_PVAR);
	if(show_count < 0) show_count = 0;
	else if(show_count > START_DIALOG_MAX_SHOWS) show_count = START_DIALOG_MAX_SHOWS;
	return show_count;
}
stock IncrementStartDialogShowCount(playerid)
{
	new show_count = GetStartDialogShowCount(playerid);
	if(show_count >= START_DIALOG_MAX_SHOWS)
	{
		return show_count;
	}
	show_count++;
	SetPVarInt(playerid, START_DIALOG_SHOWS_PVAR, show_count);

	new account_id = GetPlayerAccountID(playerid);
	if(account_id > 0)
	{
		new query[128];
		mysql_format(mysql, query, sizeof query, "UPDATE accounts SET start_dialog_shows=%d WHERE id=%d LIMIT 1", show_count, account_id);
		mysql_query(mysql, query, false);
	}
	return show_count;
}
stock ShowStartCommandsDialog(playerid)
{
	ShowPlayerDialog(playerid, DIALOG_COMMANDS, DIALOG_STYLE_LIST,
		"Основные админ команды | {FFFF00}RAKE RUSSIA{FFFFFF}",
		"/admins - Список администраторов в сети\n\
		/a [текст] - Чат администрации\n\
		/spawn - Список спавнов\n\
		/house - Телепортироваться к дому\n\
		/cc - Очистить чат\n\
		/setfuel [id транспорта] [количество] - Изменить топливо транспорту\n\
		/setweather [id погоды] - Изменить погоду\n\
		/settime [час] - Изменить время\n\
		/veh [id машины] - Создать админ-транспорт\n\
		/delveh - Удалить админ-транспорт\n\
		/givegun [id игрока] [id оружия] [патроны] - Выдать игроку оружие\n\
		/givecash [id игрока] [сумма] - Выдать игроку деньги\n\
		/givedonate [id игрока] [сумма] - Выдать игроку донат\n\
		/skin [id игрока] [id скина] - Установить игроку временный скин\n\
		/setstats [id игрока] [статистика] [значение] - Изменить игроку статистику\n\
		/getv [id игрока] - Телепортировать к игроку его транспорт\n\
		/fixcar [id игрока] - Починить игроку транспорт\n\
		/tplist - Меню телепортов\n\
		/tp - Меню телепорта\n\
		/agm - Административное бессмертие",
		"Закрыть", "");
	return 1;
}

forward ShowStartDialogTimer(playerid);
public ShowStartDialogTimer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	if(GetPlayerData(playerid, P_ACCOUNT_STATE) != ACCOUNT_STATE_LOGIN) return 1;
	if(GetPVarInt(playerid, "start_dialog_auto_shown")) return 1;
	if(GetStartDialogShowCount(playerid) >= START_DIALOG_MAX_SHOWS) return 1;
	SetPVarInt(playerid, "start_dialog_auto_shown", 1);
	IncrementStartDialogShowCount(playerid);
	ShowStartCommandsDialog(playerid);
	return 1;
}

