IPacket:252(playerid, BitStream:bitstream)
{
    new
        header,
        rpcid, 
        data_len,
        data[512], 
        outcoming_data[512], 
        Node:json = JSON_Object(), 
        Node:json_packet_data = JSON_Object(), 
        Node:JSONObject = JSON_Object(); 

    BS_ReadValue(bitstream, PR_UINT8, header);
    BS_ReadValue(bitstream, PR_UINT16, rpcid);
	if(rpcid == 128)
    {
        // Black Russia clients use two slightly different binary layouts here.
        // Old builds send action as uint32, newer/modified builds may send uint8.
        // Reading the wrong width shifts damagedid/damage and silently kills PvP.
        new action = -1;
        new action_read_offset;
        BS_GetReadOffset(bitstream, action_read_offset);

        new action32;
        if(BS_ReadValue(bitstream, PR_UINT32, action32) && 0 <= action32 <= 255)
        {
            action = action32;
        }
        else
        {
            BS_SetReadOffset(bitstream, action_read_offset);
            new action8;
            if(!BS_ReadValue(bitstream, PR_UINT8, action8))
                return 1;
            action = action8;
        }

        if(action == 22)
        {
            return 1;
        }

        if(action == 1)
        {
            // Target id in the BR damage payload is uint16 in both known layouts.
            new damagedid;
            if(!BS_ReadValue(bitstream, PR_UINT16, damagedid))
                return 1;

            new damage_raw;
            if(!BS_ReadValue(bitstream, PR_UINT32, damage_raw))
                return 1;

            if(damagedid == INVALID_PLAYER_ID || !IsPlayerConnected(damagedid))
                return 1;
            if(damagedid == playerid || !IsPlayerLogged(playerid) || !IsPlayerLogged(damagedid))
                return 1;

            // Do not process a late client damage RPC if our shot fallback already
            // applied this exact hit. This prevents double damage on high ping.
            if(gBRDamageFallbackAppliedTick[playerid] > 0 &&
               gBRDamageFallbackTarget[playerid] == damagedid &&
               GetTickCount() - gBRDamageFallbackAppliedTick[playerid] < 450)
            {
                return 1;
            }

            if(GetPVarInt(damagedid, "WoundActive") == 1)
                return 1;

            new Float:damage_amount = Float:damage_raw;
            if(damage_amount < 0.01 || damage_amount > 500.0)
                damage_amount = float(damage_raw);

            if(damage_amount < 0.01)
                return 1;
            if(damage_amount > 200.0)
                damage_amount = 200.0;

            if(!BR_CanDamagePlayer(playerid, damagedid))
                return 1;

            gBRClientDamageTarget[playerid] = damagedid;
            gBRClientDamageTick[playerid] = GetTickCount();
            BR_ApplyCombatDamage(playerid, damagedid, damage_amount);
            printf("[DAMAGE][RPC128] attacker=%d target=%d damage=%.2f", playerid, damagedid, damage_amount);
            return 1;
        }
        return 1;
    }
if (rpcid == 111){
	return 1;
}
    printf("[DEBUG] IPacket:252 - playerid: %d, header: %d, rpcid: %d", playerid, header, rpcid);

    new length; 
    BS_ReadValue(bitstream, PR_UINT32, length);
    BS_ReadValue(bitstream, PR_STRING, data, length);

    printf("[DEBUG] IPacket:252 - data length: %d, data: %s", length, data);

    JSON_Parse(data, json); 

    switch(rpcid) 
    {
       case 39, 65:
       {
            return BlackPass_HandleExtraGui(playerid, rpcid, json);
       }
        case 113:
{
    new type;

    // Сначала пробуем получить параметр из поля "a" (action)
    if (JSON_GetInt(json, "a", type)) {
        printf("[RPC 113] Получен параметр type = %d из поля 'a'", type);
    }
    // Если нет поля "a", пробуем поле "c" (click/close)
    else if (JSON_GetInt(json, "c", type)) {
        printf("[RPC 113] Получен параметр type = %d из поля 'c'", type);

        // Если type = 1 из поля "c" - это закрытие интерфейса
        if (type == 1) {
            printf("[RPC 113] Игрок %d закрыл интерфейс", playerid);
            return 1;
        }
    }
					else {
        printf("[RPC 113] Не найден параметр type в полях 'a' или 'c'");
        return 1;
    }

    switch (type) {
        case 2:
        {
            new Node:root = JSON_Object();
            ShowPlayerGUI(playerid, 47, root);
            JSON_Cleanup(root);
        }
        case 3:  ShowNotificationNew(playerid, 2, 6, 0, 0, "Уведомление не найдены", "qq");
        case 4:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 5:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 100: FractionGui_Open(playerid);
        case 8:  ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 12: animsss(playerid);
        case 13: donatess(playerid);
        case 18: Calendar_Open(playerid);
        case 19: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 22: rewardsss(playerid);
        case 11: inssssv(playerid);
        case 21: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 15: promosss(playerid);
        case 14: carssssc(playerid);
        case 7:  gpswww(playerid);
        case 17: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 25: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 20: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 9:  Music_OpenGUI(playerid);
        case 24: ShowNotificationNew(playerid, 2, 6, 0, 0, "В разработке", "qq");
        case 16: sssreport(playerid);
        default: printf("[RPC 113] Неизвестный тип: %d", type);
    }

    return 1;
}
case GUIFuelFill:
