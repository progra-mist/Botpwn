CMD:setstage(playerid, params[])
{
   new vehicleid = GetPlayerVehicleID(playerid);
  
    if(!IsPlayerDriver(playerid))
      return SendClientMessage(playerid, 0xCECECEFF, "Вы не за рулем");
  

  extract params -> new stage; else return SendClientMessage(playerid, 0xCECECEFF, "Используйте: /setstage [уровень стейджа(1-3)]");

   if(stage == 1)
   {
   new vehicleid = GetPlayerVehicleID(playerid);
        new Float: v_speed = GetVehicleSpeed(vehicleid);
        if(GetPlayerMoneyEx(playerid) < 50000) return ShowNotification(playerid, 2, "У вас недостаточно средств!", 4, "", "");
             GivePlayerMoneyEx(playerid, -10);
        SetVehicleMaxSpeed(vehicleid, 300);
              ShowNotification(playerid, 3, "Вы успешно приобрели стейдж 1 уровня!", 3, "", "");
   }
					else if(stage == 2)
   {
   new vehicleid = GetPlayerVehicleID(playerid);
        new Float: v_speed = GetVehicleSpeed(vehicleid);
        if(GetPlayerMoneyEx(playerid) < 150000) return ShowNotification(playerid, 2, "У вас недостаточно средств!", 4, "", "");
             GivePlayerMoneyEx(playerid, -10);
        SetVehicleMaxSpeed(vehicleid, 340);
              ShowNotification(playerid, 3, "Вы успешно приобрели стейдж 2 уровня!", 3, "", "");
   }
					else if(stage == 3)
   {
   new vehicleid = GetPlayerVehicleID(playerid);
        new Float: v_speed = GetVehicleSpeed(vehicleid);
        if(GetPlayerMoneyEx(playerid) < 250000) return ShowNotification(playerid, 2, "У вас недостаточно средств!", 4, "", "");
             GivePlayerMoneyEx(playerid, -10);
        SetVehicleMaxSpeed(vehicleid, 370);
              ShowNotification(playerid, 3, "Вы успешно приобрели стейдж 3 уровня!", 3, "", "");
   }
 return 1;
 }

forward RestartServer();

public RestartServer()
{
	SendClientMessageToAll(-1, " {CA0303} Уважаемые игроки сейчас произойдет перезапуск сервера!");

	foreach(new i : Player)
	{
		OnPlayerDisconnect(i, 0);
	}

	server_restart = true;
	return GameModeExit();
}

CMD:RentCarScooterBR(playerid)
{
ShowRentMenu(playerid);
}

CMD:disarm(playerid, params[])
{
    if(!strcmp(params, "all", true))
    {
        for(new i = 0; i < MAX_PLAYERS; i++)
            if(IsPlayerConnected(i))
                ResetPlayerWeapons(i);
                
        SendClientMessageToAll(-1, "Оружие у всех игроков было убрано.");
        return 1;
    }
    
    ResetPlayerWeapons(playerid);
    SendClientMessage(playerid, -1, "Вы сняли с себя всё оружие.");
    return 1;
}

