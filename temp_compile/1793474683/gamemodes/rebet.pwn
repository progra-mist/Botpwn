							RemovePlayerFromVehicle(playerid);
							SendClientMessage(playerid, 0xCECECEFF, "Вы не автомеханик");
						}
					}*/
					case VEHICLE_ACTION_TYPE_TRUCKER: // Дальнобойщик
					{
						if(TCompany_IsVehicle(vehicleid))
						{
							if(!TCompany_CanUseVehicle(playerid, vehicleid))
							{
								RemovePlayerFromVehicle(playerid);
								SendClientMessage(playerid, 0xCECECEFF, "Эта фура принадлежит другой транспортной компании");
							}
							else
							{
								if(GetPlayerJob(playerid) != JOB_TRUCKER)
								{
									SetPlayerData(playerid, P_JOB, JOB_TRUCKER);
									UpdatePlayerDatabaseInt(playerid, "job", JOB_TRUCKER);
								}
								SetPlayerData(playerid, P_JOB_CAR, vehicleid);
								KillEndJobTimer(playerid);
								SendClientMessage(playerid, 0x66CC00FF, "Корпоративная фура ТК. Для начала работы нажмите ~k~~TOGGLE_SUBMISSIONS~");
							}
						}
						else if(GetPlayerJob(playerid) == JOB_TRUCKER)
						{
							new job_car = GetPlayerJobCar(playerid);

