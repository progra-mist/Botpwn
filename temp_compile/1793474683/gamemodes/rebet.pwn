	    	0,
	    	0
	    );
		return 1;
	}

	if(listitem == 1)
	{
		SetPlayerPosEx(
	    	playerid,
	    	498.552,
			2497.555,
			1501.7,
	    	90,
	    	1,
	    	houseid
	    );
	}
	return 1;
}



stock ProcessPlayerBasementNewPickupExit(playerid, houseid, listitem)
