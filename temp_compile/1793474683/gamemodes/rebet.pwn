				PlayerTextDrawSetString(playerid, speedometr_PTD[playerid][2], fmt_str);

				format(fmt_str, sizeof fmt_str, "%d %", floatround(health / 10));
				PlayerTextDrawSetString(playerid, speedometr_PTD[playerid][3], fmt_str);
				
