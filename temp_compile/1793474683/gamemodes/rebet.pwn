stock DestroySaleFlatPickups()
{
    for (new i = 0; i < FLATS_FOR_SALE_COUNT; i++)
    {
        if (gFlatSalePickup[i] != 0)
        {
            DestroyPickup(gFlatSalePickup[i]);
            gFlatSalePickup[i] = 0;
        }
    }
    return 1;
}

stock DestroySaleHousePickups()
{
    for (new i = 0; i < HOUSES_FOR_SALE_COUNT; i++)
    {
        if (gHouseSalePickup[i] != 0)
        {
            DestroyPickup(gHouseSalePickup[i]);
            gHouseSalePickup[i] = 0;
        }
    }
    return 1;
}

stock DestroyAllSaleRealtyPickups()
{
    DestroySaleHousePickups();
    return 1;
}

stock SendVehicleTurnLight(playerid, vehicleid, status)
{
    new BitStream:bs = BS_New();

    // Custom client packet:
    // uint8  12       - packet type
    // uint16 vehicle  - network vehicle id
    // uint8  status   - 0 off, 1 left, 2 right, 3 hazard
    BS_WriteValue(bs, PR_UINT8, 12);
    BS_WriteValue(bs, PR_UINT16, vehicleid);
    BS_WriteValue(bs, PR_UINT8, status);

    PR_SendPacket(bs, playerid, PR_HIGH_PRIORITY, PR_RELIABLE_ORDERED);
    BS_Delete(bs);
    return 1;
}

stock SendVehicleTurnLightForAll(vehicleid, status)
{
    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if(!IsPlayerConnected(playerid)) continue;
        SendVehicleTurnLight(playerid, vehicleid, status);
    }
    return 1;
}

stock ResetVehicleTurnSignalData(vehicleid)
{
    if(vehicleid < 0 || vehicleid >= MAX_VEHICLES) return 1;

    TurnSignalState[vehicleid] = 0;
    TurnSignalBlinkOn[vehicleid] = false;
    TurnSignalDriver[vehicleid] = INVALID_PLAYER_ID;
    TurnSignalModel[vehicleid] = 0;
    return 1;
}

stock StopVehicleTurnSignal(vehicleid)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;

    if(IsValidVehicle(vehicleid))
    {
        SendVehicleTurnLightForAll(vehicleid, 0);
    }

    ResetVehicleTurnSignalData(vehicleid);
    return 1;
}

stock StartVehicleTurnSignal(playerid, vehicleid, status)
{
    if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 0;
    if(status < 1 || status > 3) return 0;
    if(!IsValidVehicle(vehicleid)) return 0;

    TurnSignalState[vehicleid] = status;
    TurnSignalBlinkOn[vehicleid] = true;
    TurnSignalDriver[vehicleid] = playerid;
    TurnSignalModel[vehicleid] = GetVehicleModel(vehicleid);

    SendVehicleTurnLightForAll(vehicleid, status);
    return 1;
}

stock StopPlayerVehicleTurnSignal(playerid)
{
    for(new vehicleid = 1; vehicleid < MAX_VEHICLES; vehicleid++)
    {
        if(TurnSignalDriver[vehicleid] != playerid) continue;
        StopVehicleTurnSignal(vehicleid);
    }
    return 1;
}

forward UpdateVehicleTurnSignals();
public UpdateVehicleTurnSignals()
{
    for(new vehicleid = 1; vehicleid < MAX_VEHICLES; vehicleid++)
    {
        if(TurnSignalState[vehicleid] < 1 || TurnSignalState[vehicleid] > 3) continue;

        if(!IsValidVehicle(vehicleid))
        {
            ResetVehicleTurnSignalData(vehicleid);
            continue;
        }

        new driverid = TurnSignalDriver[vehicleid];

        if(driverid == INVALID_PLAYER_ID || !IsPlayerConnected(driverid))
        {
            StopVehicleTurnSignal(vehicleid);
            continue;
        }

        if(GetPlayerState(driverid) != PLAYER_STATE_DRIVER)
        {
            StopVehicleTurnSignal(vehicleid);
            continue;
        }

        if(GetPlayerVehicleID(driverid) != vehicleid)
        {
            StopVehicleTurnSignal(vehicleid);
            continue;
        }

        if(GetVehicleModel(vehicleid) != TurnSignalModel[vehicleid])
        {
            StopVehicleTurnSignal(vehicleid);
            continue;
        }

        if(TurnSignalBlinkOn[vehicleid])
        {
            TurnSignalBlinkOn[vehicleid] = false;
            SendVehicleTurnLightForAll(vehicleid, 0);
        }
        else
        {
            TurnSignalBlinkOn[vehicleid] = true;
            SendVehicleTurnLightForAll(vehicleid, TurnSignalState[vehicleid]);
        }
    }
    return 1;
}

public OnIncomingRPC(playerid, rpcid, BitStream:bs)
{
    if (rpcid == 97)
    {
        new firstValue;

        if (!BS_ReadUint32(bs, firstValue))
            return 1;

        // Ветка урона машины
        // Vehicle turn signals from the custom client.
        // action 3: uint16 vehicleid, uint8 status (1 left / 2 right / 3 hazard)
        if (firstValue == 3)
        {
            new vehicleid;
            new turnStatus;

            if(!BS_ReadUint16(bs, vehicleid)) return 1;
            if(!BS_ReadUint8(bs, turnStatus)) return 1;

            if(vehicleid <= 0 || vehicleid >= MAX_VEHICLES) return 1;
            if(!IsValidVehicle(vehicleid)) return 1;
            if(GetPlayerVehicleID(playerid) != vehicleid) return 1;
            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
            if(turnStatus < 1 || turnStatus > 3) return 1;

            if(TurnSignalState[vehicleid] == turnStatus && TurnSignalDriver[vehicleid] == playerid)
            {
                StopVehicleTurnSignal(vehicleid);
            }
            else
            {
                StopVehicleTurnSignal(vehicleid);
                StartVehicleTurnSignal(playerid, vehicleid, turnStatus);
            }
            return 1;
        }

        if (firstValue == 1)
        {
            new vehicleNetId;
            new Float:damage;
            new damagedPiece;

            if (!BS_ReadUint16(bs, vehicleNetId)) return 1;
            if (!BS_ReadFloat(bs, damage)) return 1;
            if (!BS_ReadUint16(bs, damagedPiece)) return 1;

            new vehicleid = vehicleNetId;
            if (vehicleid != INVALID_VEHICLE_ID)
            {
                new tick = GetTickCount();

                if (tick - gLastVehicleDamageTick[playerid] < 600)
                    return 0;

                gLastVehicleDamageTick[playerid] = tick;

                ApplyVehicleDamage(playerid, vehicleid, damage, damagedPiece);
            }
            return 1;
        }

        // Иначе firstValue = action
        new action = firstValue;
        new actionSubtype;

        if (action == 14)
        {
            if (!BS_ReadUint8(bs, actionSubtype))
                return 1;

            switch (actionSubtype)
            {
                case 0:
                {
                    BlackPass_OpenTasksScreen(playerid);
                }
                case 1:
                {
                    BlackPass_OpenTasksScreen(playerid);
                }
                case 2:
                {
                    callcmd::donate(playerid);
                }
                case 3:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 4:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 5:
                {
                    ShowPlayerDialog_Example(playerid);
                }
                case 6:
                {
                    ShowPlayerDialog_Example(playerid);
                }
            }
        }

        switch (action)
        {
            case 3:
            {
            }
            case 4:
            {
                callcmd::radial(playerid);
            }
            case 18:
            {
                if(IsPlayerNearPierCaptain(playerid))
                {
                    ToggleInteractionWindow(playerid, false);
                    return callcmd::vodoact(playerid, "");
                }

                if(IsPlayerNearMedBed(playerid))
                {
                    return callcmd::medbed(playerid, "");
                }

             if(IsPlayerNearHelper(playerid))
                {
                    return callcmd::help(playerid, "");
                }
                
                 if(IsPlayerNearMikhail(playerid))
                {
                    return callcmd::quest(playerid, "");
                }
                
                if(IsPlayerAtATM(playerid))
                {
                    return callcmd::bankomat(playerid, "");
                }

                if (IsPlayerInRangeOfAnyCasinoTable(playerid))
                {
                    return ShowCasinoDiceUi(playerid);
                }

                if (IsPlayerInRangeOfAnyBlackJackTable(playerid))
                {
                    return callcmd::blackjack(playerid);
                }

                if(IsPlayerNearMotoSalonRange(playerid))
                {
                    DebugMotoSalonLog(playerid, "Interaction:MOTO_RANGE:open_market");
                    ToggleInteractionWindow(playerid, false);
                    return EnterPlayerBuyCarMarket(playerid, STATIC_BIZ_ID_MOTO_SALON);
                }

                return 1;
            }
        }

        return 1;
    }

    return 1;
}
CMD:rewardd(playerid)
{
