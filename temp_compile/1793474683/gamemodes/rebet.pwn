stock MultiplyVehicleMoveSpeed(vehicleid, Float:multiplier)
{
    new Float:vx, vy, vz;
    GetVehicleVelocity(vehicleid, vx, vy, vz);

    new Float:rotation;
    GetVehicleZAngle(vehicleid, rotation); // градусы

    new Float:add = 0.002;

    // sin() и cos() в Pawn
    new Int:angle = floatround(rotation); // градусы в int
    new Int:sinval = floatsin(angle); // -32768..32767
    new Int:cosval = floatcos(angle);

    new Float:sx = sinval / 32768.0; // -1.0..1.0
    new Float:sy = cosval / 32768.0;

    if (sx < 0.0) vx += add;
    else          vx -= add;

    if (sy < 0.0) vy += add;
    else          vy -= add;

    SetVehicleVelocity(vehicleid, vx, vy, vz);
}
stock MultiplyVehicleMoveSpeeds(vehicleid, Float:multiplier)
{
    new Float:vx, vy, vz;
    GetVehicleVelocity(vehicleid, vx, vy, vz);

    new Float:rotation;
    GetVehicleZAngle(vehicleid, rotation); // градусы

    new Float:add = 0.002;

    // sin() и cos() в Pawn
    new Int:angle = floatround(rotation); // градусы в int
    new Int:sinval = floatsin(angle); // -32768..32767
    new Int:cosval = floatcos(angle);

    new Float:sx = sinval / 32768.0; // -1.0..1.0
    new Float:sy = cosval / 32768.0;

    if (sx < 0.0) vx += add;
    else          vx -= add;

    if (sy < 0.0) vy += add;
    else          vy -= add;

    SetVehicleVelocity(vehicleid, 1000, 1000, vz);
}

stock WeaponShop_ForceClientAmmoReload(playerid)
{
    new weaponid = GetPlayerWeapon(playerid);
    if(!(22 <= weaponid <= 34)) return 0;

    new ammo = GetPlayerAmmo(playerid);
    new weapon_state = GetPlayerWeaponState(playerid);
    if(ammo > 1 && weapon_state != 0 && weapon_state != 1) return 0;

    new tick = GetTickCount();
    if(GetPVarInt(playerid, "weapon_ammo_resync_tick") > tick) return 0;

    if(ammo <= 0 && GetPVarInt(playerid, "weapon_shop_last_weapon") == weaponid)
    {
        ammo = GetPVarInt(playerid, "weapon_shop_last_ammo");
    }
    if(ammo <= 1) return 0;

    SetPVarInt(playerid, "weapon_ammo_resync_tick", tick + 500);
    SetPVarInt(playerid, "weapon_shop_last_weapon", weaponid);
    SetPVarInt(playerid, "weapon_shop_last_ammo", ammo);

    SetPlayerAmmo(playerid, weaponid, ammo);
    SetPlayerArmedWeapon(playerid, weaponid);
    return 1;
}

#define FSTATE_NONE        0
#define FSTATE_DRIFT       1
#define FSTATE_COMFORT     2
#define FSTATE_SPORT       3
#define FSTATE_SPORT_PLUS  4

// -----------------------------------------------------------------------------
// PvP damage compatibility layer.
// Some Black Russia client builds deliver hit damage through custom packet 252 / RPC 128,
// while others rely on normal SA-MP bullet/damage sync. We support both and only use the
// server-side shot fallback when no health/armour change arrived from the client.
// -----------------------------------------------------------------------------
stock bool:BR_CanDamagePlayer(attackerid, targetid)
{
    if(attackerid < 0 || attackerid >= MAX_PLAYERS || targetid < 0 || targetid >= MAX_PLAYERS)
        return false;
    if(attackerid == targetid || !IsPlayerConnected(attackerid) || !IsPlayerConnected(targetid))
        return false;
    if(!IsPlayerLogged(attackerid) || !IsPlayerLogged(targetid))
        return false;
    if(GetPVarInt(targetid, "WoundActive") == 1)
        return false;
    if(GetPlayerVirtualWorld(attackerid) != GetPlayerVirtualWorld(targetid))
        return false;
    if(GetPlayerInterior(attackerid) != GetPlayerInterior(targetid))
        return false;

    new green_zone_value = GetPVarInt(targetid, "player_in_green_zone");
    if(green_zone_value)
    {
        new green_zone_id = green_zone_value - 1;
        if(0 <= green_zone_id < sizeof(g_green_zones))
        {
            if(g_green_zones[green_zone_id][GZ_NO_WEAPON] || !(TEAM_DPS <= GetPlayerTeamEx(attackerid) <= TEAM_FBI))
                return false;
        }
    }
    return true;
}

stock Float:BR_GetWeaponDamage(weaponid)
{
    switch(weaponid)
    {
        case 22: return 8.25;   // Colt 45
        case 23: return 13.20;  // Silenced
        case 24: return 46.20;  // Deagle
        case 25: return 49.50;  // Shotgun
        case 26: return 49.50;  // Sawnoff
        case 27: return 39.60;  // Combat shotgun
        case 28: return 6.60;   // UZI
        case 29: return 8.25;   // MP5
        case 30: return 9.90;   // AK47
        case 31: return 9.90;   // M4
        case 32: return 6.60;   // Tec9
        case 33: return 24.75;  // Rifle
        case 34: return 41.25;  // Sniper
    }
    return 0.0;
}

stock BR_ApplyCombatDamage(attackerid, targetid, Float:damage_amount)
{
    if(damage_amount <= 0.0 || !BR_CanDamagePlayer(attackerid, targetid))
        return 0;

    if(damage_amount > 200.0)
        damage_amount = 200.0;

    new Float:armour, Float:health;
    GetPlayerArmour(targetid, armour);
    GetPlayerHealth(targetid, health);

    if(armour > 0.0)
    {
        if(armour >= damage_amount)
        {
            armour -= damage_amount;
            damage_amount = 0.0;
        }
        else
        {
            damage_amount -= armour;
            armour = 0.0;
        }
        SetPlayerArmour(targetid, armour);
    }

    if(damage_amount > 0.0)
    {
        health -= damage_amount;
        if(health < 0.0) health = 0.0;
        SetPlayerHealthEx(targetid, health, false);
    }
    return 1;
}

forward BR_DamageFallback(playerid, targetid, weaponid, shot_tick, Float:before_health, Float:before_armour);
public BR_DamageFallback(playerid, targetid, weaponid, shot_tick, Float:before_health, Float:before_armour)
{
    if(!BR_CanDamagePlayer(playerid, targetid))
        return 1;

    // A native/client-side damage event for this shot already reached the server.
    if(gBRClientDamageTarget[playerid] == targetid && gBRClientDamageTick[playerid] >= shot_tick)
        return 1;

    new Float:health_now, Float:armour_now;
    GetPlayerHealth(targetid, health_now);
    GetPlayerArmour(targetid, armour_now);

    // If HP changed for a reason other than one of our own fallbacks, native damage
    // already worked and we do not add another hit. The own-fallback exception is
    // important for UZI/MP5/Tec9 where several timers can overlap.
    if((health_now < before_health - 0.10 || armour_now < before_armour - 0.10) &&
       !(gBRDamageFallbackTarget[playerid] == targetid && gBRDamageFallbackAppliedTick[playerid] >= shot_tick))
        return 1;

    new Float:damage = BR_GetWeaponDamage(weaponid);
    if(damage <= 0.0)
        return 1;

    gBRDamageFallbackTarget[playerid] = targetid;
    gBRDamageFallbackAppliedTick[playerid] = GetTickCount();
    BR_ApplyCombatDamage(playerid, targetid, damage);

    printf("[DAMAGE][FALLBACK] attacker=%d target=%d weapon=%d damage=%.2f", playerid, targetid, weaponid, damage);
    return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    #pragma unused fX, fY, fZ

    if(hittype == BULLET_HIT_TYPE_PLAYER && 22 <= weaponid <= 34 && IsPlayerConnected(hitid) && BR_CanDamagePlayer(playerid, hitid))
    {
        new Float:before_health, Float:before_armour;
        GetPlayerHealth(hitid, before_health);
        GetPlayerArmour(hitid, before_armour);

        // Give the native/custom damage packet a moment to arrive. Only if it does not
        // change HP/armour do we apply the server-side fallback.
        new shot_tick = GetTickCount();
        SetTimerEx("BR_DamageFallback", 120, false, "iiiiff", playerid, hitid, weaponid, shot_tick, before_health, before_armour);
    }
    if(!(22 <= weaponid <= 34)) return 1;
    if(GetPVarInt(playerid, "weapon_shop_last_weapon") != weaponid) return 1;

    new ammo = GetPVarInt(playerid, "weapon_shop_last_ammo");
    if(ammo <= 0) return 1;

    new client_ammo = GetPlayerAmmo(playerid);
    if(0 < client_ammo < ammo) ammo = client_ammo;
    else ammo--;

    if(ammo < 0) ammo = 0;
    SetPVarInt(playerid, "weapon_shop_last_ammo", ammo);

    if(ammo > 0)
    {
        SetTimerEx("WeaponShop_ResyncAmmo", 80, false, "iii", playerid, weaponid, ammo);
    }
    return 1;
}

new gPerfMoneyTick[MAX_PLAYERS];
new gPerfNearbyVehicleTick[MAX_PLAYERS];
new gPerfHudTick[MAX_PLAYERS];
new gPerfPickupTick[MAX_PLAYERS];
new gPerfAutoLockTick[MAX_PLAYERS];
new gPerfAmmoResyncTick[MAX_PLAYERS];
new gPerfHudCacheTick;
new gPerfHudPowerText[16];
new gPerfHudOnlineText[16];

public OnPlayerUpdate(playerid)
{
	new update_tick = GetTickCount();
	new player_state = GetPlayerState(playerid);

	if(update_tick - gPerfMoneyTick[playerid] >= 1000)
	{
		gPerfMoneyTick[playerid] = update_tick;
		FixBugMoneyMinus(playerid);
	}
	SetPlayerData(playerid, P_AFK_TIME, 0);

    if(update_tick - gPerfNearbyVehicleTick[playerid] >= 350)
    {
        gPerfNearbyVehicleTick[playerid] = update_tick;

        if(player_state == PLAYER_STATE_ONFOOT)
        {
            new near_vehicle = INVALID_VEHICLE_ID;
            if(TrunkTest_GetNearbyPersonalVehicle(playerid, near_vehicle, 4.5))
            {
                new now_tick = update_tick;
                new bool:near_rear = TrunkTest_IsPlayerNearVehicleRear(playerid, near_vehicle, 2.8);

                // Показываем только ОДНУ подсказку за подход к машине.
                // У багажника приоритет у багажника, иначе у закрытых дверей.
                if(near_rear)
                {
                    new exit_trunk_tick = GetPVarInt(playerid, PVAR_TRUNKTEST_EXIT_TICK);
                    if((exit_trunk_tick <= 0 || (now_tick - exit_trunk_tick) >= 5000) &&
                        !GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN) &&
                        !GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN))
                    {
                        ShowNotificationLaird(playerid, 5, 10, 9101, near_vehicle, "Багажник транспорта закрыт", "ОТКРЫТЬ");
                        SetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN, 1);
                        SetPVarInt(playerid, PVAR_TRUNKTEST_HINT_VEHICLE, near_vehicle);
                        SetPVarInt(playerid, PVAR_TRUNKTEST_HINT_TICK, now_tick);
                    }
                }
                else if(GetVehicleParam(near_vehicle, V_LOCK))
                {
                    new exit_tick = GetPVarInt(playerid, PVAR_CARLOCK_EXIT_TICK);
                    if((exit_tick <= 0 || (now_tick - exit_tick) >= 11000) &&
                        !GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN) &&
                        !GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN))
                    {
                        ShowNotificationLaird(playerid, 5, 10, 9102, near_vehicle, "Двери автомобиля закрыты", "ОТКРЫТЬ");
                        SetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN, 1);
                        SetPVarInt(playerid, PVAR_CARLOCK_HINT_VEHICLE, near_vehicle);
                        SetPVarInt(playerid, PVAR_CARLOCK_HINT_TICK, now_tick);
                    }
                }
            }
            else if(GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN) || GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN))
            {
                // Сбрасываем флаги только когда игрок действительно отошёл от машины.
                DeletePVar(playerid, PVAR_TRUNKTEST_HINT_SHOWN);
                DeletePVar(playerid, PVAR_TRUNKTEST_HINT_VEHICLE);
                DeletePVar(playerid, PVAR_TRUNKTEST_HINT_TICK);
                DeletePVar(playerid, PVAR_CARLOCK_HINT_SHOWN);
                DeletePVar(playerid, PVAR_CARLOCK_HINT_VEHICLE);
                DeletePVar(playerid, PVAR_CARLOCK_HINT_TICK);
            }
        }
        else if(GetPVarInt(playerid, PVAR_TRUNKTEST_HINT_SHOWN) || GetPVarInt(playerid, PVAR_CARLOCK_HINT_SHOWN))
        {
            DeletePVar(playerid, PVAR_TRUNKTEST_HINT_SHOWN);
            DeletePVar(playerid, PVAR_TRUNKTEST_HINT_VEHICLE);
            DeletePVar(playerid, PVAR_TRUNKTEST_HINT_TICK);
            DeletePVar(playerid, PVAR_CARLOCK_HINT_SHOWN);
            DeletePVar(playerid, PVAR_CARLOCK_HINT_VEHICLE);
            DeletePVar(playerid, PVAR_CARLOCK_HINT_TICK);
        }
    }
	new green_zone_id = GetPVarInt(playerid, "player_in_green_zone") - 1;
	if(green_zone_id >= 0 && green_zone_id < g_green_zones_loaded && g_green_zones[green_zone_id][GZ_NO_WEAPON])
	{
		if(GetPlayerWeapon(playerid) != 0)
		{
			SetPlayerArmedWeapon(playerid, 0);
		}
	}
	
	if(update_tick - gPerfHudCacheTick >= 1000)
	{
		gPerfHudCacheTick = update_tick;
		format(gPerfHudPowerText, sizeof(gPerfHudPowerText), "X%d", Config[sDonPower]);
		format(gPerfHudOnlineText, sizeof(gPerfHudOnlineText), "%d/1000", Iter_Count(Player));
	}
	if(update_tick - gPerfHudTick[playerid] >= 1000)
	{
		gPerfHudTick[playerid] = update_tick;
		PlayerTextDrawSetString(playerid, logo_PTD[playerid][0], gPerfHudPowerText);
		PlayerTextDrawSetString(playerid, logo_PTD[playerid][1], gPerfHudOnlineText);
	}
	
	/*if(IsPlayerInRangeOfPoint(playerid, 3.0, 609.434875,1729.022583,12.078809))
	{
	    vz(playerid);
	    
	}
	
	if(IsPlayerInRangeOfPoint(playerid, 3.0, 617.468688,1729.151977,12.078809))
	{
	    vz(playerid);

	}*/

	if(player_state == PLAYER_STATE_DRIVER)
	{
		new keys, gas_brake, left_right;

		GetPlayerKeys(playerid, keys, gas_brake, left_right);

		// SendClientMessage(playerid, -1, IntToString(gas_brake));

		new pedal_type = PEDAL_TYPE_NONE;

		if((keys & KEY_SPRINT) && !(keys & KEY_JUMP || keys & KEY_HANDBRAKE))
			pedal_type = PEDAL_TYPE_GAS;

		else if(keys & KEY_JUMP && !(keys & KEY_SPRINT || keys & KEY_HANDBRAKE))
			pedal_type = PEDAL_TYPE_BRAKE;

		player_press_pedal[playerid] = pedal_type;

		if(update_tick - gPerfAutoLockTick[playerid] >= 250)
		{
			gPerfAutoLockTick[playerid] = update_tick;
			new vehicleid = GetPlayerVehicleID(playerid);

			if(vehicleid != INVALID_VEHICLE_ID && IsAOwnableCar(vehicleid))
			{
				new ownable_index = GetVehicleData(vehicleid, V_ACTION_ID);
				if(ownable_index >= 0)
				{
					new Float:v_speed = floatabs(GetVehicleSpeed(vehicleid));
					new bool:auto_lock_enabled = ((GetOwnableCarData(ownable_index, OC_PDVRADAR) & OWNABLE_CAR_PDVRADAR_FLAG_AUTOLOCK_DISABLED) == 0);

					if(auto_lock_enabled && v_speed >= 70.0 && !GetVehicleParam(vehicleid, V_LOCK))
					{
						if(!GetPVarInt(playerid, "car_autolock_by_speed"))
						{
							SetVehicleParam(vehicleid, V_LOCK, VEHICLE_PARAM_ON);
							SetPVarInt(playerid, "car_autolock_by_speed", 1);
							ShowNotificationLaird(playerid, 3, 6, 0, 0, "Транспорт был автоматически закрыт", " ");
							PlayAudioStreamURL(playerid, "vehicle_sound_door.mp3");
						}
					}
					else if(v_speed < 65.0 || !GetVehicleParam(vehicleid, V_LOCK))
					{
						DeletePVar(playerid, "car_autolock_by_speed");
					}
				}
			}
		}
	}
	if (gPlayerBlockedPickup[playerid] != -1 && update_tick - gPerfPickupTick[playerid] >= 350)
    {
        gPerfPickupTick[playerid] = update_tick;
        new Float:x, Float:y, Float:z;

        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, gPlayerBlockedPickup[playerid], E_STREAMER_X, x);
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, gPlayerBlockedPickup[playerid], E_STREAMER_Y, y);
        Streamer_GetFloatData(STREAMER_TYPE_PICKUP, gPlayerBlockedPickup[playerid], E_STREAMER_Z, z);

        if (GetPlayerDistanceFromPoint(playerid, x, y, z) > 2.0)
        {
            gPlayerBlockedPickup[playerid] = -1;
        }
    }
	/*
	new current_weapon = GetPlayerWeapon(playerid);

	if(current_weapon != GetPVarInt(playerid, "current_weapon"))
	{
		OnPlayerChangeWeapon(playerid, current_weapon);

		SetPVarInt(playerid, "current_weapon", current_weapon);
	}
	*/
	if(GetPlayerTempJobCheckAnim(playerid))
	{
		new anim_index = GetPlayerAnimationIndex(playerid);

		/*
			new fmt_str[32];

			format(fmt_str, sizeof fmt_str, "index: %d", anim_index);
			SendClientMessage(playerid, 0xCECECEFF, fmt_str);
		*/

		switch(GetPlayerTempJob(playerid))
		{
			case TEMP_JOB_LOADER:
			{
				if(!GetPlayerSex(playerid))
				{
					if(!(anim_index == 259 || anim_index == 1189 || anim_index == 1224))
					{
						anim_index = -1;
					}
				}
					else
				{
					if(!(anim_index == 259 || anim_index == 260 || anim_index == 1275 || anim_index == 1276 || anim_index == 1289))
					{
						anim_index = -1;
					}
				}

				if(anim_index == -1)
				{
					SetPlayerTempJobCheckAnim(playerid, false);
					SetPlayerTempJobState(playerid, TEMP_JOB_STATE_LOADER_DROP_LOAD);
				}
			}
			case TEMP_JOB_MINER:
			{
				if(GetPlayerTempJobState(playerid) == TEMP_JOB_STATE_MINER_UNLOAD)
				{
					if(!(anim_index == 616 || anim_index == 1189 || anim_index == 1224))
						SetPlayerTempJobState(playerid, TEMP_JOB_STATE_MINER_DROP_LOAD);
				}
			}
			case TEMP_JOB_FACTORY:
			{
				if(!GetPlayerSex(playerid))
				{
					if(!(anim_index == 259 || anim_index == 949 || anim_index == 1189 || anim_index == 1224 || anim_index == 1257 || anim_index == 1269))
					{
						anim_index = -1;
					}
				}
					else
				{
					if(!(anim_index == 259 || anim_index == 1196 || anim_index == 1275 || anim_index == 1276 || anim_index == 1269 || anim_index == 1283))
					{
						anim_index = -1;
					}
				}

				if(anim_index == -1)
				{
					SetPlayerTempJobCheckAnim(playerid, false);
					SetPlayerTempJobState(playerid, TEMP_JOB_STATE_FACTORY_DROP_P);
				}
			}
			case TEMP_JOB_LUMBERJACK:
			{
				if(!(anim_index == 1189 || anim_index == 1224 || anim_index == 260 || anim_index == 1275 || anim_index == 1276))
				{
					anim_index = -1;
				}

				if(anim_index == -1)
					SetPlayerTempJobState(playerid, TEMP_JOB_STATE_LUMBERJACK_DROP);
			}
			default:
			{
				SetPlayerTempJobCheckAnim(playerid, false);
			}
		}
	}
	/*
	if(GetPlayerTempJob(playerid) == TEMP_JOB_MINER)
	{
		if(GetPlayerTempJobState(playerid) == TEMP_JOB_STATE_MINER_UNLOAD)
		{
			new anim_idx = GetPlayerAnimationIndex(playerid);

			if(!(anim_idx == 616 || anim_idx == 1189 || anim_idx == 1224))
				SetPlayerTempJobState(playerid, TEMP_JOB_STATE_MINER_DROP_LOAD);
		}
	}
	*/
	if(GetPVarInt(playerid, "test") == 1)
	{
		new fmt_str[64];

		format(fmt_str, sizeof fmt_str, "a_index: %d", GetPlayerAnimationIndex(playerid));
		SendClientMessage(playerid, 0xCECECEFF, fmt_str);
	}

	if(update_tick - gPerfAmmoResyncTick[playerid] >= 100)
	{
		gPerfAmmoResyncTick[playerid] = update_tick;
		WeaponShop_ForceClientAmmoReload(playerid);
	}

	new weapon_state = GetPlayerWeaponState(playerid);
	if(weapon_state == 2) SetPlayerData(playerid, P_WEAPON_RELOADING, false);
	if(weapon_state == 3 && !GetPlayerData(playerid, P_WEAPON_RELOADING))
	{
		SetPlayerData(playerid, P_WEAPON_RELOADING, true);

		switch(GetPlayerWeapon(playerid))
		{
			case 22:
			{
				if(GetPlayerData(playerid, P_SKILL_COLT) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][0]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[0] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][0] = 0;

						AddPlayerData(playerid, P_SKILL_COLT, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_colt", GetPlayerData(playerid, P_SKILL_COLT));

						SetPlayerSkillLevel(playerid, 0, GetPlayerData(playerid, P_SKILL_COLT) * 10);
					}
				}
			}
			case 23:
			{
				if(GetPlayerData(playerid, P_SKILL_SDPISTOL) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][1]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[1] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][1] = 0;

						AddPlayerData(playerid, P_SKILL_SDPISTOL, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_sdpistol", GetPlayerData(playerid, P_SKILL_SDPISTOL));

						SetPlayerSkillLevel(playerid, 1, GetPlayerData(playerid, P_SKILL_SDPISTOL) * 10);
					}
				}
			}
			case 24:
			{
				if(GetPlayerData(playerid, P_SKILL_DEAGLE) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][2]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[2] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][2] = 0;

						AddPlayerData(playerid, P_SKILL_DEAGLE, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_deagle", GetPlayerData(playerid, P_SKILL_DEAGLE));

						SetPlayerSkillLevel(playerid, 2, GetPlayerData(playerid, P_SKILL_DEAGLE) * 10);
					}
				}
			}
			case 25:
			{
				if(GetPlayerData(playerid, P_SKILL_SHOTGUN) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][3]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[3] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][3] = 0;

						AddPlayerData(playerid, P_SKILL_SHOTGUN, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_shotgun", GetPlayerData(playerid, P_SKILL_SHOTGUN));

						SetPlayerSkillLevel(playerid, 3, GetPlayerData(playerid, P_SKILL_SHOTGUN) * 10);
					}
				}
			}
			case 29:
			{
				if(GetPlayerData(playerid, P_SKILL_MP5) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][4]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[4] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][4] = 0;

						AddPlayerData(playerid, P_SKILL_MP5, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_mp5", GetPlayerData(playerid, P_SKILL_MP5));

						SetPlayerSkillLevel(playerid, 7, GetPlayerData(playerid, P_SKILL_MP5) * 10);
					}
				}
			}
			case 30:
			{
				if(GetPlayerData(playerid, P_SKILL_AK47) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][5]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[5] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][5] = 0;

						AddPlayerData(playerid, P_SKILL_AK47, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_ak47", GetPlayerData(playerid, P_SKILL_AK47));

						SetPlayerSkillLevel(playerid, 8, GetPlayerData(playerid, P_SKILL_AK47) * 10);
					}
				}
			}
			case 31:
			{
				if(GetPlayerData(playerid, P_SKILL_M4) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][6]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[6] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][6] = 0;

						AddPlayerData(playerid, P_SKILL_M4, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_m4", GetPlayerData(playerid, P_SKILL_M4));

						SetPlayerSkillLevel(playerid, 9, GetPlayerData(playerid, P_SKILL_M4) * 10);
					}
				}
			}
			case 34:
			{
				if(GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE) < 100)
				{
					g_player[playerid][P_RELOADINGS_COUNT][7]++;

					if(GetPlayerData(playerid, P_RELOADINGS_COUNT)[7] == 3)
					{
						g_player[playerid][P_RELOADINGS_COUNT][7] = 0;

						AddPlayerData(playerid, P_SKILL_SNIPER_RIFLE, +, 1);
						UpdatePlayerDatabaseIntAsync(playerid, "skill_sniper_rifle", GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE));

						SetPlayerSkillLevel(playerid, 10, GetPlayerData(playerid, P_SKILL_SNIPER_RIFLE) * 10);
					}
				}
			}
			case 26:
			{
				if(GetPlayerData(playerid, P_SKILL_SAWNOFF) < 100)
				{
