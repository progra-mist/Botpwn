		new fmt_str[128];

		format(fmt_str, sizeof fmt_str, "[S] Хелпер %s[%d]: %s", GetPlayerNameEx(playerid), playerid, params);
		SendMessageToHelpers(fmt_str, 0x99CC00FF);

	}

	return 1;
}

