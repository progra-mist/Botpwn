// 3-hour protection for economy/property actions requested by server owner.
// 3-hour protection for economy/property actions requested by server owner.
stock bool:RequireThreeHoursForEconomy(playerid)
{
    if(GetPlayerData(playerid, P_TOTALHOUR) < 3)
    {
        SendClientMessage(playerid, 0xCECECEFF, "Чтобы воспользоваться, надо отыграть 3 часа /time");
        return false;
    }
    return true;
}

